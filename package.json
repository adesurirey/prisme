{
  "name": "prisme",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "edition": "pnpm --filter @prisme/pipeline edition",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm --filter @prisme/pipeline verify",
    "benchmark:export": "pnpm --filter @prisme/pipeline benchmark:export",
    "benchmark:grade": "pnpm --filter @prisme/pipeline benchmark:grade",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  }
}
