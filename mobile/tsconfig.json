{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "allowImportingTsExtensions": true,
    // ^ @prisme/domain ships raw TS with .ts-extension self-imports
    //   (same as pipeline's tsconfig); tsc walks them when mobile imports
    //   the package.
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
