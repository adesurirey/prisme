---
/**
 * The "À la une" back link to the index, shared by every sub-page (Story,
 * 404, mentions légales, méthode, classement) so the arrow-link style and
 * copy live in one place. Pass `backLink` on pages that load the
 * back-link script (installBackLink) to get the history.back() behavior;
 * elsewhere the attributes are inert and the link is a plain href.
 *
 * The label is invariant: « À la une » names the page itself, whose
 * window (Aujourd'hui, 7 jours, En direct, …) is just the select's
 * setting (ADR-0028). The edition-aware installer may retarget href and
 * back target to the home the reader came from; it never rewrites the
 * wording. The first URL in the list is the fallback (la Une).
 */
import { withBase } from '../data';

interface Props {
  backLink?: boolean;
}

const { backLink = false } = Astro.props;
---

<p class="mb-6">
  <a
    href={withBase('/')}
    {...(backLink
      ? {
          'data-back-to-index': true,
          'data-home-urls': JSON.stringify([
            withBase('/'),
            withBase('/7-jours/'),
            withBase('/en-direct/'),
          ]),
        }
      : {})}
    class="inline-flex items-center gap-1.5 text-[13px] text-muted transition-colors hover:text-ink"
  >
    <svg
      width="13"
      height="13"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
      class="shrink-0"
    >
      <path
        d="M13 8H3m0 0 4-4M3 8l4 4"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span>À la une</span>
  </a>
</p>
