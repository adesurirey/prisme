---
/**
 * Photo credit for the Story page hero image ([slug].astro): a thin
 * Astro wrapper around the shared React ImageCredit component, so the
 * Edition's StoryHero and StoryCard thumbnails render the exact same
 * badge. Rendered statically (no client directive — the <details> is
 * native, zero JS). See ImageCredit.tsx for the behavior and sizing.
 */
import ImageCredit from './ImageCredit';

interface Props {
  /** Outlet name, e.g. "Reuters". */
  name: string;
}
const { name } = Astro.props;
---

<ImageCredit name={name} />