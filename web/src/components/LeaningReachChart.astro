---
import { coverageGroup, LEANING_LABELS, outlets } from '@prisme/domain';
import { outletLogoLookup, PLATE_CAPTION } from '../leaning-chart';
import {
  PLATE_HEIGHT,
  PLOT_HEIGHT,
  quadrantChartRows,
  reachDomain,
  reachLabel,
  reachTicks,
} from '../quadrant-chart';

/**
 * Quadrant variant of LeaningChart: the five Leaning bands on the x-axis
 * (tinted columns, Gauche at the left), sourced Reach on the y-axis on a
 * log scale — every Outlet's logo plate sits in its band column at its
 * reach height, and links to the Outlet's entry in the « Média par
 * média » list below, like the column chart it accompanies.
 *
 * When two Outlets' audiences are too close for their plates to clear,
 * quadrant-chart.ts dodges them apart vertically (see PLOT_HEIGHT /
 * PLATE_HEIGHT — the same pixels this component renders).
 *
 * Placement logic lives in src/quadrant-chart.ts; this file is only
 * markup. The chart scrolls horizontally on narrow screens rather than
 * squeezing three decades of reach into a phone width.
 */

const logoFor = outletLogoLookup();
const domain = reachDomain(outlets.map((o) => o.reach.value));
const rows = quadrantChartRows(outlets, logoFor, domain);
const ticks = reachTicks(domain);
const chartHeight = PLOT_HEIGHT;
const COLUMN_WIDTH = 100 / rows.length;
---

<figure>
  <div class="overflow-x-auto pb-1">
    <div class="flex min-w-[640px] gap-2">
      <!-- Y axis: the Reach scale, log -->
      <div
        class="relative"
        style={`height: ${chartHeight}px; width: 3rem`}
        aria-hidden="true"
      >
        {
          ticks.map((tick) => (
            <span
              class="absolute right-1 -translate-y-1/2 text-right text-[12px] whitespace-nowrap text-muted"
              style={`bottom: calc(${tick.y * 100}% )`}
            >
              {tick.label}
            </span>
          ))
        }
        <span
          class="absolute inset-x-0 bottom-0 text-right text-[11px] leading-tight text-faint"
        >
          visites
          <br />
          web / mois
        </span>
      </div>

      <!-- Plot area: a plain container — a role="img" would make the
            plate links inside it presentational and nameless. -->
      <div
        class="relative grow overflow-hidden rounded-xl border border-line"
        style={`height: ${chartHeight}px`}
      >
        <!-- Column tints + separators -->
        {
          rows.map((row, i) => (
            <div
              aria-hidden="true"
              class="absolute inset-y-0 border-r border-line"
              style={`left: ${i * COLUMN_WIDTH}%; width: ${COLUMN_WIDTH}%; background: color-mix(in srgb, var(--${coverageGroup(row.leaning)}) 6%, transparent)`}
            />
          ))
        }
        <!-- Decade gridlines -->
        {
          ticks.map((tick) => (
            <div
              aria-hidden="true"
              class="absolute inset-x-0 h-px bg-line"
              style={`bottom: ${tick.y * 100}%`}
            />
          ))
        }
        <!-- Plates -->
        {
          rows.map((row, i) =>
            row.entries.map(({ outlet, y, logoSrc }) => (
              <a
                href={`#${outlet.id}`}
                class="absolute flex w-24 items-center justify-center rounded-lg bg-white px-2 shadow-[0_1px_2px_0_rgb(0_0_0/0.04)] ring-1 ring-black/5 transition-all hover:z-10 hover:shadow-md hover:ring-line-strong dark:bg-zinc-50 dark:hover:ring-zinc-400"
                title={`${outlet.name} — ${reachLabel(outlet.reach.value)} visites/mois`}
                aria-label={`${outlet.name} — ${reachLabel(outlet.reach.value)} visites mensuelles`}
                style={`left: ${(i + 0.5) * COLUMN_WIDTH}%; bottom: ${y * 100}%; height: ${PLATE_HEIGHT}px; transform: translate(-50%, 50%)`}
              >
                {logoSrc ? (
                  <img
                    src={logoSrc}
                    alt={outlet.name}
                    class="h-8 w-24 max-w-full object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="px-1 text-center text-[13px] font-medium text-ink">
                    {outlet.name}
                  </span>
                )}
              </a>
            )),
          )
        }
      </div>
    </div>

    <!-- X axis: the five Leaning bands -->
    <div class="mt-2 flex min-w-[640px] gap-2 pl-14">
      {
        rows.map((row) => (
          <p class="flex flex-1 items-baseline justify-center gap-x-1.5 text-[13px] leading-none">
            <span
              aria-hidden="true"
              class="inline-block size-2.5 translate-y-[-1px] self-center rounded-full"
              style={`background: var(--${coverageGroup(row.leaning)})`}
            />
            <span class="whitespace-nowrap font-semibold text-ink">
              {LEANING_LABELS[row.leaning]}
            </span>
            <span class="text-muted">{row.entries.length}</span>
          </p>
        ))
      }
    </div>
  </div>

  <figcaption class="mt-3 text-[13px] leading-relaxed text-muted">
    {PLATE_CAPTION}
  </figcaption>
</figure>
