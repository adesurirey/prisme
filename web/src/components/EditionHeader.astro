---
/**
 * The editions header row shared by the home (« Aujourd'hui ») and the
 * weekly edition (« 7 jours », issue #128 / ADR-0027): the two Edition
 * names side by side — the active one is the page's h1, the other a
 * quiet link to its page, in the site's navigation-link grammar (muted
 * at rest, ink on hover, no underline — same as the back links and the
 * footer nav; underlines are the prose signal, InlineLink). One
 * component renders both pages so the pair stays mirrored.
 *
 * The `aside` slot carries the right side of the row: the edition's
 * temporal anchor (day label on the home, "depuis le …" window start on
 * the weekly page). The home also passes the per-reader "Nouveau" pill —
 * daily-visit semantics that stay there (ADR-0027).
 */
import { withBase } from '../data';

interface Props {
  /** The page's own edition: its name renders as the h1. */
  edition: 'today' | 'week';
}

const { edition } = Astro.props;
const todayActive = edition === 'today';
---

<div class="flex items-baseline justify-between gap-4">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    {
      todayActive ? (
        <h1 class="text-[17px] font-semibold tracking-[-0.01em]">
          Aujourd'hui
        </h1>
      ) : (
        <a
          href={withBase('/')}
          class="text-[17px] font-medium text-muted transition-colors hover:text-ink"
        >
          Aujourd'hui
        </a>
      )
    }
    {
      todayActive ? (
        <a
          href={withBase('/7-jours/')}
          class="text-[17px] font-medium text-muted transition-colors hover:text-ink"
        >
          7 jours
        </a>
      ) : (
        <h1 class="text-[17px] font-semibold tracking-[-0.01em]">7 jours</h1>
      )
    }
  </div>
  <div class="flex flex-wrap items-baseline gap-4">
    <slot name="aside" />
  </div>
</div>
