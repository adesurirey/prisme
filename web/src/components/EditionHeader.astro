---
/**
 * The sorts header, shared by every sort page (ADR-0028, amended by
 * ADR-0029 and re-sorted by ADR-0041): « À la une » names the surface
 * and is the h1 on all of them — the sort (Nouveau, Brûlant, Top) is a
 * *setting of that one page*, switched by a native <select> rather
 * than a row of links: three labels don't fit a 360px phone next to
 * the h1, and the platform picker is the bulletproof pattern — touch
 * target, wheel/bottom-sheet and screen-reader pop-up semantics come
 * free, no ARIA to mis-wire. It wears the back-link recipe — 13px
 * muted text, the chevron in that same color via the shared span — so
 * it reads as a quiet control, not a second title (selects, unlike
 * text inputs, don't trigger iOS's small-font zoom). A fixed short
 * list, so it auto-submits on change (edition-switcher.ts); without JS
 * the select is inert and the <noscript> links take over — they exist
 * for humans, not crawlers (the alternate sorts are noindexed,
 * ADR-0028/0039).
 *
 * The EDITIONS order is chronology-first (ADR-0029, as re-sorted by
 * ADR-0041): Nouveau (pure chronology), Brûlant (chronology weighted
 * by Coverage and age), Top (pure Coverage) — the gradient from
 * "when" to "how much". Code keys carry the spec #158 sort names
 * (new/hot/top); Brûlant is the home and the default (ADR-0039).
 *
 * The `aside` slot carries the right side of the row: the sort's
 * temporal anchor. It shows on every screen size — the small-screen
 * hiding was lifted when the « Nouveau » pill it made room for was
 * removed (ADR-0029); the pages style the anchor themselves.
 */
import { withBase } from '../data';

interface Props {
  /** The page's own sort: the select arrives preselected on it. */
  edition: 'new' | 'hot' | 'top';
}

const { edition } = Astro.props;

/** The shipped sorts — the select's options and the noscript fallback
 *  links, chronology-first (ADR-0029, as re-sorted by ADR-0041: Nouveau
 *  is pure chronology, Brûlant mixes chronology and Coverage on two
 *  decay clocks, Top is pure Coverage). */
const EDITIONS = [
  { key: 'new', label: 'Nouveau', href: withBase('/nouveau/') },
  { key: 'hot', label: 'Brûlant', href: withBase('/') },
  { key: 'top', label: 'Top', href: withBase('/top/') },
] as const;

const current = EDITIONS.find((e) => e.key === edition);
---

<div class="flex items-baseline justify-between gap-4">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <h1
      class="text-[16px] sm:text-[18px] font-semibold tracking-[-0.01em]"
    >
      À la une
    </h1>
    {
      /* The face is a real button — the browser's own focus ring, the
        OutletGroup disclosure's recipe — that opens the native picker
        of the select hidden behind it (showPicker). The select stays
        the form control whose change navigates: one tab stop (the
        button), the picker itself is platform UI. sr-only, not
        display:none: showPicker needs a rendered element, and its
        font-size drives the picker's option size. */
    }
    <span class="relative inline-flex">
      <button
        type="button"
        data-edition-switcher-face
        aria-haspopup="listbox"
        aria-label={`Tri : ${current?.label}`}
        class="inline-flex cursor-pointer items-center gap-1.5 text-[13px] text-muted transition-colors hover:text-ink"
      >
        {current?.label}
        <svg
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="size-3 shrink-0"
        >
          <path
            d="M3.5 6 8 10.5 12.5 6"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <select
        id="edition-switcher"
        data-edition-switcher
        aria-hidden="true"
        tabindex="-1"
        class="sr-only text-[13px]"
      >
        {
          EDITIONS.map((e) => (
            <option value={e.href} selected={e.key === edition}>
              {e.label}
            </option>
          ))
        }
      </select>
    </span>
  </div>
  <div class="flex flex-wrap items-baseline gap-4">
    <slot name="aside" />
  </div>
</div>
<noscript>
  <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-muted">
    {
      EDITIONS.filter((e) => e.key !== edition).map((e) => (
        <a href={e.href} class="transition-colors hover:text-ink">
          {e.label}
        </a>
      ))
    }
  </p>
</noscript>
<script>
  import { installEditionSwitcher } from "../edition-switcher";

  installEditionSwitcher();
</script>
