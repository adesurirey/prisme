---
import '../styles/global.css';
// The wordmark SVG, inline (no request): exact Inter outlines, per-letter
// skew — generated by web/scripts/generate-brand-svg.py (docs/research/logo/
// recette-finale.md). fill="currentColor" follows the theme.
import prismeWordmarkRaw from '../assets/brand/prisme-wordmark-nav.svg?raw';
import { withBase } from '../data';
import { PRISME_MARK_DARK, PRISME_MARK_LIGHT } from '../favicon';

// Decorative inside the labelled link, sized to the old text's cap height.
const prismeWordmark = prismeWordmarkRaw
  .replace(' role="img" aria-label="Prisme"', ' aria-hidden="true"')
  .replace('<svg ', '<svg class="h-[16px] w-auto" ');

interface Props {
  title: string;
  description?: string;
  /** Absolute URL for og:image — the Story image, hotlinked (ADR-0003). */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = "L'actualité, décomposée : la une des grands médias français regroupée par sujet, pour comparer sa couverture de gauche à droite.",
  ogImage,
  ogType = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcfc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0e10" />
    {/* PWA (issue #64): installable site — manifest, iOS home-screen icon
         and standalone display. The PNG icons are generated from the mark's
         single source by web/scripts/generate-icons.ts. */}
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Prisme" />
    {/* Favicon: the Prisme mark (the upright P), one explicit version per
         theme (--ink tokens), from its single source. The media attribute
         makes the browser pick — and live-swap — the right one, instead of
         relying on @media inside the SVG. */}
    <link rel="icon" media="(prefers-color-scheme: light)" href={PRISME_MARK_LIGHT} />
    <link rel="icon" media="(prefers-color-scheme: dark)" href={PRISME_MARK_DARK} />
    <title>{title}</title>
    {/* Reading toggle (issue #89): restore the persisted mode before first
         paint so a stored Exposition never flashes Couverture widths.
         Absent or unreadable = Couverture (the default, no attribute). */}
    <script is:inline>
      try {
        if (localStorage.getItem('prisme:mode') === 'exposure')
          document.documentElement.dataset.mode = 'exposure';
      } catch {}
    </script>
    <script is:inline data-goatcounter="https://prisme.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased">
    <header class="sticky top-0 z-50 border-b border-line bg-canvas/90 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-4xl items-center gap-3 px-5">
        <a href={withBase('/')} class="flex items-start" aria-label="Prisme — accueil">
          <Fragment set:html={prismeWordmark} />
        </a>
        {/* Reading toggle (issue #89, ADR-0016): Couverture (default) or
             Exposition for every coverage bar on the site, at once. Radio
             semantics with arrow-key navigation (roving tabindex); the live
             region announces the switch. Styling follows aria-checked. */}
        <div class="relative ml-auto shrink-0">
          <div
            class="mode-toggle"
            role="radiogroup"
            aria-label="Lecture des barres : couverture (médias) ou exposition (lecteurs)"
            data-mode-toggle
          >
            <button
              type="button"
              role="radio"
              aria-checked="true"
              tabindex="0"
              data-mode-value="coverage"
            >Couverture</button>
            <button
              type="button"
              role="radio"
              aria-checked="false"
              tabindex="-1"
              data-mode-value="exposure"
            >Exposition</button>
          </div>
          <p class="sr-only" role="status" data-mode-live></p>
          {/* Whisper (discoverability): the first four switches show a
               fading caption saying what the destination reading does
               (mode-toggle.ts counts them in localStorage); aria-hidden
               because the live region already announces the same text. */}
          <p class="mode-whisper" data-mode-whisper aria-hidden="true"></p>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-4xl px-5 pb-16">
      <slot />
    </main>
    <footer class="border-t border-line py-8">
      <div class="mx-auto flex max-w-4xl flex-wrap gap-x-5 gap-y-2 px-5 text-[13px] text-muted">
        <p>© {new Date().getFullYear()} Prisme</p>
        <p class="ml-auto flex gap-5">
          <a href={withBase('/classement-politique-des-medias/')} class="transition-colors hover:text-ink"
            >Classement politique des médias</a
          >
          <a href={withBase('/mentions-legales/')} class="transition-colors hover:text-ink"
            >Mentions légales</a
          >
        </p>
      </div>
    </footer>
  </body>
  {/* Pull-to-refresh (issue #66): uniform on every page, including frozen
       Story pages. */}
  <script>
    import { installPullToRefresh } from '../pull-to-refresh';

    const install = () => installPullToRefresh(document, window);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', install);
    } else {
      install();
    }
  </script>
  {/* Reading toggle (issue #89, ADR-0016): the pre-paint restore stays
       is:inline in the head above. */}
  <script>
    import { installModeToggle } from '../mode-toggle';

    const install = () => installModeToggle(document, window);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', install);
    } else {
      install();
    }
  </script>
</html>
