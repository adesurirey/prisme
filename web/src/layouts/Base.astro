---
import '../styles/global.css';
import { withBase } from '../data';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'La même actualité, vue par tous les bords politiques.' } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Prisme</title>
  </head>
  <body class="min-h-screen bg-zinc-50 text-zinc-900">
    <header class="border-b border-zinc-200 bg-white">
      <div class="mx-auto flex max-w-3xl items-baseline gap-4 px-4 py-4">
        <a href={withBase('/')} class="text-xl font-bold tracking-tight">Prisme</a>
        <p class="hidden text-sm text-zinc-500 sm:block">La même actualité, vue par tous les bords.</p>
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-6">
      <slot />
    </main>
    <footer class="border-t border-zinc-200 py-6 text-center text-xs text-zinc-500">
      Prisme — prototype. Les liens renvoient vers les articles des outlets.
    </footer>
  </body>
</html>
