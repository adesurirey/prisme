---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces/opsz.css';
import '../styles/global.css';
import { withBase } from '../data';

interface Props {
  title: string;
  description?: string;
  /** Absolute URL for og:image — the Story image, hotlinked (ADR-0003). */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'La même actualité, vue par tous les bords politiques.',
  ogImage,
  ogType = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcfc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0e10" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cstyle%3E@media (prefers-color-scheme:dark){.g{stop-color:%23f28498}.c{stop-color:%23e3b341}.d{stop-color:%2363a8ea}}%3C/style%3E%3ClinearGradient id='p' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop class='g' offset='0' stop-color='%23e0415e'/%3E%3Cstop class='g' offset='.32' stop-color='%23e0415e'/%3E%3Cstop class='c' offset='.45' stop-color='%23dfa414'/%3E%3Cstop class='c' offset='.58' stop-color='%23dfa414'/%3E%3Cstop class='d' offset='.7' stop-color='%232e7ce4'/%3E%3Cstop class='d' offset='1' stop-color='%232e7ce4'/%3E%3C/linearGradient%3E%3Ccircle cx='16' cy='16' r='15' fill='url(%23p)'/%3E%3C/svg%3E"
    />
    <title>{title === 'Prisme' ? title : `${title} · Prisme`}</title>
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased">
    <header class="sticky top-0 z-10 border-b border-line bg-canvas/90 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-4xl items-center gap-3 px-5">
        <a href={withBase('/')} class="flex items-start" aria-label="Prisme — accueil">
          <span
            class="font-serif text-[17px] font-black uppercase leading-none tracking-[0.01em]"
            >Prisme</span
          >
          <span
            class="ml-1 text-[11px] font-medium leading-none text-faint"
            aria-hidden="true"
            >bêta</span
          >
        </a>
      </div>
    </header>
    <main class="mx-auto max-w-4xl px-5 pb-16">
      <slot />
    </main>
    <footer class="border-t border-line py-8">
      <div class="mx-auto flex max-w-4xl flex-wrap gap-x-5 gap-y-2 px-5 text-[13px] text-muted">
        <p>© {new Date().getFullYear()} Prisme</p>
        <p class="ml-auto flex gap-5">
          <a href={withBase('/classement-politique-des-medias/')} class="transition-colors hover:text-muted"
            >Classement politique des médias</a
          >
          <a href={withBase('/mentions-legales/')} class="transition-colors hover:text-muted"
            >Mentions légales</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>