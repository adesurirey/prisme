---
import '../styles/global.css';
import { withBase } from '../data';
import { AURORA_BALL_DARK, AURORA_BALL_LIGHT } from '../favicon';

interface Props {
  title: string;
  description?: string;
  /** Absolute URL for og:image — the Story image, hotlinked (ADR-0003). */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'La même actualité, vue par tous les bords politiques.',
  ogImage,
  ogType = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcfc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0e10" />
    <!-- PWA (issue #64): installable site — manifest, iOS home-screen icon
         and standalone display. The PNG icons are generated from the aurora
         dot's single source by web/scripts/generate-icons.ts. -->
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Prisme" />
    <!-- Favicon: the aurora dot, one explicit version per theme (global.css
         tokens), from its single source. The media attribute makes the
         browser pick — and live-swap — the right one, instead of relying on
         @media inside the SVG. -->
    <link rel="icon" media="(prefers-color-scheme: light)" href={AURORA_BALL_LIGHT} />
    <link rel="icon" media="(prefers-color-scheme: dark)" href={AURORA_BALL_DARK} />
    <title>{title === 'Prisme' ? title : `${title} · Prisme`}</title>
    <!-- GoatCounter analytics: async, cookie-free, no personal data. -->
    <script is:inline data-goatcounter="https://prisme.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased">
    <header class="sticky top-0 z-50 border-b border-line bg-canvas/90 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-4xl items-center gap-3 px-5">
        <a href={withBase('/')} class="flex items-start" aria-label="Prisme — accueil">
          <span
            class="font-serif text-[17px] font-black uppercase leading-none tracking-[0.01em]"
            >Prisme</span
          >
          <span
            class="ml-1 text-[11px] font-medium leading-none text-faint"
            aria-hidden="true"
            >bêta</span
          >
        </a>
      </div>
    </header>
    <main class="mx-auto max-w-4xl px-5 pb-16">
      <slot />
    </main>
    <footer class="border-t border-line py-8">
      <div class="mx-auto flex max-w-4xl flex-wrap gap-x-5 gap-y-2 px-5 text-[13px] text-muted">
        <p>© {new Date().getFullYear()} Prisme</p>
        <p class="ml-auto flex gap-5">
          <a href={withBase('/classement-politique-des-medias/')} class="transition-colors hover:text-muted"
            >Classement politique des médias</a
          >
          <a href={withBase('/mentions-legales/')} class="transition-colors hover:text-muted"
            >Mentions légales</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>