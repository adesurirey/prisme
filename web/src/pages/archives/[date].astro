---
import type { Story } from '@prisme/domain';
import { archiveDays, frenchArchiveDate } from '../../archives';
import StoryCard from '../../components/StoryCard';
import { loadAllStoryFiles, loadOutlets, withBase } from '../../data';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  // One page per Story day with a record (ADR-0017): the permanent Story
  // files are the record; the archive is derived and disposable on a wipe.
  const allDays = archiveDays(await loadAllStoryFiles());
  return allDays.map((day) => ({
    params: { date: day.day },
    props: { day },
  }));
}

const { day } = Astro.props as { day: { day: string; stories: Story[] } };
const outlets = loadOutlets();

// The previous (older) and next (newer) days within the archive — navigation
// walks the days that have a record, nothing in between.
const allDays = archiveDays(await loadAllStoryFiles());
const index = allDays.findIndex((d) => d.day === day.day);
const next = index > 0 ? allDays[index - 1] : undefined;
const previous = index < allDays.length - 1 ? allDays[index + 1] : undefined;
const count = day.stories.length;
---

<Base
  title={`Archives du ${frenchArchiveDate(day.day)} — Prisme`}
  description={`Le journal complet du ${frenchArchiveDate(day.day)} : les ${count} sujets couverts par la presse française ce jour-là, en couverture croisée.`}
>
  <section class="pt-10">
    <p>
      <a
        href={withBase('/')}
        class="inline-flex items-center gap-1.5 text-[13px] text-muted transition-colors hover:text-ink"
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="shrink-0"
        >
          <path
            d="M13 8H3m0 0 4-4M3 8l4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Aujourd’hui
      </a>
    </p>
    <h1 class="mt-4 text-[24px] font-semibold tracking-[-0.02em]">
      Archives du {frenchArchiveDate(day.day)}
    </h1>
    <p class="mt-2 text-[13px] text-muted">
      Le journal complet de ce jour&nbsp;: {count} sujet
      {count > 1 ? 's' : ''}, tous les médias de la couverture, sans
      hiérarchie de une.
    </p>
    <nav
      class="mt-4 flex flex-wrap items-center justify-between gap-3 text-[13px] text-muted"
      aria-label="Navigation entre les jours d’archives"
    >
      {
        previous ? (
          <a
            href={withBase(`/archives/${previous.day}/`)}
            class="transition-colors hover:text-ink"
            rel="prev"
          >
            ← {frenchArchiveDate(previous.day)}
          </a>
        ) : (
          <span class="opacity-50">Premier jour d’archives</span>
        )
      }
      {
        next ? (
          <a
            href={withBase(`/archives/${next.day}/`)}
            class="ml-auto transition-colors hover:text-ink"
            rel="next"
          >
            {frenchArchiveDate(next.day)} →
          </a>
        ) : (
          <span class="ml-auto opacity-50">Dernier jour d’archives</span>
        )
      }
    </nav>
  </section>

  <section aria-label={`Sujets du ${frenchArchiveDate(day.day)}`} class="pb-10">
    {
      day.stories.map((story) => <StoryCard story={story} outlets={outlets} />)
    }
  </section>
</Base>
