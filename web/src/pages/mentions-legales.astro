---
import { withBase } from '../data';
import Base from '../layouts/Base.astro';

const description =
  'Mentions légales du site Prisme : éditeur, hébergeur, contact.';
---

<Base title="Mentions légales" description={description}>
  <article class="pt-10">
    <p class="mb-6">
      <a href={withBase('/')} class="text-[13px] text-muted transition-colors hover:text-ink">
        ← L'édition du jour
      </a>
    </p>
    <h1 class="max-w-[36rem] text-[24px] font-semibold leading-snug tracking-[-0.02em]">
      Mentions légales
    </h1>

    <section class="mt-8 max-w-[36rem] space-y-6 text-[15px] leading-relaxed text-muted">
      <div>
        <h2 class="text-[15px] font-semibold text-ink">Éditeur</h2>
        <p class="mt-1.5">
          Arnaud de Surirey, directeur de la publication.
          <br />
          Contact : <a
            href="mailto:salves.panache.8i@icloud.com"
            class="text-ink underline-offset-2 hover:underline"
            >salves.panache.8i@icloud.com</a
          >
        </p>
      </div>

      <div>
        <h2 class="text-[15px] font-semibold text-ink">Hébergeur</h2>
        <p class="mt-1.5">
          GitHub, Inc.
          <br />
          88 Colin P Kelly Jr Street, San Francisco, CA 94107, États-Unis
          <br />
          <a href="https://docs.github.com/fr/site-policy" class="text-ink underline-offset-2 hover:underline" rel="noopener">
            Conditions et politiques du site GitHub
          </a>
        </p>
      </div>

      <div>
        <h2 class="text-[15px] font-semibold text-ink">Nature du site</h2>
        <p class="mt-1.5">
          Prisme est un prototype personnel, sans but commercial. Il ne publie aucun
          contenu de presse : il renvoie vers les articles des médias, dont il n'affiche
          que les titres, chapôs et images déjà publics. Les sources des classements sont
          détaillées sur la page
          <a
            href={withBase('/classement-politique-des-medias/')}
            class="text-ink underline-offset-2 hover:underline">« Classement politique des médias »</a
          >.
        </p>
      </div>

      <div>
        <h2 class="text-[15px] font-semibold text-ink">Données personnelles</h2>
        <p class="mt-1.5">
          Le site ne dépose aucun cookie et ne mesure pas l'audience. Il ne collecte
          aucune donnée personnelle : les erreurs signalées via GitHub transitent par le
          dépôt public du projet.
        </p>
      </div>
    </section>
  </article>
</Base>
