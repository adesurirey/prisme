---
import {
  coverageGroup,
  excludedOutlets,
  LEANING_LABELS,
  type Leaning,
  leaningOrder,
  type OutletConfig,
  outlets,
} from '@prisme/domain';
import BackToIndex from '../components/BackToIndex.astro';
import InlineLink from '../components/InlineLink.astro';
import PaywallBadge from '../components/PaywallBadge';
import SiteBadge from '../components/SiteBadge.astro';
import { withBase } from '../data';
import Base from '../layouts/Base.astro';
import { formatParisDate } from '../paris-date';

const perLeaning = (leaning: Leaning): OutletConfig[] =>
  outlets.filter((o) => o.leaning === leaning);

const tdmLabel = (tdm: OutletConfig['tdm']): string =>
  tdm.reserved === true
    ? 'réservation publiée'
    : tdm.reserved === false
      ? 'aucune réservation'
      : 'indéterminé';

const description =
  'Comment chaque média français est classé, de gauche à droite : les cinq tendances, les sources derrière chaque classement, les médias exclus. Le Figaro, Libération, Le Monde… média par média.';
---

<Base
  title="Classement politique des médias français : de gauche à droite"
  description={description}
>
  <article class="pt-10">
    <BackToIndex />
    <h1 class="text-[26px] font-semibold leading-snug tracking-[-0.02em]">
      Classement politique des médias
    </h1>
    <p class="mt-4 text-[16px] leading-relaxed text-muted">
      Prisme regroupe les articles de {outlets.length} médias français. Chaque média est
      classé à la main sur cinq tendances — {LEANING_LABELS.gauche.toLowerCase()},
      {LEANING_LABELS['centre-gauche'].toLowerCase()}, {LEANING_LABELS.centre.toLowerCase()},
      {LEANING_LABELS['centre-droite'].toLowerCase()} et {LEANING_LABELS.droite.toLowerCase()}.
      Le site, lui, ne parle qu’en trois camps — gauche, centre, droite : le centre
      gauche compte avec la gauche, le centre droit avec la droite ; c’est la langue des
      légendes, des barres de couverture et des synthèses.
    </p>
    <p class="mt-4 text-[16px] leading-relaxed text-muted">
      Cette page dit d’où vient chaque classement, média par média, avec ses sources et
      ses désaccords. Pour le reste — la collecte des articles, la formation des sujets,
      l’écriture des synthèses — voir la page
      <InlineLink href={withBase('/methode/')}>« Comment fonctionne Prisme »</InlineLink>.
    </p>

    <section class="mt-10 space-y-4 text-[16px] leading-relaxed text-muted">
      <h2 class="text-[16px] font-semibold text-ink sm:text-[18px]">
        Le bord appartient au média, pas à l’article
      </h2>
      <p>
        Un article du <em>Figaro</em> peut défendre une position de gauche : ça n’en fait
        pas pour autant un article « de droite », ni « de gauche ». Le bord politique
        appartient au média, jamais à l’article. C’est le média qui a une position, sur
        la durée : sa ligne éditoriale, ce qu’il met en avant, ce qu’il laisse de côté.
        Chaque média est donc classé une fois pour toutes, à la main — et aucun modèle
        ne classe jamais les articles eux-mêmes.
      </p>
      <p>
        Chaque classement s’appuie sur au moins deux sources publiques indépendantes :
        une échelle idéologique construite à partir de données, et des travaux de
        référence. Elles sont citées média par média plus bas ; quand elles se
        contredisent, le désaccord est écrit noir sur blanc.
      </p>
    </section>

    <section class="mt-10 space-y-4 text-[16px] leading-relaxed text-muted">
      <h2 class="text-[16px] font-semibold text-ink sm:text-[18px]">
        La sélection n’est pas équilibrée — et c’est voulu
      </h2>
      <p>
        Les {outlets.length} médias sont choisis pour leur audience et leur poids
        éditorial, jamais pour équilibrer les bords. D’où une répartition inégale —
        {perLeaning('gauche').length} à gauche, {perLeaning('centre-gauche').length} au
        centre gauche, {perLeaning('centre').length} au centre,
        {perLeaning('centre-droite').length} au centre droit et
        {perLeaning('droite').length} à droite — qui ressemble à celle de la presse
        nationale française. Cette répartition est elle-même une information : elle
        montre ce qui se passe quand un sujet n’est repris que d’un seul bord. La barre
        de couverture et les mentions « angle mort » le rendent visible sur chaque page
        de sujet — le mécanisme est détaillé dans
        <InlineLink href={withBase('/methode/#angle-mort')}>« L’angle mort »</InlineLink>.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-[16px] font-semibold text-ink sm:text-[18px]">Les médias exclus</h2>
      <p class="mt-2 text-[16px] leading-relaxed text-muted">
        Certains médias manquent à l’appel. Pour chacun, la raison de l’exclusion,
        vérifiée à la date indiquée.
      </p>
      <ul class="mt-4 flex max-w-3xl flex-col divide-y divide-line border-y border-line">
        {
          excludedOutlets.map((excluded) => (
            <li class="py-4">
              <p class="text-[16px] font-medium text-ink">{excluded.name}</p>
              <p class="mt-1 text-[16px] leading-relaxed text-muted">{excluded.publicReason}</p>
              <p class="mt-1 text-[16px] text-muted">
                Vérifié le {formatParisDate(new Date(excluded.checkedAt), {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-[16px] font-semibold text-ink sm:text-[18px]">Média par média</h2>
      {
        leaningOrder.map((leaning) => (
          <div class="mt-8 first:mt-6">
            <h3 class="flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5 text-[16px]">
              <span
                aria-hidden="true"
                class="inline-block size-2.5 translate-y-[-1px] rounded-full"
                style={`background: var(--${coverageGroup(leaning)})`}
              />
              <span class="whitespace-nowrap font-semibold text-ink">
                {LEANING_LABELS[leaning]}
              </span>
              <span class="text-muted">
                {perLeaning(leaning).length} médias
                {leaning === 'centre-gauche' && ' — compte avec la gauche'}
                {leaning === 'centre-droite' && ' — compte avec la droite'}
              </span>
            </h3>
            <ul class="mt-1 divide-y divide-line">
              {perLeaning(leaning).map((outlet) => (
                <li class="py-4">
                  <h4 class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                    <span class="text-[16px] font-medium text-ink">
                      {outlet.name}
                    </span>
                    <SiteBadge href={outlet.site} />
                    <PaywallBadge paywall={outlet.paywall} />
                  </h4>
                  <p class="mt-1 text-[16px] leading-relaxed text-muted">
                    {outlet.leaningNote}
                  </p>
                  <details class="group mt-1.5">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-[13px] text-muted transition-colors hover:text-muted [&::-webkit-details-marker]:hidden">
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 8 8"
                        class="size-2.5 shrink-0 transition-transform group-open:rotate-45"
                      >
                        <path d="M2 1l4 3-4 3" fill="none" stroke="currentColor" stroke-width="1.2" />
                      </svg>
                      Sources et audience
                    </summary>
                    <div class="mt-3 space-y-3 pl-4">
                      <ul class="flex flex-col gap-3">
                        {outlet.leaningSources.map((source) => (
                          <li>
                            <p class="text-[16px] leading-relaxed text-muted">
                              <InlineLink href={source.url}>
                                {source.title}
                              </InlineLink>
                              <span class="text-muted">
                                {' '}— {source.author}
                                {source.date ? `, ${source.date}` : ''}
                              </span>
                            </p>
                            <p class="mt-0.5 text-[16px] leading-relaxed text-muted">
                              {source.takeaway}
                            </p>
                          </li>
                        ))}
                      </ul>
                      <p class="text-[16px] leading-relaxed text-muted">
                        Audience :{' '}
                        {outlet.readership.url ? (
                          <InlineLink href={outlet.readership.url}>
                            {outlet.readership.evidence}
                          </InlineLink>
                        ) : (
                          outlet.readership.evidence
                        )}
                      </p>
                      <p class="text-[16px] leading-relaxed text-muted">
                        Texte et données (TDM) : {tdmLabel(outlet.tdm)} — vérifié le
                        {formatParisDate(new Date(outlet.tdm.checkedAt), {
                          day: 'numeric',
                          month: 'long',
                          year: 'numeric',
                        })}
                      </p>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </article>
</Base>
