---
import StoryCard from '../components/StoryCard';
import StoryHero from '../components/StoryHero.astro';
import { loadEdition, loadOutlets } from '../data';
import Base from '../layouts/Base.astro';
import { formatParisDate } from '../paris-date';

const edition = await loadEdition();
const outlets = loadOutlets();

const built = new Date(edition.builtAt);

// The edition's day, Paris clock — "mercredi 15 oct. 2026" — anchors the
// header row above the hero card: the Edition is a day's reading, and the
// date names the day the pipeline last ran (same formatter as every
// build-time date, paris-date.ts).
const dayLabel = formatParisDate(built, {
  weekday: 'long',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

// The edition's last update, Paris clock — "22 h 01", thin no-break
// spaces around the h (docs/brand.md, French typographic craft) — shown
// in the page's footer line.
const updatedTime = formatParisDate(built, {
  hour: '2-digit',
  minute: '2-digit',
}).replace(':', '\u202Fh\u202F');
---

<Base title="Prisme — revue de presse">
  <section class="pt-10 pb-6">
    {/* "À la une" + the day's date, one line over the hero card — the
        Edition leads with its content, not with a title (the catch line
        stays in the meta description). */}
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="text-[17px] font-semibold tracking-[-0.01em]">À la une</h1>
      <p class="text-[13px] text-muted capitalize">{dayLabel}</p>
    </div>
  </section>

  <section aria-label="Sujets de l'édition">
    {
      edition.stories.map((story, index) =>
        // The Edition's first Story leads in the hero variant (Story
        // page header style, full-width legend bar); the rest stay cards.
        index === 0 ? (
          <StoryHero story={story} outlets={outlets} />
        ) : (
          <StoryCard story={story} outlets={outlets} />
        ),
      )
    }
    {/* Tight under the last card — <main>'s pb-16 and the footer's py-8
        carry the bottom whitespace. */}
    <p class="mt-6 text-center text-[12px] text-faint">
      {edition.stories.length} sujets — dernier point à {updatedTime}
    </p>
  </section>

</Base>
{/* "En hausse" (per-visitor trending): the cards ship data-story-id/
   data-coverage; this module script compares them to the reader's last
   visit (localStorage) and reveals badges. Runs on this page only. */}
<script>
  import { installTrending } from "../trending";

  installTrending();
</script>
