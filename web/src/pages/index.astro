---
import EditionHeader from '../components/EditionHeader.astro';
import LoadMoreButton from '../components/LoadMoreButton.astro';
import StoryCard from '../components/StoryCard';
import StoryHero from '../components/StoryHero.astro';
import { loadEdition, loadOutlets } from '../data';
import Base from '../layouts/Base.astro';
import { LOAD_MORE_INITIAL } from '../load-more';
import { formatParisDate } from '../paris-date';

const edition = await loadEdition();
const outlets = loadOutlets();

const built = new Date(edition.builtAt);

// The edition's day, Paris clock — "mercredi 15 oct. 2026" — anchors the
// header row above the hero card: the Edition is a day's reading, and the
// date names the day the pipeline last ran (same formatter as every
// build-time date, paris-date.ts). The whole anchor hides on phones
// (ADR-0028): the row there is h1 + select (+ pill), and the footer
// count line already carries the timestamp.
const dayLabel = formatParisDate(built, {
  weekday: 'long',
  day: 'numeric',
  month: 'short',
});

const yearLabel = formatParisDate(built, { year: 'numeric' });

// The edition's last update, Paris clock — "22 h 01", thin no-break
// spaces around the h (docs/brand.md, French typographic craft) — shown
// in the page's footer line.
const updatedTime = formatParisDate(built, {
  hour: '2-digit',
  minute: '2-digit',
}).replace(':', '\u202Fh\u202F');
---

<Base title="Prisme — revue de presse">
  <section class="pt-10 pb-6">
    {/* The editions header (ADR-0028): « À la une » names the surface as
        the h1 on every edition; the window is the select's setting, with
        « Aujourd'hui » preselected here. The day label anchors the
        edition to its build day (same formatter as every build-time
        date, paris-date.ts) and hides under sm:. */}
    <EditionHeader edition="today">
      <p class="hidden text-[13px] text-muted first-letter:uppercase sm:block" slot="aside">{`${dayLabel} ${yearLabel}`}</p>
    </EditionHeader>
  </section>

  <section aria-label="Sujets du jour">
    {
      edition.stories.map((story, index) =>
        // The Edition's first Story leads in the hero variant (Story
        // page header style, full-width legend bar); the rest stay cards.
        index === 0 ? (
          <StoryHero story={story} outlets={outlets} />
        ) : (
          <StoryCard
            story={story}
            outlets={outlets}
            // Tail beyond the first batch: hidden by CSS before first
            // paint (html.js rule in global.css), revealed per click by
            // load-more.ts. Without JS the marker is inert — all visible.
            tail={index >= LOAD_MORE_INITIAL}
          />
        ),
      )
    }
    {/* "Afficher plus de sujets" (ADR-0022): the shared button —
        everything is in the HTML; the tail beyond LOAD_MORE_INITIAL is
        hidden by CSS from first paint and revealed per click. Without
        JS, all Stories simply stay visible. */}
    <LoadMoreButton />
    {/* Tight under the last card — <main>'s pb-16 and the footer's py-8
        carry the bottom whitespace. */}
    <p class="mt-5 text-center text-[12px] text-faint">
      {edition.stories.length} sujets — dernier point à {updatedTime}
    </p>
  </section>

</Base>
{/* "En hausse" (per-visitor trending, ADR-0029): the cards ship
   data-story-id/data-article-count; this module script compares each
   Article count to the reader's last visit (localStorage) through the
   domain growth gate and reveals badges. Runs on this page only —
   load-more wires itself from LoadMoreButton. */}
<script>
  import { installTrending, SEEN_KEY, SESSION_KEY } from "../trending";

  // DEV-only mock: ?mock-trending seeds a fake baseline so the per-visit
  // signal (StoryCard / StoryHero slot) can be demoed without a real
  // returning-visit baseline: every Story but the last three saw half its
  // Article count (≥ 25 % growth → « en hausse »); those three are
  // recorded exactly as-is (no growth → no badge).
  if (import.meta.env.DEV && location.search.includes("mock-trending")) {
    const cards = [
      ...document.querySelectorAll<HTMLElement>("[data-story-id]"),
    ];
    const blob = {
      version: 2,
      stories: {} as Record<string, { articleCount: number; seenAt: number }>,
    };
    const UNCHANGED_COUNT = 3;
    cards.forEach((el, i) => {
      const id = el.dataset.storyId;
      if (id == null) return;
      const count = Number(el.dataset.articleCount ?? 0);
      blob.stories[id] = {
        articleCount:
          i >= cards.length - UNCHANGED_COUNT
            ? count
            : Math.max(1, Math.floor(count / 2)),
        seenAt: Date.now() - 3_600_000,
      };
    });
    localStorage.setItem(SEEN_KEY, JSON.stringify(blob));
    sessionStorage.removeItem(SESSION_KEY);
  }

  installTrending();
</script>
