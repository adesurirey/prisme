---
import {
  type CoverageGroup,
  coverageGroup,
  coverageOrder,
} from '@prisme/domain';
import LeaningBadge from '../components/LeaningBadge';
import StoryCard from '../components/StoryCard';
import { loadEdition, loadOutlets, withBase } from '../data';
import Base from '../layouts/Base.astro';
import { formatParisDate } from '../paris-date';

const edition = await loadEdition();
const outlets = loadOutlets();

// "Mercredi 7 octobre" — the date is the title; time in French style, thin
// no-break spaces around the h (docs/brand.md, French typographic craft).
const updatedAt = new Date(edition.builtAt);
const iso = formatParisDate(updatedAt, {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
});
const updatedDate = iso.charAt(0).toUpperCase() + iso.slice(1);
const updatedTime = formatParisDate(updatedAt, {
  hour: '2-digit',
  minute: '2-digit',
}).replace(':', '\u202Fh\u202F');

const perGroup = (group: CoverageGroup) =>
  outlets.filter((o) => coverageGroup(o.leaning) === group).length;
---

<Base title="Prisme">
  <section class="pt-10 pb-8">
    <h1 class="text-[22px] font-semibold tracking-[-0.02em]">{updatedDate}</h1>
    <p class="mt-1.5 text-[13px] text-muted">
      {edition.stories.length} sujets mis à jour en continu — dernier point
      à {updatedTime}
    </p>
    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
      {
        // The legend speaks in Coverage groups — the same three camps the
        // Coverage bar and tabs use (docs/brand.md: three colors, three
        // words); the granular bands live on the classement page.
        coverageOrder.map((group) => (
          <span class="flex items-center gap-1.5 text-[13px]">
            <LeaningBadge leaning={group} labelClass="text-ink" />
            <span class="text-muted">{perGroup(group)} médias</span>
          </span>
        ))
      }
      {
        // The first question the legend raises — why these camps, why these
        // counts — is answered by the classement page (issue #8).
      }
      <a
        href={withBase('/classement-politique-des-medias')}
        class="text-[13px] text-faint transition-colors hover:text-ink"
      >
        D’où vient ce classement ?
      </a>
    </div>
  </section>

  <section aria-label="Sujets de l'édition">
    {edition.stories.map((story) => <StoryCard story={story} outlets={outlets} />)}
  </section>
</Base>
<!-- "En hausse" (per-visitor trending): the cards ship data-story-id/
     data-coverage; this module script compares them to the reader's last
     visit (localStorage) and reveals badges. Runs on this page only. -->
<script>
  import { installTrending } from '../trending';

  installTrending();
</script>