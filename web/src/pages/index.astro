---
import EditionHeader from '../components/EditionHeader.astro';
import LoadMoreButton from '../components/LoadMoreButton.astro';
import StoryCard from '../components/StoryCard';
import StoryHero from '../components/StoryHero.astro';
import { loadEdition, loadFeedStories, loadOutlets } from '../data';
import { formatParisClock } from '../latest';
import Base from '../layouts/Base.astro';
import { LOAD_MORE_INITIAL } from '../load-more';

/**
 * Brûlant (spec #158, ADR-0039/0041) — the home and the default sort of
 * « À la une », the only indexed page: the 24-hour pool (every Story
 * with an Article in the rolling last 24 hours) re-ranked by the
 * domain's double-decay feed key — a Story weighs the Outlets covering
 * it in the window, halved every six hours since its newest Article and
 * every eighteen hours since its founding — so coverage makes a Story
 * last, silence and age sink it, and none squats the top for days. The
 * pipeline caps the window at 25 Stories (RANKED_CAP, ADR-0038); the
 * count line renders the artifact's length — the web layer never
 * re-caps.
 *
 * Per-reader signal (ADR-0029, as amended by ADR-0031): the trending
 * script runs here through the same code path as every sort page
 * (trending-page.ts) — the badge means "grew since your last visit",
 * and a visit to any of the three feeds the same merged baseline.
 *
 * Header (ADR-0028): the shared sorts header — h1 « À la une », select
 * preselected on « Brûlant ». The temporal anchor names the pool's
 * window — the same 24 hours as Top and Nouveau; what differs is the
 * order, which the anchor leaves to the reading.
 */
const stories = await loadFeedStories();
const edition = await loadEdition();
const outlets = loadOutlets();

const built = new Date(edition.builtAt);

// The footer line's last update, Paris clock — same thin no-break spaces
// as every page's count line.
const updatedTime = formatParisClock(built);

// SEO: the mission wording names the mechanism (brand brief: say what we
// show) — a Story rises when Outlets report it, sinks when they fall
// silent, and cools as it ages; the window never leaves the last 24
// hours.
const description =
  'Les sujets des dernières 24 heures dans la presse française, remontés quand les médias en parlent et relégués quand ils se taisent ou que le temps passe — actualisés à chaque collecte horaire.';
---

<Base title="Prisme — Revue de presse" description={description}>
  <section class="pt-10 pb-6">
    {/* The sorts header: « À la une » is the h1, the select arrives
        preselected on « Brûlant » — the default sort. The temporal
        anchor names the pool's window and shows on every screen size
        (ADR-0029 lifted the small-screen hiding). */}
    <EditionHeader edition="hot">
      <p class="text-[13px] text-muted" slot="aside">24 dernières heures</p>
    </EditionHeader>
  </section>

  <section aria-label="Sujets brûlants">
    {
      stories.length === 0 ? (
        // The day pool empty (a quiet archive's night): same honesty as
        // every empty state — what happened, when collection last ran.
        <p class="py-8 text-center text-[14px] text-muted">
          Aucun sujet couvert dans les dernières 24 heures — dernière
          collecte à {updatedTime}.
        </p>
      ) : (
        <>
          {stories.map((story, index) =>
            // The highest-weighted Story leads in the hero variant, like
            // every page's first; the rest stay cards in Brûlant order.
            index === 0 ? (
              <StoryHero story={story} outlets={outlets} />
            ) : (
              <StoryCard
                story={story}
                outlets={outlets}
                tail={index >= LOAD_MORE_INITIAL}
              />
            ),
          )}
          <LoadMoreButton />
          {/* The count line mirrors every sort page's — sujet count and
              last update; the window itself is named by the header
              anchor. */}
          <p class="mt-5 text-center text-[12px] text-faint">
            {stories.length} sujets — dernier point à {updatedTime}
          </p>
        </>
      )
    }
  </section>

</Base>
{/* "Faits nouveaux" (per-visitor trending, ADR-0029): the shared page
   wiring — same code path as « Nouveau » and « Top ». */}
<script>
  import { installTrendingPage } from '../trending-page';

  installTrendingPage();
</script>
