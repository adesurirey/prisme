---
import StoryCard from '../components/StoryCard';
import StoryHero from '../components/StoryHero.astro';
import { loadEdition, loadOutlets } from '../data';
import Base from '../layouts/Base.astro';
import { LOAD_MORE_INITIAL } from '../load-more';
import { formatParisDate } from '../paris-date';

const edition = await loadEdition();
const outlets = loadOutlets();

const built = new Date(edition.builtAt);

// The edition's day, Paris clock — "mercredi 15 oct. 2026" — anchors the
// header row above the hero card: the Edition is a day's reading, and the
// date names the day the pipeline last ran (same formatter as every
// build-time date, paris-date.ts).
const dayLabel = formatParisDate(built, {
  weekday: 'long',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

// The edition's last update, Paris clock — "22 h 01", thin no-break
// spaces around the h (docs/brand.md, French typographic craft) — shown
// in the page's footer line.
const updatedTime = formatParisDate(built, {
  hour: '2-digit',
  minute: '2-digit',
}).replace(':', '\u202Fh\u202F');
---

<Base title="Prisme — revue de presse">
  <section class="pt-10 pb-6">
    {/* "À la une" + the day's date, one line over the hero card — the
        Edition leads with its content, not with a title (the catch line
        stays in the meta description). */}
    {/* "À la une" + the day's date, one line over the hero card — the
        Edition leads with its content, not with a title (the catch line
        stays in the meta description). The "Nouveau" count pill sits on
        the row's right side, next to the date: filled client-side by
        trending.ts for an established returning reader, it counts the
        Stories absent from that reader's last visit and locates the first
        one on click. empty:hidden keeps the prerendered page silent. */}
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="text-[17px] font-semibold tracking-[-0.01em]">À la une</h1>
      <div class="flex items-baseline gap-4">
        <div data-new-pill class="empty:hidden"></div>
        <p class="text-[13px] text-muted capitalize">{dayLabel}</p>
      </div>
    </div>
  </section>

  <section aria-label="Sujets de l'édition">
    {
      edition.stories.map((story, index) =>
        // The Edition's first Story leads in the hero variant (Story
        // page header style, full-width legend bar); the rest stay cards.
        index === 0 ? (
          <StoryHero story={story} outlets={outlets} />
        ) : (
          <StoryCard
            story={story}
            outlets={outlets}
            // Tail beyond the first batch: hidden by CSS before first
            // paint (html.js rule in global.css), revealed per click by
            // load-more.ts. Without JS the marker is inert — all visible.
            tail={index >= LOAD_MORE_INITIAL}
          />
        ),
      )
    }
    {/* "Afficher plus de sujets" (ADR-0022): everything is in the HTML; the
        tail beyond LOAD_MORE_INITIAL is hidden by CSS from first paint and
        revealed per click. Without JS, all Stories simply stay visible. */}
    <button
      type="button"
      data-load-more
      hidden
      class="group relative mx-auto mt-10 block cursor-pointer overflow-hidden rounded-full border border-line px-6 py-2 text-[13px] font-medium text-ink transition-[border-color,transform] duration-150 hover:border-line-strong active:scale-[0.98]"
    >
      {/* Progress fill behind the label (width driven by load-more.ts),
          tinted rather than solid ink so the edge never reads as a hard
          cut through the label; width transitions for a smooth growth.
          Deepens slightly on hover — the button answers the pointer. */}
      <span
        data-load-more-fill
        aria-hidden="true"
        class="absolute inset-y-0 left-0 bg-ink/5 transition-[width,background-color] duration-300 ease-out group-hover:bg-ink/10 dark:bg-ink/15 dark:group-hover:bg-ink/25"
      ></span>
      <span class="relative">
        Afficher plus de sujets <span data-load-more-count></span>
      </span>
    </button>
    {/* Tight under the last card — <main>'s pb-16 and the footer's py-8
        carry the bottom whitespace. */}
    <p class="mt-5 text-center text-[12px] text-faint">
      {edition.stories.length} sujets — dernier point à {updatedTime}
    </p>
  </section>

</Base>
{/* "En hausse" (per-visitor trending): the cards ship data-story-id/
   data-coverage; this module script compares them to the reader's last
   visit (localStorage) and reveals badges. Runs on this page only. */}
<script>
  import { installTrending, SEEN_KEY, SESSION_KEY } from "../trending";
  import { installLoadMore } from "../load-more";

  // DEV-only mock: ?mock-trending seeds a fake baseline so both per-visit
  // signals (StoryCard / StoryHero slot) can be demoed without a real
  // returning-visit baseline: every Story but the last three is "seen" 3
  // Outlets behind (« en hausse »); those three stay absent from the
  // baseline (« nouveau » + count pill, ADR-0020).
  if (import.meta.env.DEV && location.search.includes("mock-trending")) {
    const cards = [
      ...document.querySelectorAll<HTMLElement>("[data-story-id]"),
    ];
    const blob = {
      version: 1,
      stories: {} as Record<string, { coverage: number; seenAt: number }>,
    };
    const NEW_COUNT = 3;
    cards.forEach((el, i) => {
      if (i >= cards.length - NEW_COUNT) return;
      const id = el.dataset.storyId;
      if (id == null) return;
      blob.stories[id] = {
        coverage: Math.max(0, Number(el.dataset.coverage ?? 0) - 3),
        seenAt: Date.now() - 3_600_000,
      };
    });
    localStorage.setItem(SEEN_KEY, JSON.stringify(blob));
    sessionStorage.removeItem(SESSION_KEY);
  }

  installLoadMore();
  installTrending();
</script>
