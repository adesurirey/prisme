---
import EditionHeader from '../components/EditionHeader.astro';
import LoadMoreButton from '../components/LoadMoreButton.astro';
import StoryCard from '../components/StoryCard';
import StoryHero from '../components/StoryHero.astro';
import { loadEdition, loadOutlets, loadWeekStories } from '../data';
import Base from '../layouts/Base.astro';
import { LOAD_MORE_INITIAL } from '../load-more';
import { formatParisDate } from '../paris-date';

/**
 * « 7 jours » (issue #128, ADR-0027): the weekly edition — a thin
 * renderer of the Edition artifact's floored 7-day list (weekStories,
 * Stories covered by at least 10 Outlets publishing in the window,
 * ranked by that in-window Coverage). Anatomically la Une's mirror —
 * hero for the week's biggest Story, Story cards, load-more, count
 * line — but with none of the per-reader daily-visit semantics: no
 * trending script runs here, so no "En hausse" badge ever appears, and
 * the reader's daily baseline (trending.ts) is never written from this
 * page (ADR-0029).
 *
 * Header and indexation (ADR-0028): the shared editions header — h1
 * « À la une », select preselected on « 7 jours » — and a meta noindex:
 * the weekly list is a near-duplicate of la Une over the same Stories,
 * so only the home edition is indexed.
 */
const stories = await loadWeekStories();
const outlets = loadOutlets();

const edition = await loadEdition();
const built = new Date(edition.builtAt);

// The window's start, Paris clock — "depuis le 16 oct." — names how far
// back the recap reaches: seven days to the day of the build (same
// formatter as every build-time date, paris-date.ts). Short on purpose,
// and hidden on phones (ADR-0028): the row there is h1 + select, and
// the footer count line carries the timestamp. French keeps days and
// months lowercase — the label only takes a first-letter capital.
const sinceLabel = `depuis le ${formatParisDate(
  new Date(built.getTime() - 6 * 86_400_000),
  { day: 'numeric', month: 'short' },
)}`;

// The edition's last update, Paris clock — same thin no-break spaces as
// la Une's footer line.
const updatedTime = formatParisDate(built, {
  hour: '2-digit',
  minute: '2-digit',
}).replace(':', '\u202Fh\u202F');

// SEO: the mission wording for the weekly scale — the floor is stated,
// because it is what the page shows (brand brief: say what we show).
const description =
  'La semaine de la presse française, décomposée : les grands sujets des sept derniers jours, chacun couvert par au moins dix médias, comparés de gauche à droite.';
---

<Base
  title="Prisme — 7 jours"
  description={description}
  noindex
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: '7 jours',
    description,
    inLanguage: 'fr',
  }}
>
  <section class="pt-10 pb-6">
    <EditionHeader edition="week">
      <p class="hidden text-[13px] text-muted first-letter:uppercase sm:block" slot="aside">{sinceLabel}</p>
    </EditionHeader>
  </section>

  <section aria-label="Sujets de la semaine">
    {
      stories.length === 0 ? (
        // A quiet week below the floor (or the artifact predating the
        // week list): the floor is the cut, so the page says it.
        <p class="py-8 text-center text-[14px] text-muted">
          Aucun sujet de ces sept derniers jours n'est couvert par au moins
          dix médias.
        </p>
      ) : (
        <>
          {stories.map((story, index) =>
            // The week's biggest Story leads in the hero variant, like
            // la Une's first; the rest stay cards.
            index === 0 ? (
              <StoryHero story={story} outlets={outlets} />
            ) : (
              <StoryCard
                story={story}
                outlets={outlets}
                tail={index >= LOAD_MORE_INITIAL}
              />
            ),
          )}
          <LoadMoreButton />
          {/* The count line mirrors la Une's — sujet count and last
              update; the floor itself is stated by the empty state and
              the Méthode page. */}
          <p class="mt-5 text-center text-[12px] text-faint">
            {stories.length} sujets — dernier point à {updatedTime}
          </p>
        </>
      )
    }
  </section>
</Base>
