---
import BackToIndex from '../components/BackToIndex.astro';
import Base from '../layouts/Base.astro';

// SEO (issue: branded 404): GitHub Pages falls back to dist/404.html when
// present — without it the default English "Page not found · GitHub Pages"
// page serves, unbranded and out of the site's voice (docs/brand.md).
// Layout mirrors a Story page: the same shared "À la une" back link on top,
// the same H1 and body text scales — no new link or button style, the
// arrow link at the top is the way home.
---

<Base title="Page introuvable — Prisme" noCanonical>
  <article class="pt-10">
    <BackToIndex />
    <p class="mb-1 text-[11px] uppercase tracking-[0.08em] text-muted sm:text-[13px]">
      Erreur 404
    </p>
    <h1 class="text-[28px] font-bold leading-snug tracking-[-0.02em] sm:text-[36px]">
      Cette page n'existe pas
    </h1>
    <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-muted">
      Le lien est peut-être ancien : les sujets du jour sont sur la une, les jours passés
      restent consultables depuis la page d'accueil.
    </p>
  </article>
</Base>
