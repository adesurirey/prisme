---
import type { Story } from '@prisme/domain';
import {
  blindspots,
  countedArticles,
  coverageCounts,
  exposureShares,
  pickStoryImage,
  reportingOutletIds,
  SECTION_LABELS,
} from '@prisme/domain';
import ArticleList from '../../components/ArticleList';
import BlindspotBadge from '../../components/BlindspotBadge';
import CoverageMeta from '../../components/CoverageMeta';

import ImageCredit from '../../components/ImageCredit.astro';
import PrismTabs from '../../components/PrismTabs';
import StoryImage from '../../components/StoryImage';
import { loadAllStoryFiles, loadOutlets, withBase } from '../../data';
import Base from '../../layouts/Base.astro';
import { formatParisDate } from '../../paris-date';

export async function getStaticPaths() {
  // Every Story file gets its page: live Stories in the Edition, live Stories
  // below the top-20 cut, and frozen Stories (issue #6, ADR-0005). The URL is
  // /<storyDay>/<slug>/ — the Story's own day (fixed at creation, ADR-0017),
  // never the day the reader is browsing: a backfill Story shown on the home
  // today links under its own day. Same for the everInEdition-deletion rule
  // (issue #75): pages derive from the Story files, so deleting a never-in-
  // Edition frozen Story file prunes its /<storyDay>/<slug>/ page.
  const stories = await loadAllStoryFiles();
  return stories.map((story) => ({
    params: { date: story.storyDay, slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props as { story: Story };
const outlets = loadOutlets();
const byId = new Map(outlets.map((o) => [o.id, o]));

const counts = coverageCounts(story.articles, byId);
const shares = exposureShares(story.articles, byId);
const reporting = reportingOutletIds(story.articles).size;
const spots = blindspots(counts);
const image = pickStoryImage(story, byId);
const imageOutlet = image && byId.get(image.outletId);

// One mixed list, all Leanings together, newest first (ArticleList sorts): // each Outlet's extra Articles collapse behind their own "+N autres" row.
const articleCount = countedArticles(story.articles);
const mediaCount = reportingOutletIds(story.articles).size;

// "Mis à jour …": bare clock for today ("Mis à jour à 20\u202Fh\u202F23",
// Article rows drop "à": just the clock),
// same as Article rows), "hier à …" for yesterday, absolute date otherwise
// ("le 11 oct. 2026 à …"). Date and clock joined by "à" (French convention),
// narrow no-break spaces around "h" — same pattern as index.astro. Paris days
// are compared by their formatted date so the build host's timezone never
// leaks in. Short month: the header meta line is tight on mobile.
const dayKey = (date: Date) =>
  formatParisDate(date, { day: 'numeric', month: 'short', year: 'numeric' });
const timeOnly = (date: Date) =>
  formatParisDate(date, { hour: '2-digit', minute: '2-digit' }).replace(
    ':',
    'h',
  );
const updated = new Date(story.articles[0]?.publishedAt ?? Date.now());
const published = new Date(story.createdAt);
const now = new Date();
// Day marker per half — the Story page (unlike the index cards) spells the
// day out ("aujourd'hui", "hier", "le 7 oct.") because the sentence carries
// two timestamps that may fall on different days.
const stamp = (d: Date) => {
  const k = dayKey(d);
  return k === dayKey(now)
    ? `aujourd’hui à ${timeOnly(d)}`
    : k === dayKey(new Date(now.getTime() - 24 * 60 * 60 * 1000))
      ? `hier à ${timeOnly(d)}`
      : `le ${k} à ${timeOnly(d)}`;
};
// Same day (same minute included): the day marker is stated once, up
// front — "Publié aujourd'hui à 12h01, mis à jour à 18h45"; different
// days carry their own marker ("Publié hier à 23h11, mis à jour
// aujourd'hui à 09h00").
const sameDay = dayKey(published) === dayKey(updated);
const sameMinute = stamp(published) === stamp(updated);
const publishedLine = sameMinute
  ? `Publié ${stamp(published)}`
  : sameDay
    ? `Publié aujourd’hui à ${timeOnly(published)}\u2003mis à jour à ${timeOnly(updated)}`
    : `Publié ${stamp(published)}\u2003mis à jour ${stamp(updated)}`;

// SEO (issue #6): Prisme’s own description, derived only from the Coverage
// counters — never Outlet text (ADR-0003).
const description =
  reporting > 0
    ? `Comment la presse française couvre « ${story.title} » : ${reporting} média${
        reporting > 1 ? 's' : ''
      } sur ${outlets.length}, ${counts.gauche} gauche, ${counts.centre} centre, ${counts.droite} droite.`
    : undefined;
---

<Base
  title={story.title}
  description={description}
  ogImage={image?.imageUrl}
  ogType="article"
>
  <article class="pt-10">
    <p class="mb-6">
      <a
        href={withBase("/")}
        data-back-to-index
        data-index-url={withBase("/")}
        class="inline-flex items-center gap-1.5 text-[13px] text-muted transition-colors hover:text-ink"
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="shrink-0"
        >
          <path
            d="M13 8H3m0 0 4-4M3 8l4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Aujourd’hui
      </a>
    </p>
    {
      image && imageOutlet ? (
        // Hero header (idea 1): the image is the backdrop of the header block,
        // fading into the canvas — no cut rectangle between header and tabs.
        // Credit: the unfolding "i" badge (ImageCredit) for click and
        // touch, plus a visually-hidden figcaption so the attribution
        // stays in the DOM (screen readers, view-source) regardless of
        // interaction.
        <figure class="relative mt-6 overflow-hidden rounded-xl">
          <div class="absolute inset-0">
            <StoryImage
              article={image}
              outlet={imageOutlet}
              className="h-full w-full"
              sizes="(max-width: 896px) 100vw, 896px"
              eager
            />
            <div
              aria-hidden="true"
              class="absolute inset-0 bg-gradient-to-b from-canvas/20 via-canvas/75 to-canvas"
            />
            <ImageCredit name={imageOutlet.name} />
          </div>
          <div class="relative px-5 pt-36 pb-4 sm:pt-[240px] sm:pb-5">
            {story.section && (
              <p class="mb-1 text-[11px] uppercase tracking-[0.08em] text-muted sm:text-[13px]">
                {SECTION_LABELS[story.section]}
              </p>
            )}
            <h1 class="text-[24px] font-bold leading-tight tracking-[-0.02em] sm:text-[36px] sm:leading-snug">
              {story.title}
            </h1>
            <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px] text-muted">
              <CoverageMeta
                counts={counts}
                shares={shares}
                reporting={reporting}
                totalOutlets={outlets.length}
                barWidth={96}
                fullText
              />
            </p>
            {spots.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {spots.map((leaning) => (
                  <BlindspotBadge leaning={leaning} />
                ))}
              </div>
            )}
            <p class="mt-3 text-[13px] text-faint">{publishedLine}</p>
          </div>
          <figcaption class="sr-only">Photo : {imageOutlet.name}</figcaption>
        </figure>
      ) : (
        <>
          {story.section && (
            <p class="mb-1 text-[11px] uppercase tracking-[0.08em] text-muted sm:text-[13px]">
              {SECTION_LABELS[story.section]}
            </p>
          )}
          <h1 class="text-[28px] font-bold leading-snug tracking-[-0.02em] sm:text-[36px]">
            {story.title}
          </h1>
          <p class="mt-4 text-[13px] text-muted">
            <CoverageMeta
              counts={counts}
              shares={shares}
              reporting={reporting}
              totalOutlets={outlets.length}
              barWidth={96}
              fullText
            />
          </p>
          {spots.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {spots.map((leaning) => (
                <BlindspotBadge leaning={leaning} />
              ))}
            </div>
          )}
          <p class="mt-4 text-[13px] text-muted">{publishedLine}</p>
        </>
      )
    }

    {
      // The Prism tabs (issue #7): one island, all four panels prerendered so
      // they can be indexed. Rendered only when Summaries exist — Stories that
      // froze before issue #7 (or lost their last call) keep their page as is.
      (story.summaries || story.differences) && (
        <section class="mt-10">
          <PrismTabs
            client:visible
            counts={counts}
            summaries={story.summaries}
            differences={story.differences}
          />
        </section>
      )
    }

    <section class="mt-10">
      {
        // No rule under the title: the first row's hover surface would
        // otherwise stack a third line right beneath it.
      }
      <h2 class="mb-3 text-[16px] text-muted">
        <span class="font-semibold text-ink">
          {articleCount} article{articleCount > 1 ? "s" : ""}
        </span>{" "}
        de {mediaCount} média{mediaCount > 1 ? "s" : ""}
      </h2>
      {
        // One island for the whole list (issue #27): the head rows and the
        // follow-ups behind "Voir les N autres articles" are all in the
        // HTML at build time — the island only toggles visibility.
      }
      <ArticleList client:visible articles={story.articles} outlets={outlets} />
    </section>
  </article>
</Base>
{
  /* Back to the index with the browser's own scroll memory: when the
   reader arrived from the index, the "Aujourd'hui" click becomes
   history.back() instead of a full page load — the index scroll
   position is restored natively (bfcache). Arrivals from elsewhere
   (search, shared link) follow the plain href. */
}
<script>
  import { installBackLink } from "../../back-link";

  installBackLink(document, window);
</script>
