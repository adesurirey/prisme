---
import Base from '../../layouts/Base.astro';
import LeaningBadge from '../../components/LeaningBadge';
import PaywallBadge from '../../components/PaywallBadge';
import { loadOutlets, loadStories, withBase } from '../../data';
import type { Story } from '@prisme/domain';

export async function getStaticPaths() {
  const stories = await loadStories();
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

const { story } = Astro.props as { story: Story };
const outlets = await loadOutlets();
const byId = new Map(outlets.map((o) => [o.id, o]));

const builtAt = new Date(
  story.articles[0]?.publishedAt ?? Date.now(),
).toLocaleString('fr-FR', { dateStyle: 'long', timeStyle: 'short' });
---

<Base title={story.title} description={`Le sujet « ${story.title} » dans l'édition du jour de Prisme.`}>
  <p class="mb-4">
    <a href={withBase('/')} class="text-sm text-blue-700 hover:underline">← L'édition du jour</a>
  </p>
  <h1 class="mb-4 text-2xl font-bold leading-snug">{story.title}</h1>
  <p class="mb-6 text-sm text-zinc-500">Publié le {builtAt}</p>
  <ul class="flex flex-col gap-3">
    {
      story.articles.map((article) => {
        const outlet = byId.get(article.outletId);
        return (
          <li class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm">
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <LeaningBadge leaning={outlet?.leaning ?? 'centre'} />
              <span class="font-medium">{outlet?.name ?? article.outletId}</span>
              <PaywallBadge paywall={outlet?.paywall ?? 'none'} />
              <a
                href={article.url}
                rel="noopener noreferrer"
                target="_blank"
                class="ml-auto text-blue-700 underline-offset-2 hover:underline"
              >
                Lire sur {outlet?.name ?? article.outletId}
              </a>
            </div>
            <p class="mt-2 text-xs text-zinc-500">{article.headline}</p>
          </li>
        );
      })
    }
  </ul>
</Base>
