---
import type { Article, Leaning, Story } from '@prisme/domain';
import {
  blindspots,
  countedArticles,
  coverageCounts,
  frontPageOutlets,
  leaningOrder,
  pickStoryImage,
  reportingOutletIds,
  SECTION_LABELS,
  splitPerOutlet,
} from '@prisme/domain';
import ArticleList from '../../components/ArticleList';
import BlindspotBadge from '../../components/BlindspotBadge';
import CoverageBar from '../../components/CoverageBar';
import LeaningBadge from '../../components/LeaningBadge';
import PrismTabs from '../../components/PrismTabs';
import StoryImage from '../../components/StoryImage';
import { loadAllStoryFiles, loadOutlets, withBase } from '../../data';
import Base from '../../layouts/Base.astro';
import { reportIssueUrl, storyPageUrl } from '../../report-error';

export async function getStaticPaths() {
  // Every Story file gets its page: live Stories in the Edition, live Stories
  // below the top-20 cut, and frozen Stories (issue #6, ADR-0005).
  const stories = await loadAllStoryFiles();
  return stories.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props as { story: Story };
const outlets = loadOutlets();
const byId = new Map(outlets.map((o) => [o.id, o]));

const counts = coverageCounts(story.articles, byId);
const reporting = reportingOutletIds(story.articles).size;
const spots = blindspots(counts);
const une = frontPageOutlets(story.articles, outlets);
const counted = countedArticles(story.articles);
const image = pickStoryImage(story, byId);
const imageOutlet = image && byId.get(image.outletId);

/** Articles of one Leaning — the Outlet order and the head/follow-ups split
    are splitPerOutlet's business (@prisme/domain); unknown Outlets last. */
function articlesForLeaning(leaning: Leaning | undefined): Article[] {
  return story.articles.filter(
    (a) => byId.get(a.outletId)?.leaning === leaning,
  );
}
const groups: {
  leaning?: Leaning;
  head: Article[];
  followUps: Article[];
}[] = [
  ...leaningOrder.map((leaning) => ({
    leaning,
    ...splitPerOutlet(articlesForLeaning(leaning)),
  })),
  { ...splitPerOutlet(articlesForLeaning(undefined)) },
];
const visible = groups.filter((g) => g.head.length > 0);

// "Publié le": the newest Article's date. An Undated Article (ADR-0007)
// carries only its Publication day — shown without an invented clock time.
const builtAt = story.articles[0]?.dayPrecision
  ? new Date(story.articles[0].publishedAt).toLocaleDateString('fr-FR', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : new Date(story.articles[0]?.publishedAt ?? Date.now()).toLocaleString(
      'fr-FR',
      { dateStyle: 'long', timeStyle: 'short' },
    );

// "Signaler une erreur" (issue #8): a prefilled GitHub issue carrying this
// Story's page URL, placed next to the Story it concerns.
const reportUrl = reportIssueUrl({
  title: story.title,
  pageUrl: new URL(
    storyPageUrl(story, import.meta.env.BASE_URL),
    Astro.site,
  ).toString(),
});

// SEO (issue #6): Prisme's own description, derived only from the Coverage
// counters — never Outlet text (ADR-0003).
const description =
  reporting > 0
    ? `Comment la presse française couvre « ${story.title} » : ${reporting} média${
        reporting > 1 ? 's' : ''
      } sur ${outlets.length}, ${counts.gauche} gauche, ${counts.centre} centre, ${counts.droite} droite.`
    : undefined;
---

<Base title={story.title} description={description} ogImage={image?.imageUrl} ogType="article">
  <article class="pt-10">
    <p class="mb-6">
      <a href={withBase('/')} class="text-[13px] text-muted transition-colors hover:text-ink">
        ← L'édition du jour
      </a>
    </p>
    <h1 class="max-w-[36rem] text-[24px] font-semibold leading-snug tracking-[-0.02em]">
      {story.title}
    </h1>
    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
      <CoverageBar counts={counts} reporting={reporting} totalOutlets={outlets.length} width={120} />
      {story.section && (
        <p class="text-[13px] text-muted">{SECTION_LABELS[story.section]}</p>
      )}
      <p class="text-[13px] text-muted">{counted} article{counted > 1 ? 's' : ''}</p>
      <p class="text-[13px] text-muted">Publié le {builtAt}</p>
    </div>
    {spots.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {spots.map((leaning) => <BlindspotBadge leaning={leaning} />)}
      </div>
    )}
    {
      une.length > 0 && (
        <p class="mt-4 text-[13px] text-muted">
          À la une chez {une.map((o) => o.name).join(', ')}
        </p>
      )
    }

    <figure class="mt-6">
      <StoryImage
        article={image}
        outlet={imageOutlet}
        className="aspect-[16/9] w-full max-w-[36rem] rounded-lg"
        sizes="(max-width: 896px) 100vw, 576px"
      />
      {imageOutlet && <figcaption class="mt-2 text-[13px] text-faint">Photo : {imageOutlet.name}</figcaption>}
    </figure>

    {
      // The Prism tabs (issue #7): one island, all four panels prerendered so
      // they can be indexed. Rendered only when Summaries exist — Stories that
      // froze before issue #7 (or lost their last call) keep their page as is.
      (story.summaries || story.differences) && (
        <section class="mt-10">
          <PrismTabs
            client:visible
            counts={counts}
            summaries={story.summaries}
            differences={story.differences}
          />
        </section>
      )
    }

    {
      visible.map(({ leaning, head, followUps }) => (
        <section class="mt-10">
          {leaning && (
            <h2 class="mb-1 flex items-center gap-2.5 border-b border-line pb-2">
              <LeaningBadge leaning={leaning} />
              <span class="text-[12px] text-faint">
                {counts[leaning]} média{counts[leaning] > 1 ? 's' : ''}
              </span>
            </h2>
          )}
          {
            // One island per Leaning group (issue #27): the head rows and the
            // follow-ups behind "Voir les N autres articles" are all in the
            // HTML at build time — the island only toggles visibility.
          }
          <ArticleList
            client:visible
            head={head}
            followUps={followUps}
            outlets={outlets}
            storyTitle={story.title}
          />
        </section>
      ))
    }

    <p class="mt-10 text-[13px] text-faint">
      <a
        href={reportUrl}
        class="underline-offset-2 transition-colors hover:text-muted hover:underline"
        rel="noopener"
      >
        Signaler une erreur sur ce sujet ↗
      </a>
    </p>
  </article>
</Base>