---
import Base from '../../layouts/Base.astro';
import ArticleRow from '../../components/ArticleRow';
import CoverageBar, { coverageCounts } from '../../components/CoverageBar';
import StoryImage, { pickStoryImage } from '../../components/StoryImage';
import { loadOutlets, loadStories, withBase } from '../../data';
import type { Story } from '@prisme/domain';
import { SECTION_LABELS } from '@prisme/domain';

export async function getStaticPaths() {
  const stories = await loadStories();
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

const { story } = Astro.props as { story: Story };
const outlets = loadOutlets();
const leaningOf = new Map(outlets.map((o) => [o.id, o.leaning]));
const byId = new Map(outlets.map((o) => [o.id, o]));
const counts = coverageCounts(story.articles, (id) => leaningOf.get(id));
const image = pickStoryImage(story, (id) => leaningOf.get(id));
const imageOutlet = image && byId.get(image.outletId);

const builtAt = new Date(
  story.articles[0]?.publishedAt ?? Date.now(),
).toLocaleString('fr-FR', { dateStyle: 'long', timeStyle: 'short' });
---

<Base title={story.title} description={`Le sujet « ${story.title} » dans l'édition du jour de Prisme.`}>
  <article class="pt-10">
    <p class="mb-6">
      <a href={withBase('/')} class="text-[13px] text-muted transition-colors hover:text-ink">
        ← L'édition du jour
      </a>
    </p>
    <h1 class="max-w-[36rem] text-[24px] font-semibold leading-snug tracking-[-0.02em]">
      {story.title}
    </h1>
    <div class="mt-4 flex items-center gap-5">
      <CoverageBar counts={counts} width={120} />
      {story.section && (
        <p class="text-[13px] text-muted">{SECTION_LABELS[story.section]}</p>
      )}
      <p class="text-[13px] text-muted">Publié le {builtAt}</p>
    </div>

    <figure class="mt-6">
      <StoryImage
        article={image}
        outlet={imageOutlet}
        className="aspect-[16/9] w-full max-w-[36rem] rounded-lg"
        sizes="(max-width: 896px) 100vw, 576px"
      />
      {imageOutlet && <figcaption class="mt-2 text-[13px] text-faint">Photo : {imageOutlet.name}</figcaption>}
    </figure>

    <ul class="mt-8 flex flex-col divide-y divide-line border-y border-line">
      {
        story.articles.map((article) => (
          <li class="py-4">
            <ArticleRow article={article} outlet={byId.get(article.outletId)} />
            {/* The Story title can repeat an Article's headline (split Stories
                take the founding headline); showing it twice adds nothing. */}
            {article.headline !== story.title && (
              <p class="mt-1.5 text-[14px] text-muted">{article.headline}</p>
            )}
          </li>
        ))
      }
    </ul>
  </article>
</Base>