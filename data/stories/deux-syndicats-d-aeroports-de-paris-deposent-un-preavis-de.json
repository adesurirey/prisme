  "summaries": {
    "gauche": [
      "Les syndicats CGT et FO d'Aéroports de Paris ont déposé un préavis de grève pour les aéroports de Roissy et Orly.",
      "Le mouvement social est prévu du 17 au 20 décembre, au tout début des vacances de Noël.",
      "Les grévistes réclament des revalorisations salariales et des mesures sur l'emploi, notamment le pourvoi des postes vacants."
    ],
    "centre": [
      "La CGT et FO d'Aéroports de Paris ont lancé un préavis de grève du 17 au 20 décembre.",
      "Le mouvement vise le premier week-end des départs en vacances de Noël dans les aéroports de Roissy et Orly.",
      "Les revendications incluent une hausse de 20 % de l'indemnité de transport, une prime carburant de 1 000 euros et le recrutement sur les postes vacants.",
      "La direction du Groupe ADP dispose de vingt-trois jours pour négocier selon les syndicats."
    ],
    "droite": [
      "Deux syndicats d'Aéroports de Paris ont déposé un préavis de grève du jeudi 17 au dimanche 20 décembre.",
      "Le mouvement social perturbera les aéroports de Roissy et Orly pour le premier week-end des vacances de Noël.",
      "Les organisations syndicales demandent une prime carburant de 1 000 euros et le pourvoi immédiat des postes vacants.",
      "Europe 1 met en avant les réactions d'auditeurs qui relancent le débat sur l'encadrement ou l'interdiction du droit de grève pendant les fêtes en s'inspirant du modèle italien."
    ]
  },
