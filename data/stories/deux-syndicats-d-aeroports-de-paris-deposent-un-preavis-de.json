  "summaries": {
    "gauche": [
      "La CGT et FO d'Aéroports de Paris ont déposé des préavis de grève du 17 au 20 décembre aux aéroports de Roissy et d'Orly.",
      "Ce mouvement social coïncide avec le premier week-end des vacances de Noël et la période de départs pour les fêtes.",
      "Les syndicats réclament notamment une revalorisation de 20% de l'indemnité de transport, une prime carburant de 1 000 euros et le pourvoi des postes vacants."
    ],
    "centre": [
      "Les syndicats CGT et FO d'Aéroports de Paris ont déposé un préavis de grève pour la période du 17 au 20 décembre.",
      "Ce mouvement social perturbera le premier week-end des vacances de Noël dans les aéroports de Roissy et d'Orly.",
      "Les organisations syndicales réclament des revalorisations de primes et le versement d'une prime carburant pour les salariés du Groupe ADP, estimant que \"la direction a 23 jours pour revenir à la raison\"."
    ],
    "droite": [
      "Deux syndicats d'Aéroports de Paris, la CGT et FO, ont déposé un préavis de grève pour le premier week-end des vacances de Noël, du 17 au 20 décembre.",
      "Le mouvement concerne les aéroports de Roissy et d'Orly et comprend des revendications salariales, dont une prime carburant de 1 000 euros.",
      "Europe 1 met en avant les réactions d'auditeurs qui relancent le débat sur l'encadrement ou la limitation du droit de grève en période de fêtes en s'appuyant sur le modèle italien."
    ]
  },
  "differences": [
    "La gauche insiste en premier lieu sur le contenu précis des revendications sociales, notamment la hausse des indemnités et des primes.",
    "Le centre livre une couverture purement factuelle des dates et des revendications salariales en reprenant les déclarations syndicales sur les délais accordés à la direction.",
    "La droite élargit immédiatement le sujet aux perturbations des voyages et donne la parole à des auditeurs pour contester la légitimité de ce mouvement social en période de fêtes."
  ],
