  "summaries": {
    "gauche": [
      "Le Sénat a voté à une large majorité en faveur de l'imprescriptibilité des crimes sexuels sur les mineurs.",
      "Cette décision fait suite à un vote similaire des députés à l'Assemblée nationale intervenu trois mois plus tôt.",
      "Des associations de protection de l'enfance saluent cette avancée législative majeure pour les victimes d'inceste."
    ],
    "centre": [
      "Le Sénat a adopté mercredi l'imprescriptibilité des crimes sexuels commis sur les mineurs avec un résultat de 252 voix pour et 80 voix contre.",
      "Cette mesure aligne les crimes sexuels sur les mineurs sur le régime juridique jusqu'ici réservé aux crimes contre l'humanité.",
      "Le texte doit encore faire l'objet d'un vote solennel mardi et d'une commission mixte paritaire avant son adoption définitive."
    ],
    "droite": [
      "Les sénateurs ont approuvé à une large majorité la proposition visant à rendre imprescriptibles les crimes sexuels sur les mineurs.",
      "Le gouvernement a apporté son soutien à cette évolution législative votée par 252 voix pour et 80 voix contre au Sénat."
    ]
  },
