  "summaries": {
    "gauche": [
      "Le parquet espagnol a ordonné l'ouverture d'une investigation visant la plateforme après une plainte déposée par l'association Maldita.es.",
      "L'organisation signale avoir recensé plus de 1 000 vidéos d'agressions sexuelles contre des enfants totalisant 48 millions de vues.",
      "Une infime partie de ces publications explicites aurait été supprimée par le réseau social malgré les signalements effectués."
    ],
    "centre": [
      "La justice espagnole a ouvert une procédure judiciaire contre le réseau social TikTok suite à des signalements pour diffusion de contenus pédopornographiques.",
      "L'association Maldita.es est à l'origine de la plainte après avoir découvert plus de 1 000 séquences d'abus sexuels sur mineurs.",
      "Les investigations diligentées par le parquet visent la production et la diffusion de ces infractions ainsi que la corruption de mineurs."
    ],
    "droite": [
      "Le parquet espagnol a ordonné l'ouverture d'une enquête judiciaire visant la plateforme TikTok pour diffusion de contenus pédophiles.",
      "L'association Maldita.es a publié une investigation chiffrant à plus de 1 000 le nombre de vidéos explicites d'agressions d'enfants hébergées.",
      "Les investigations portent sur les délits d'abus sexuels sur mineurs et de corruption de mineurs sur le réseau social."
    ]
  },
  "differences": [
    "La gauche met l'accent sur le volume d'audience des vidéos et les défailliances de modération signalées par l'association.",
    "Le centre adopte un compte rendu institutionnel centré sur la décision du parquet et la qualification juridique des infractions visées.",
    "La droite privilégie l'impact quantitatif des révélations en reprenant en titre le nombre de vues cumulées par les publications."
  ],
