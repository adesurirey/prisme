  "summaries": {
    "gauche": [
      "Le Premier ministre Sébastien Lecornu réunit les partenaires sociaux à Matignon afin de désamorcer la grogne sociale liée au pouvoir d'achat.",
      "La CGT fustige les propositions gouvernementales qu'elle qualifie de miettes et appelle à une journée de grève et de manifestation le 17 novembre.",
      "Force ouvrière relève que le dogme du coup de pouce au Smic est levé, tandis que la CFDT exigeait une augmentation de 100 euros net."
    ],
    "centre": [
      "Sébastien Lecornu entame une série de consultations à Matignon avec les organisations patronales et syndicales pour apporter des réponses concrètes à la crise du pouvoir d'achat.",
      "La CGT annonce une nouvelle journée de grève et de manifestation pour le 17 novembre à l'issue de cette conférence sociale.",
      "L'exécutif dispose de marges de manœuvre réduites pour revaloriser les salaires au-delà de sa compétence directe sur le Smic."
    ],
    "droite": [
      "Sébastien Lecornu réunit les partenaires sociaux à Matignon pour tenter d'apaiser la colère sociale face à la vie chère.",
      "La CGT et Sophie Binet appellent à une grande journée de grève et de manifestation le 17 novembre à l'issue de la conférence sociale.",
      "Les médias soulignent la difficulté de la tâche pour l'exécutif à quelques mois de la présidentielle, pénalisé par des finances publiques dégradées et l'absence de majorité."
    ]
  },
  "differences": [
    "La gauche insiste sur l'insuffisance des réponses gouvernementales et valorise les revendications d'augmentations salariales portées par les syndicats.",
    "Le centre adopte un ton neutre et institutionnel en décrivant les consultations menées par l'exécutif sous contrainte budgétaire.",
    "La droite met en avant la fragilité politique de l'exécutif face à la contestation sociale à l'approche de l'élection présidentielle."
  ],
