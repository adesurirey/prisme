  "summaries": {
    "gauche": [
      "Le procès de Pierre Ménès s'est ouvert à Nanterre pour harcèlement et agressions sexuelles visant trois femmes.",
      "Le HuffPost met en lumière le témoignage d'une ancienne habilleuse de Canal évoquant la « toute-puissance » du consultant.",
      "L'Humanité rappelle que cette affaire fait suite au documentaire de Marie Portolano dénonçant le sexisme dans les rédactions sportives."
    ],
    "droite": [
      "Le tribunal examine les accusations de harcèlement et d'agressions sexuelles visant l'ancien chroniqueur Pierre Ménès.",
      "La procureure de la République a requis une peine de deux ans de prison, dont un an ferme, à son encontre.",
      "Le réquisitoire exige également le prononcé d'une amende de 20.000 euros en insistant sur la « gravité » des faits."
    ]
  },
  "differences": [
    "La gauche privilégie une mise en contexte sociétale en insistant sur le sexisme dans les milieux sportifs et les témoignages de victimes.",
    "La droite centre son compte-rendu sur le déroulement strict de l'audience judiciaire et le quantum des peines requises par le parquet."
  ],
