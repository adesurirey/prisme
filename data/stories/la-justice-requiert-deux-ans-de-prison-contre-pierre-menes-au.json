  "summaries": {
    "gauche": [
      "Le procès de Pierre Ménès s'est ouvert à Nanterre pour harcèlement et agressions sexuelles visant trois femmes, dont la journaliste Marie Portolano.",
      "Une ancienne habilleuse de Canal+ a témoigné de la « toute-puissance » du consultant au sein de la rédaction sportive.",
      "L'ancien chroniqueur a justifié ses agissements par le climat de l'époque, affirmant que « on ne m’a jamais donné de limites »."
    ],
    "droite": [
      "Le procès de l'ancien chroniqueur de Canal+ s'est tenu devant le tribunal correctionnel pour des accusations d'agressions sexuelles et de harcèlement.",
      "La magistrate a requis une peine de deux ans de prison, assortie d'un an ferme et de 20.000 euros d'amende.",
      "L'ex-journaliste a rejeté les accusations de violence sexuelle en plaidant « une autre époque » et une ambiance qualifiée de « potache »."
    ]
  },
  "differences": [
    "La gauche met l'accent sur les témoignages des victimes et le système de domination au sein du Canal Football Club révélé par Marie Portolano.",
    "La droite privilégie le déroulement judiciaire strict en plaçant au premier plan les réquisitions du parquet et la défense du prévenu."
  ],
