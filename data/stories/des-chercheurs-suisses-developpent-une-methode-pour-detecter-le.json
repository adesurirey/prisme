  "summaries": {
    "gauche": [
      "Des chercheurs de l'Université de Zurich ont découvert une technique innovante pour repérer la drogue dans l'organisme.",
      "Cette avancée scientifique permet d'identifier la substance qualifiée de drogue du violeur sur une période élargie."
    ],
    "centre": [
      "Une équipe scientifique en Suisse a mis au point un nouveau biomarqueur urinaire pour identifier le GHB.",
      "La méthode permet de prolonger la détection de cette substance jusqu'à trois jours après sa consommation."
    ],
    "droite": [
      "Des chercheurs de l'Université de Zurich ont identifié un biomarqueur issu d'un composé de GHB et de sucre, baptisé GHB-pentose.",
      "La nouvelle méthode urinaire étend la fenêtre de détection à 72 heures, dépassant les limites habituelles de six heures dans le sang et douze heures dans l'urine."
    ]
  },
  "differences": [
    "La gauche se focalise sur l'identification des chercheurs universitaires et la découverte de la méthode sans entrer dans les détails techniques.",
    "Le centre expose de manière synthétique l'allongement de la durée de détection grâce au nouveau biomarqueur urinaire.",
    "La droite détaille précisément les aspects techniques de l'étude, citant le nom du biomarqueur et contrastant les anciennes fenêtres de détection avec la nouvelle."
  ],
