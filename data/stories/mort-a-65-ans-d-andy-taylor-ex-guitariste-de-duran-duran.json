  "summaries": {
    "gauche": [
      "Andy Taylor, ancien guitariste de Duran Duran, est mort à l'âge de 65 ans des suites d'un cancer de la prostate",
      "Le musicien britannique était le coauteur des tubes \"Rio\" et \"Hungry Like the Wolf\"",
      "Il avait révélé publiquement en 2022 souffrir d'un cancer de la prostate métastatique"
    ],
    "centre": [
      "Le décès d'Andy Taylor, guitariste historique de Duran Duran, a été annoncé mercredi dans un communiqué par sa famille et le groupe",
      "L'artiste de 65 ans luttait depuis longtemps contre un cancer de la prostate",
      "Il avait quitté la formation britannique au milieu des années 1980 après plusieurs succès avant de revenir ponctuellement pour des enregistrements"
    ],
    "droite": [
      "Andy Taylor, ex-guitariste de la formation new wave des années 1980 Duran Duran, est décédé à 65 ans",
      "Sa famille et le groupe ont officialisé sa disparition par un communiqué publié mercredi",
      "Le musicien a succombé à un cancer de la prostate"
    ]
  },
