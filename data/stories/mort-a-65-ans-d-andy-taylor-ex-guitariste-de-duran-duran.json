  "summaries": {
    "gauche": [
      "Le guitariste de Duran Duran est décédé à l'âge de 65 ans.",
      "Il luttait contre un cancer de la prostate métastatique révélé en 2022.",
      "Le musicien britannique avait coécrit les célèbres chansons \"Rio\" et \"Hungry Like the Wolf\"."
    ],
    "centre": [
      "Andy Taylor, ancien membre de la formation new wave Duran Duran, est mort lundi.",
      "Le décès a été officialisé par sa famille et le groupe dans un communiqué publié mercredi.",
      "L'artiste a succombé à un cancer de la prostate à l'âge de 65 ans."
    ],
    "droite": [
      "L'ex-guitariste de Duran Duran, Andy Taylor, est mort à 65 ans.",
      "Il a succombé à un cancer de la prostate selon un communiqué de ses proches et du groupe publié mercredi."
    ]
  },
