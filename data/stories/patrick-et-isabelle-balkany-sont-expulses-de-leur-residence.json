  "summaries": {
    "gauche": [
      "Le HuffPost relève que les époux Balkany ont quitté leur résidence principale peu avant la trêve hivernale.",
      "Cette mesure fait suite à leur condamnation prononcée en 2023 pour blanchiment de fraude fiscale."
    ],
    "centre": [
      "Patrick et Isabelle Balkany ont quitté le moulin de Cossy à Giverny fin octobre.",
      "Cette résidence principale avait été saisie par la justice en raison de leur condamnation pour fraude fiscale."
    ],
    "droite": [
      "Europe 1 indique que l'ancien couple dirigeant a quitté le moulin de Cossy dans l'Eure.",
      "Une source proche précise que cette mesure est temporaire grâce à un accord conclu avec l'Agrasc pour un retour à court terme."
    ]
  },
