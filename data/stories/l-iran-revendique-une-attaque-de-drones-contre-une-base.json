  "summaries": {
    "gauche": [
      "L'Iran a revendiqué une attaque de drones menée ce dimanche contre une base aérienne américaine à Bahreïn.",
      "Les Gardiens de la révolution ont spécifiquement ciblé la petite base d’hélicoptères d’Al-Riffa avec six appareils.",
      "Les autorités locales de Bahreïn affirment avoir intercepté tous les vecteurs avant qu'ils n'atteignent leurs cibles.",
      "Le Monde souligne qu'il s'agit de la deuxième frappe iranienne en trois jours dans ce pays du Golfe."
    ],
    "centre": [
      "Les Gardiens de la Révolution iraniens ont revendiqué des frappes de drones sur un site militaire américain à Bahreïn.",
      "L'opération a visé une installation militaire et des radars, constituant la deuxième attaque du genre en trois jours dans le pays.",
      "L'armée de Bahreïn assure avoir intercepté l'ensemble des attaques menées contre le territoire."
    ],
    "droite": [
      "Des explosions ont retenti à Bahreïn après une attaque de drones revendiquée par l'Iran contre une base militaire américaine.",
      "Les autorités ont déclenché des sirènes d'alarme et demandé à la population de rejoindre des abris sûrs.",
      "L'armée iranienne aurait précisément ciblé la base d'hélicoptères d'Al-Riffa avec six drones selon les précisions du Figaro."
    ]
  },
