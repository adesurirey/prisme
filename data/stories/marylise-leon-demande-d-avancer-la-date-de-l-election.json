  "summaries": {
    "gauche": [
      "La dirigeante syndicale Marylise Léon souhaite modifier le calendrier de l'élection présidentielle de 2027.",
      "Elle suggère d'avancer le scrutin de sept jours pour écarter tout risque de tension au lendemain du premier mai.",
      "L'entretien accordé à La Tribune Dimanche aborde également la nécessité de mesures immédiates sur le plan social."
    ],
    "centre": [
      "Marylise Léon qualifie le deuxième tour prévu le deux mai de pire scénario possible.",
      "La responsable de la CFDT plaide pour une modification des dates du scrutin présidentiel.",
      "Elle rejoint d'autres responsables politiques dans cette demande d'ajustement du calendrier électoral."
    ],
    "droite": [
      "La secrétaire générale de la CFDT demande de modifier le calendrier de l'élection présidentielle de 2027.",
      "Elle propose d'avancer la date du deuxième tour pour éviter qu'il ne se tienne juste après les défilés de la fête des Travailleurs.",
      "Le président du Sénat Gérard Larcher avait déjà formulé une exigence similaire quelques jours plus tôt."
    ]
  },
  "differences": [
    "Les médias de gauche mettent l'accent sur la proposition syndicale d'avancer le scrutin et l'urgence sociale associée.",
    "Les médias du centre soulignent l'appel à modifier le calendrier électoral pour parer aux risques de tensions au lendemain de la fête des Travailleurs.",
    "Les médias de droite replacent la prise de position de Marylise Léon dans la continuité de la demande formulée par Gérard Larcher."
  ],
