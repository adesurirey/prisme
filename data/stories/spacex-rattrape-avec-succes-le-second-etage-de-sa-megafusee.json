  "summaries": {
    "gauche": [
      "SpaceX a réussi à capturer en vol l'étage supérieur de sa fusée géante Starship.",
      "Cette opération inédite représente une étape majeure dans la conception du lanceur le plus puissant jamais bâti.",
      "Le système est destiné à accomplir des missions habitées vers la Lune et Mars ainsi qu'à déployer des infrastructures informatiques en orbite."
    ],
    "centre": [
      "SpaceX a intercepté pour la première fois le second étage de sa mégafusée Starship à l'issue d'un vol d'essai.",
      "Cette manœuvre complexe constitue un jalon décisif pour parvenir à un lanceur entièrement réutilisable.",
      "Le journal France 24 souligne toutefois qu'un incident technique avait conduit l'entreprise à renoncer à la récupération du premier étage la veille."
    ],
    "droite": [
      "La société SpaceX a capturé avec succès le second étage de son lanceur Starship au moyen de bras mécaniques géants.",
      "La manœuvre a été réalisée après environ quatorze orbites terrestres au-dessus de la base spatiale texane.",
      "Cette réussite technologique ouvre la voie à la réutilisation complète de la plus puissante fusée conçue pour l'exploration martienne et lunaire."
    ]
  },
  "differences": [
    "La gauche met l'accent sur la dimension historique et les ambitions lointaines du projet spatial sans s'attarder sur la complexité technique.",
    "Le centre adopte un ton factuel et synthétique tout en intégrant les difficultés rencontrées en amont sur le premier étage.",
    "La droite privilégie un récit immersif et détaillé des aspects techniques de la manœuvre réalisée au Texas."
  ],
