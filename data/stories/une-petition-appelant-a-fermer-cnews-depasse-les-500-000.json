  "summaries": {
    "gauche": [
      "La pétition en ligne pour interdire CNews a franchi le seuil des 500 000 signataires, stimulée par l'attentat raciste de Trappes.",
      "Le texte déposé à l'Assemblée nationale vise à supprimer une chaîne qualifiée de « machine de propagande » d'extrême droite.",
      "Les initiateurs et les députés de gauche soulignent que ce score historique ouvre la voie à un examen parlementaire, bien que l'issue concrétise ou non un débat dans l'hémicycle reste incertaine."
    ],
    "centre": [
      "Une pétition demandant la fermeture de CNews a dépassé 500 000 signatures sur le site de l'Assemblée nationale.",
      "Ce franchissement de seuil permet d'envisager un débat parlementaire, sous réserve qu'une commission décide d'examiner le texte et de rédiger un rapport.",
      "La chaîne CNews a choisi de ne pas faire de commentaires sur cette initiative politique."
    ],
    "droite": [
      "La pétition réclamant la suppression de CNews a recueilli plus de 500 000 signatures sur le portail de l'Assemblée nationale.",
      "Le député Horizons Jérémie Patrier-Leitus monte au créneau pour défendre le canal d'information en déclarant : « En démocratie, on ne ferme pas les médias ! »",
      "La droite met en garde contre les attaques politiques répétées visant les médias audiovisuels."
    ]
  },
  "differences": [
    "La gauche qualifie ouvertement CNews de vecteur d'extrême droite et insiste sur la légitimité populaire de son interdiction.",
    "Le centre expose de manière neutre la procédure institutionnelle et les conditions d'examen du texte par l'Assemblée nationale.",
    "La droite recentre immédiatement le sujet sur la défense de la liberté d'expression et condamne les assauts politiques contre l'audiovisuel."
  ],
