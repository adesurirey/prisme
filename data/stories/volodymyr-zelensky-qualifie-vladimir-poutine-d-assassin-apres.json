  "summaries": {
    "centre": [
      "Volodymyr Zelensky a qualifié Vladimir Poutine d'« assassin » dans une interview à CNN.",
      "cette sortie fait suite aux déclarations de Donald Trump affirmant être l'« ami » du président russe.",
      "Donald Trump avait également évoqué une volonté de Vladimir Poutine de trouver une issue diplomatique au conflit ukrainien."
    ],
    "droite": [
      "Volodymyr Zelensky a vertement répliqué à Donald Trump en qualifiant Vladimir Poutine d'« assassin ».",
      "le président ukrainien a souligné que pour l'Ukraine et la majorité du monde, le dirigeant russe reste un « ennemi ».",
      "Donald Trump a soutenu que Vladimir Poutine lui avait fait part de son souhait de conclure la guerre en Ukraine par des voies diplomatiques."
    ]
  },
