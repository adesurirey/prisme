  "summaries": {
    "gauche": [
      "Teddy Riner a déclaré lors du Salon des maires que la guerre en Ukraine « n'est pas notre guerre ».",
      "Le candidat à l'élection présidentielle a critiqué l'envoi de troupes et de soldats français pour des missions non combattantes.",
      "Les médias de gauche soulignent son amateurisme politique et estiment que cette sortie relance les doutes sur sa campagne."
    ],
    "centre": [
      "Le candidat à la présidentielle Teddy Riner a affirmé au Congrès des maires à Paris que la guerre en Ukraine n'est pas celle de la France.",
      "Il a suscité la crispation et a été qualifié de commettre une « faute politique » par des députés et acteurs institutionnels.",
      "Il a par la suite précisé ses propos en voulant cesser de donner de l'argent que le pays n'a pas."
    ],
    "droite": [
      "Teddy Riner a affirmé au Congrès des maires de France que « l'Ukraine n'est pas notre guerre ».",
      "Il a justifié son souhait d'avancer l'élection présidentielle en raison d'un contexte international préoccupant.",
      "Le candidat a exprimé son incompréhension face à l'envoi de militaires français et a évoqué un rôle de médiateur pour stopper le conflit."
    ]
  },
  "differences": [
    "La gauche insiste sur les erreurs de communication et l'amateurisme du candidat, qualifiant sa sortie de dérapage qui fragilise sa campagne.",
    "Le centre analyse la séquence sous l'angle de la polémique institutionnelle et des réactions politiques provoquées par ses propos jugés fautifs.",
    "La droite adopte un ton plus factuel sur la déclaration, mettant en avant le souhait du candidat de se positionner en médiateur et d'avancer le calendrier électoral."
  ],
