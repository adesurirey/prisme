  "summaries": {
    "gauche": [
      "Plusieurs plaintes pénales ont été déposées à la suite de violences policières contre des reporters lors des manifestations.",
      "Une intersyndicale de la profession a rencontré Laurent Nuñez pour exiger le respect du droit d'informer.",
      "Le ministre de l'Intérieur a reconnu des lacunes dans la formation des forces de l'ordre et promis des consignes strictes."
    ],
    "centre": [
      "Des représentants des médias ont remis une lettre ouverte à Laurent Nuñez pour dénoncer des atteintes au droit d'informer.",
      "Le ministre de l'Intérieur a promis d'adresser dès vendredi un rappel des règles de maintien de l'ordre à toutes les forces de police."
    ],
    "droite": [
      "L'ONG Reporters sans frontières a recensé 71 cas de journalistes entravés lors des manifestations en France.",
      "Les journalistes demandent officiellement à Laurent Nuñez la garantie du droit d'informer sur le terrain."
    ]
  },
  "differences": [
    "La gauche insiste lourdement sur les violences policières subies par les reporters et pointe des défaillances structurelles dans la formation des forces de l'ordre.",
    "Le centre adopte une posture institutionnelle en se focalisant sur la remise de la lettre ouverte et l'engagement direct du ministre.",
    "La droite privilégie le décompte chiffré des entraves documentées par Reporters sans frontières dans le contexte du mouvement social."
  ],
