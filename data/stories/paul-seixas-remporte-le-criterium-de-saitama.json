  "summaries": {
    "gauche": [
      "Le cycliste français Paul Seixas a remporté le Critérium de Saitama au Japon.",
      "Il a battu sur la ligne d'arrivée l'Américain Brandon McNulty, qui est champion du monde.",
      "Cette épreuve d'exhibition sans points UCI permet au jeune coureur de 20 ans de conclure sa saison 2026."
    ],
    "centre": [
      "Paul Seixas a remporté le Critérium de Saitama devant le champion du monde Brandon McNulty ce 15 novembre.",
      "Le Français termine ainsi sa saison et son séjour en Asie par une victoire, après sa deuxième place à Singapour."
    ],
    "droite": [
      "Paul Seixas a remporté le Critérium de Saitama au Japon, devançant Brandon McNulty.",
      "Il prend sa revanche après sa deuxième place obtenue la semaine précédente à Singapour derrière Isaac Del Toro.",
      "Le biathlète Emilien Jacquelin s'est classé quatorzième de cette épreuve."
    ]
  },
  "differences": [
    "La gauche met l'accent sur la fin de saison d'un jeune coureur de 20 ans et qualifie l'épreuve de course d'exhibition.",
    "Le centre insiste sur la conclusion d'un séjour asiatique réussi après la performance de Singapour.",
    "La droite adopte un angle purement sportif et exhaustif en publiant l'intégralité du classement ainsi que la quatorzième place d'Emilien Jacquelin."
  ],
