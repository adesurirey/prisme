  "summaries": {
    "gauche": [
      "Le CHU de Guadeloupe a subi une « cyberattaque de grande ampleur » ayant lourdement touché le système d'information et la téléphonie.",
      "Le directeur Eric Guyadier a annoncé le déclenchement du plan blanc et la déprogrammation des activités sur une semaine pour prioriser les urgences.",
      "Une cellule de crise a été activée et l'établissement anticipe plusieurs jours de perturbations tout en sécurisant ses outils."
    ],
    "centre": [
      "Le CHU de la Guadeloupe a été la cible d'une « cyberattaque de grande ampleur » survenue dans la nuit de samedi 21 novembre.",
      "Le plan blanc a été immédiatement déclenché au sein de l'établissement alors que celui-ci menait un transfert vers un nouveau site.",
      "L'activité médicale non urgente a dû être déprogrammée afin de maintenir la prise en charge des patients présents."
    ],
    "droite": [
      "Le centre hospitalier universitaire de la Guadeloupe subit une « cyberattaque de grande ampleur » depuis le samedi 21 novembre.",
      "Les autorités sanitaires ont diffusé un appel urgent demandant à la population d'éviter de se rendre aux urgences."
    ]
  },
  "differences": [
    "La gauche insiste lourdement sur la durée des perturbations à venir et l'organisation interne de l'hôpital pour sécuriser les outils.",
    "Le centre se focalise sur la chronologie exacte de l'attaque et la coïncidence avec le déménagement de l'hôpital vers son nouveau site.",
    "La droite met en avant l'appel direct des autorités intimant aux patients d'éviter de se présenter aux urgences."
  ],
