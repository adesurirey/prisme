  "summaries": {
    "gauche": [
      "Le ministère de la Défense finlandais a repéré une agression par drone menée ce samedi 21 novembre contre un navire marchand russe.",
      "L'autorité militaire finlandaise n'a communiqué aucune indication concernant la provenance de cet assaut."
    ],
    "centre": [
      "Les forces armées finlandaises ont repéré ce samedi matin une agression menée par un engin volant sans pilote contre un navire de transport russe dans le golfe de Finlande.",
      "Le ministère de la Défense de la nation nordique a immédiatement transmis ces éléments à ses partenaires au sein de l'Otan."
    ],
    "droite": [
      "L'institution militaire finlandaise a repéré un assaut par drone mené contre un bâtiment de commerce russe dans les eaux internationales.",
      "L'incident s'est déroulé précisément à l'ouest de l'île de Suursaari, dans la zone orientale du golfe de Finlande."
    ]
  },
