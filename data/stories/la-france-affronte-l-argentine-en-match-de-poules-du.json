  "summaries": {
    "gauche": [
      "Le XV de France s'est largement imposé face à l'Argentine sur le score de 45 à 17 au Stade de France.",
      "Cette victoire bonifiée permet aux Bleus de terminer premiers de la poule Nord du Championnat des nations.",
      "Les Français disputeront la finale de la compétition contre l'Afrique du Sud le week-end prochain à Twickenham.",
      "Le Parisien a également mis en avant l'hommage solennel rendu à Federico Martin Aramburu avant la rencontre."
    ],
    "centre": [
      "L'équipe de France a battu l'Argentine 45-17 au Stade de France pour s'assurer la première place de sa poule.",
      "Après une première période de doute, les Bleus ont déroulé leur jeu pour s'offrir une victoire bonifiée.",
      "Ils retrouveront l'Afrique du Sud le 29 novembre à Twickenham pour la finale du Championnat des nations.",
      "Le Parisien a couvert l'événement en direct tout en soulignant le moment d'hommage à Federico Martin Aramburu."
    ],
    "droite": [
      "Le XV de France a battu l'Argentine (45-17) au Stade de France en marquant sept essais à deux.",
      "En terminant en tête de leur poule du Championnat des nations, les hommes de Fabien Galthié valident leur billet pour la finale.",
      "Antoine Dupont et ses coéquipiers affronteront l'Afrique du Sud, qu'ils avaient déjà dominée le 14 novembre, le 29 novembre à Twickenham.",
      "Le Figaro et CNews ont proposé des analyses détaillées, notamment les notes des joueurs et le résumé vidéo de la rencontre."
    ]
  },
