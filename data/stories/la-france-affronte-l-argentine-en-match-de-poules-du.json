  "summaries": {
    "gauche": [
      "Le XV de France s'est largement imposé face à l'Argentine sur le score de 45 à 17 au Stade de France.",
      "Cette victoire bonifiée permet aux Bleus de valider leur première place de poule et leur qualification pour la finale.",
      "La France affrontera l'Afrique du Sud, qualifiée sous l'appellation des Springboks, le week-end prochain à Twickenham pour l'ultime rencontre."
    ],
    "centre": [
      "Les Bleus ont dominé l'Argentine 45-17 au Stade de France au terme d'un match où ils ont d'abord douté avant de dérouler.",
      "L'équipe de France s'empare de la première place de sa poule devant l'Angleterre et accède à la finale de la première édition de ce tournoi.",
      "Le XV de France retrouvera l'Afrique du Sud le 29 novembre prochain à Twickenham pour un choc au sommet.",
      "Le Parisien met en avant les notes des joueurs, saluant la performance explosive de Gourgues et le rôle de leader de Dupont."
    ],
    "droite": [
      "Le XV de France a écrasé l'Argentine sur le score de 45 à 17 au Stade de France lors de la dernière journée de la phase régulière.",
      "Portés par les performances notables de joueurs comme Kalvin Gourgues et Antoine Dupont, les Bleus filent en finale du Championnat des nations.",
      "La formation tricolore disputera le trophée aux Springboks sud-africains dimanche prochain à Twickenham à l'issue de ce tournoi inédit."
    ]
  },
