  "summaries": {
    "gauche": [
      "L'équipe de France s'est inclinée sur le score de 3 à 0 face à l'Australie lors des barrages de la Billie Jean King Cup.",
      "Cette défaite maintenue ce dimanche envoie la sélection nationale en deuxième division pour une troisième saison consécutive."
    ],
    "centre": [
      "Les joueuses françaises ont été lourdement battues par l'Australie sur un score de 3 à 0 lors du barrage disputé au Portel.",
      "Ce revers scelle le maintien de l'équipe de France en deuxième division pour la troisième année d'affilée."
    ],
    "droite": [
      "L'équipe de France dirigée par Alizé Cornet a subi une défaite nette 3 à 0 contre l'Australie lors du barrage d'accession au Portel.",
      "Après les défaites en simple de Clara Burel et Diane Parry, la paire Kristina Mladenovic et Diane Parry a cédé en double, condamnant la France à une troisième saison en deuxième division."
    ]
  },
