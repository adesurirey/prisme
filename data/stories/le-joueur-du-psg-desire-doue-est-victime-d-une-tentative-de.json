  "summaries": {
    "gauche": [
      "Le footballeur du PSG a subi une grave blessure au genou droit lors de la rencontre face à Nice.",
      "Quatre individus ont commis une tentative d'intrusion dans sa résidence située dans les Yvelines pendant la nuit."
    ],
    "centre": [
      "L'attaquant parisien a enchaîné une rupture des ligaments croisés à Nice et une tentative d'effraction chez lui.",
      "Les gendarmes sont intervenus devant sa propriété des Yvelines suite à cette incursion nocturne."
    ],
    "droite": [
      "Le joueur a cumulé une rupture du ligament croisé antérieur à Nice et une tentative d'intrusion à son domicile d'Orgeval.",
      "Trois premiers individus se sont d'abord présentés pour prendre des photographies avant qu'un groupe de quatre personnes ne tente d'escalader le portail.",
      "La compagne du sportif a mis les intrus en fuite par l'arrière de la propriété.",
      "Une enquête a été ouverte par la justice pour élucider cette affaire."
    ]
  },
