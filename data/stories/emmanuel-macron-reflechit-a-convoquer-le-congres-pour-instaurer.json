  "summaries": {
    "centre": [
      "Le chef de l'État envisage de réunir en janvier prochain le Congrès à Versailles pour faire adopter une règle d'or budgétaire.",
      "Cette disposition viserait à inscrire dans la Constitution une contrainte interdisant de financer les dépenses courantes par l'emprunt.",
      "Le projet s'appuierait sur un texte constitutionnel déjà voté en 2011 sous le gouvernement de François Fillon mais resté inachevé."
    ],
    "droite": [
      "Emmanuel Macron songerait à convoquer les parlementaires en Congrès à Versailles dès le mois de janvier pour constitutionnaliser une règle d'or budgétaire.",
      "Cette règle contraindrait les finances publiques à limiter l'emprunt aux seules dépenses d'investissement, interdisant son usage pour les dépenses courantes.",
      "L'exécutif pourrait s'appuyer sur un projet de loi de 2011 initié par le gouvernement de François Fillon et voté à l'époque par les deux chambres.",
      "L'Élysée n'a fait aucun commentaire à l'Agence France-Presse concernant ces informations révélées par La Tribune Dimanche."
    ]
  },
  "differences": [
    "Les médias du centre exposent de manière strictement institutionnelle et technique le projet présidentiel de convocation du Congrès.",
    "Les médias de droite adoptent un angle pédagogique en définissant précisément la notion économique de règle d'or tout en intégrant des réactions politiques comme celle du Rassemblement national."
  ],
