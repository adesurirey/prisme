  "summaries": {
    "gauche": [
      "Emmanuel Macron envisage de convoquer les députés et les sénateurs en Congrès à Versailles en janvier pour instaurer une règle d'or budgétaire dans la Constitution.",
      "Le chef de l'État s'appuierait sur un texte datant de 2011 et bénéficierait de l'appui de la droite et de l'extrême droite.",
      "Cette initiative intervient dans un contexte de dérapage des finances publiques et de hausse de l'endettement."
    ],
    "centre": [
      "Emmanuel Macron réfléchit à réunir le Parlement en Congrès à Versailles au mois de janvier.",
      "L'objectif de cette convocation est d'inscrire une règle d'or budgétaire dans la Constitution.",
      "Le projet s'appuierait sur une proposition de loi constitutionnelle examinée en 2011 sous le gouvernement de François Fillon."
    ],
    "droite": [
      "Le président de la République envisage de convoquer le Congrès à Versailles en janvier pour inscrire une règle d'or budgétaire dans la Constitution.",
      "L'exécutif songerait à utiliser un texte constitutionnel voté par les deux chambres en 2011 à l'initiative de François Fillon.",
      "Des personnalités politiques comme Jordan Bardella et Bruno Retailleau ont salué cette initiative tout en critiquant la gestion de la dette."
    ]
  },
  "differences": [
    "La gauche qualifie la règle d'or d'austéritaire et insiste sur l'alliance tacite avec la droite et l'extrême droite pour faire passer ce projet.",
    "Le centre adopte un ton strictement informatif en relayant l'hypothèse d'un Congrès à Versailles sans dramatiser la portée de la réforme.",
    "La droite met en avant son rôle pionnier en rappelant l'origine du texte en 2011 sous François Fillon et intègre directement les réactions de ses dirigeants."
  ],
