  "summaries": {
    "gauche": [
      "La Russie a déclaré avoir intercepté plus de 1 200 drones ukrainiens dans la nuit de vendredi à samedi.",
      "Le maire de Moscou a indiqué que plus de 450 appareils visaient spécifiquement la capitale russe."
    ],
    "centre": [
      "Le ministère russe de la Défense a annoncé l'interception de 1 246 drones ukrainiens sur le territoire national durant la nuit.",
      "Le maire de Moscou a précisé que 462 aéronefs ont été lancés en direction de la capitale, la plupart ayant été neutralisés sans bilan officiel de dégâts ou de victimes."
    ],
    "droite": [
      "Les forces antiaériennes russes ont intercepté plus de 1 200 drones ukrainiens à travers le pays dans la nuit de vendredi à samedi.",
      "Le maire de Moscou a dénombré 460 attaques aériennes dirigées vers sa ville, sans qu'aucun bilan humain ou matériel ne soit communiqué par les autorités."
    ]
  },
