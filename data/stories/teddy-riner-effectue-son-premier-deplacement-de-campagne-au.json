  "summaries": {
    "gauche": [
      "Le judoka Teddy Riner effectue son premier déplacement de campagne au salon du Made in France à Paris ce 14 novembre.",
      "Le quintuple champion olympique a surpris la classe politique en annonçant sa candidature à l'élection présidentielle de 2027 au début de la semaine."
    ],
    "centre": [
      "Teddy Riner a dévoilé son calendrier de campagne, comprenant une visite en hôpital en Seine-Saint-Denis avant de se rendre au salon du Made in France à Paris.",
      "Le candidat positionné ni de droite ni de gauche suscite les premières réactions politiques, Jean-Luc Mélenchon l'invitant à se méfier de ses conseillers.",
      "Le quintuple champion olympique motive sa candidature par la volonté de rassembler un pays divisé après les Jeux olympiques de Paris 2024."
    ],
    "droite": [
      "Teddy Riner débutera sa campagne présidentielle de 2027 ce samedi 14 novembre au salon du Made in France porte de Versailles.",
      "Le champion olympique a officialisé sa candidature surprise lundi, motivé par le désir de retrouver l'unité observée pendant les JO de Paris.",
      "L'entourage du néo-candidat a confirmé sa visite sur ce site mettant en avant la production française."
    ]
  },
