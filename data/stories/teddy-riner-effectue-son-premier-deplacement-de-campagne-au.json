  "summaries": {
    "gauche": [
      "Le judoka Teddy Riner effectue son premier déplacement de campagne le 14 novembre au salon du Made in France à Paris.",
      "L'ancien champion olympique a surpris la classe politique en annonçant sa candidature à l'élection présidentielle de 2027 au début de la semaine."
    ],
    "centre": [
      "Le quintuple champion olympique Teddy Riner a entamé ses visites de terrain par un hôpital en Seine-Saint-Denis pour placer la santé au coeur de ses priorités.",
      "Le candidat s'est ensuite rendu au salon du Made in France à la porte de Versailles à Paris.",
      "Jean-Luc Mélenchon a réagi depuis le salon en estimant que le candidat devrait se méfier de ses conseillers après sa visite dans un établissement de santé."
    ],
    "droite": [
      "Teddy Riner a officialisé son premier déplacement de campagne au salon du Made in France programmé le samedi 14 novembre.",
      "Le quintuple champion olympique a motivé sa décision de briguer l'Élysée par le constat d'un pays uni puis divisé après les Jeux olympiques de Paris 2024."
    ]
  },
