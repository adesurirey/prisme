  "summaries": {
    "gauche": [
      "L'Autorité italienne de protection des données personnelles a infligé une amende de 805 millions d'euros à la maison mère Meta.",
      "Cette sanction vise l'accès aux photos effectué sans obtenir le consentement spécifique des utilisateurs sur Facebook.",
      "Cette pénalité financière figure parmi les sanctions les plus lourdes prononcées en Italie à l'encontre d'un géant du numérique."
    ],
    "centre": [
      "Meta a été condamnée en Italie à verser 805 millions d'euros pour avoir accédé aux galeries photos sans l'accord des utilisateurs.",
      "L'infraction concerne l'absence de recueil d'un consentement spécifique pour l'application mobile, touchant notamment les appareils Android selon Le Parisien.",
      "Cette décision s'inscrit dans une série de contentieux judiciaires visant le groupe de Mark Zuckerberg à l'international."
    ],
    "droite": [
      "L'autorité italienne de protection des données a condamné Meta à une amende de 805 millions d'euros.",
      "La sanction est motivée par l'accès aux métadonnées et aux photos des utilisateurs d'Android sans information préalable ni accord explicite.",
      "Cette procédure s'ajoute à d'autres sanctions financières prononcées contre des entreprises technologiques comme Amazon ou contre Meta aux États-Unis."
    ]
  },
