  "summaries": {
    "centre": [
      "La chanteuse Parastoo Ahmadi a subi 74 coups de fouet pour avoir chanté sans voile dans une vidéo en ligne vue des millions de fois.",
      "Le Haut-Commissaire de l'ONU et le gouvernement français ont condamné fermement cette décision judiciaire iranienne qualifiée d'acte de torture."
    ],
    "droite": [
      "La chanteuse Parastoo Ahmadi et quatre membres de son équipe ont reçu 74 coups de fouet à Qom pour une performance musicale sans le hijab obligatoire.",
      "L'information a été relayée par son avocat et l'ONG Iran Human Rights, tandis que les autorités iraniennes n'ont pas réagi immédiatement."
    ]
  },
  "differences": [
    "Le camp centre privilégie une mise en récit axée sur les condamnations diplomatiques internationales et institutionnelles de la sentence.",
    "Le camp droite adopte un angle factuel et précis sur le déroulement exact de la peine en s'appuyant sur les détails fournis par les ONG et la défense."
  ],
