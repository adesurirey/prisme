  "summaries": {
    "gauche": [
      "Emmanuel Macron annonce l'interdiction de toutes les manifestations non syndicales pour la journée du 24 octobre à l'issue d'un conseil de sécurité.",
      "Le gouvernement justifie ces interdictions par les risques de troubles et les violences survenues lors du mouvement social du 17 octobre.",
      "Le parcours parisien déposé par des collectifs étudiants, lycéens et de salariés est validé entre la Bastille et Nation par la préfecture de police.",
      "La manifestation déclarée par des collectifs comme les gilets jaunes et l'Interfac entre la Bastille et l'Opéra fait l'objet d'un arrêté d'interdiction."
    ],
    "centre": [
      "Emmanuel Macron annonce que seules les manifestations organisées par les syndicats seront autorisées pour la journée du 24 octobre.",
      "La porte-parole du gouvernement Maud Bregeon précise que les interdictions pour les cortèges hors syndicats se feront au cas par cas.",
      "Des tracés alternatifs seront proposés aux organisations syndicales afin de protéger les centres-villes et les bâtiments publics.",
      "À Paris, la préfecture de police valide le parcours de la manifestation syndicale entre la place de la Bastille et la place de la Nation."
    ],
    "droite": [
      "Le président de la Emmanuel Macron confirme l'interdiction des rassemblements non syndicaux pour la mobilisation du 24 octobre.",
      "La préfecture de police de Paris valide le parcours syndical entre Bastille et Nation tout en interdisant le tracé vers Opéra.",
      "Ces décisions interviennent après les émeutes et les dégradations constatées la semaine précédente en marge des cortèges."
    ]
  },
  "differences": [
    "La gauche insiste sur la généralisation de la mesure d'interdiction pour cibler les mouvements non syndicaux en invoquant le contexte social.",
    "Le centre adopte un ton factuel et institutionnel en détaillant les modalités pratiques des interdictions au cas par cas et les tracés alternatifs.",
    "La droite se focalise sur la gestion concrète de l'ordre public à Paris en opposant les parcours validés aux rassemblements interdits."
  ],
