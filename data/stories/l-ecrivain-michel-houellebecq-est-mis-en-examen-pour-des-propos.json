  "summaries": {
    "gauche": [
      "L'écrivain Michel Houellebecq a été mis en examen par un juge d'instruction pour complicité de provocation à la discrimination, à la haine ou à la violence.",
      "Cette procédure judiciaire fait suite à un entretien publié fin novembre 2022 dans la revue « Front populaire » dirigée par Michel Onfray.",
      "Les articles rappellent les propos tenus incluant des visions hostiles aux musulmans, la théorie du « Grand remplacement » et des prédictions de violences."
    ],
    "centre": [
      "Michel Houellebecq a été mis en examen le 10 novembre par le tribunal de Nanterre.",
      "La qualification retenue contre l'auteur est la complicité de provocation à la discrimination, à la haine ou à la violence.",
      "La procédure découle d'un entretien accordé en novembre 2022 à la revue « Front populaire » contenant des propos hostiles aux musulmans."
    ],
    "droite": [
      "Michel Houellebecq est mis en examen pour des propos sur les musulmans et le « grand remplacement » tenus dans la revue « Front populaire ».",
      "L'Union des mosquées de France et le MRAP maintiennent leur plainte tandis que la Grande Mosquée de Paris avait retiré la sienne.",
      "Les avocats de l'écrivain contestent toute incitation à la discrimination et dénoncent une judiciarisation du débat intellectuel."
    ]
  },
  "differences": [
    "La gauche qualifie directement les propos d'islamophobes et met en avant la nature précise des déclarations polémiques sur les agressions et les mosquées.",
    "Le centre adopte un ton strictement factuel et neutre sur la procédure judiciaire en se limitant aux faits juridiques et au cadre de la mise en examen.",
    "La droite insiste sur le contexte du débat intellectuel, donne la parole aux avocats qui dénoncent une judiciarisation et détaille les actions des différentes associations musulmanes."
  ],
