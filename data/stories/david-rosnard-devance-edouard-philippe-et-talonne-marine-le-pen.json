  "summaries": {
    "gauche": [
      "Un sondage OpinionWay pour CNEWS positionne David Lisnard en troisième position avec 12 % des intentions de vote pour l'élection présidentielle de 2027.",
      "Édouard Philippe chute à 8 % dans cette même étude tandis que Marine Le Pen conserve la tête des intentions de vote."
    ],
    "centre": [
      "David Lisnard progresse dans les sondages pour l'élection présidentielle de 2027 et s'installe à la troisième place avec 12 % des voix.",
      "Édouard Philippe enregistre une forte baisse en tombant à 8 % des intentions de vote selon un sondage OpinionWay.",
      "Bruno Le Maire estime que la percée de David Lisnard s'explique par un projet de rupture."
    ],
    "droite": [
      "David Lisnard atteint 12 % des intentions de vote et dépasse Édouard Philippe, crédité de 8 % dans un sondage OpinionWay pour CNEWS et Le JDD.",
      "Marine Le Pen reste en tête des intentions de vote avec 33 %, suivie de Jean-Luc Mélenchon à 16 %.",
      "Gérald Darmanin dénonce le refus de David Lisnard de choisir entre Édouard Philippe et Marine Le Pen.",
      "David Lisnard fait l'objet de critiques de ses rivaux politiques et précise ses mesures sur la sécurité et l'immigration."
    ]
  },
