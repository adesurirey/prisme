  "summaries": {
    "gauche": [
      "Le tableau \"Châtaigniers en fleurs\" de Vincent van Gogh a été adjugé à 190,4 millions de dollars chez Sotheby’s à New York.",
      "Cette vente constitue un record absolu pour une œuvre du peintre néerlandais sur le marché des enchères.",
      "Le Monde signale qu'un accord a été trouvé en amont avec une famille qui contestait la vente en raison d'une acquisition sous le régime nazi."
    ],
    "centre": [
      "L'œuvre \"Châtaigniers en fleurs\" a atteint 190,4 millions de dollars lors d'une vente aux enchères organisée par Sotheby's à New York.",
      "Ce montant établit une performance historique, plaçant la toile parmi les œuvres les plus chères jamais vendues aux enchères.",
      "Plusieurs médias rappellent qu'un accord avait été conclu la veille avec les héritiers d'un ancien propriétaire juif qui s'opposaient à la mise en vente."
    ],
    "droite": [
      "Le tableau \"Châtaigniers en fleurs\" de Vincent van Gogh a été vendu pour 190,4 millions de dollars à New York.",
      "Cette transaction historique représente un record pour le maître néerlandais.",
      "Le Figaro précise qu'un accord a été trouvé in extremis avec les héritiers d'un ancien propriétaire juif qui contestaient la vente."
    ]
  },
