  "summaries": {
    "gauche": [
      "Lilia Hassaine a reçu le prix Goncourt des lycéens 2026 pour son roman \"JE\", publié chez Gallimard.",
      "Le livre s'inspire du personnage de Bertha Mason dans \"Jane Eyre\" de Charlotte Brontë pour évoquer l'émancipation féminine face à l'emprise conjugale.",
      "La distinction a été attribuée à Rennes par un jury de douze élèves délégués représentant une cinquantaine d'établissements scolaires."
    ],
    "centre": [
      "Le prix Goncourt des lycéens 2026 a été attribué à Lilia Hassaine pour son roman \"JE\" aux éditions Gallimard.",
      "L'ouvrage revisite le destin d'Antoinette Cosway, personnage secondaire de \"Jane Eyre\" de Charlotte Brontë.",
      "Le livre analyse la fabrique de l'emprise psychologique et la réduction au silence dans le sillage du mouvement #MeToo."
    ],
    "droite": [
      "Lilia Hassaine a remporté le prix Goncourt des lycéens 2026 pour son roman \"JE\", publié aux éditions Gallimard.",
      "Le livre revisite \"Jane Eyre\" de Charlotte Brontë en se plaçant du point de vue de Bertha Mason, la première femme de Rochester.",
      "L'ouvrage met en lumière un personnage de fiction réduit au silence afin de dénoncer l'emprise du patriarcat."
    ]
  },
  "differences": [
    "La gauche met en avant le parcours démocratique et l'expérience des lycéens à travers le processus de sélection des jurés.",
    "Le centre contextualise la récompense dans le sillage du mouvement #MeToo en insistant sur l'analyse de l'emprise psychologique.",
    "La droite souligne la dimension littéraire de la relecture du classique de Charlotte Brontë et la dénonciation du patriarcat."
  ],
