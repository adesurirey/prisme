  "summaries": {
    "gauche": [
      "Le ministre de la Justice a engagé des poursuites devant le Conseil supérieur de la magistrature à l'encontre d'une substitute du procureur d'Auch.",
      "Il est reproché à la magistrate des manquements professionnels lors de la gestion du dossier visant Jérôme Barella.",
      "Cette décision fait suite au traitement défaillant de la procédure judiciaire concernant des violences sur mineurs."
    ],
    "centre": [
      "Gérald Darmanin a saisi le Conseil supérieur de la magistrature contre une substitute du procureur d'Auch dans l'affaire Lyhanna.",
      "Le garde des Sceaux pointe un manquement au devoir de conscience professionnelle concernant le suivi du dossier de Jérôme Barella, suspecté du viol et du meurtre de la fillette de 11 ans.",
      "La mesure ministérielle intervient à la suite des conclusions d'une enquête administrative menée par l'Inspection générale de la justice."
    ],
    "droite": [
      "Le ministre de la Justice a saisi le CSM contre une membre du parquet d'Auch pour « manquement à son devoir de conscience professionnelle » dans l'affaire Lyhanna.",
      "Il lui est reproché de n'avoir ni vérifié les antécédents de l'auteur présumé Jérôme Barella, ni fixé de point d'enquête avec la police.",
      "Cette saisine disciplinaire, assortie de sanctions attendues, fait suite à un rapport d'inspection remis près de deux mois plus tôt."
    ]
  },
  "differences": [
    "La gauche insiste sur le caractère défaillant du traitement initial des dossiers de violences sur mineurs pour expliquer la mise en cause de la magistrate.",
    "Le centre livre un compte-rendu factuel et centré sur la chronologie institutionnelle de la saisine du CSM par le garde des Sceaux.",
    "La droite détaille plus précisément les griefs techniques retenus contre la magistrate, en insistant sur l'attente de sanctions et sur les aspects précis de l'enquête."
  ],
