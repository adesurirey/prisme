  "summaries": {
    "gauche": [
      "La justice jordanienne a prononcé trois condamnations à mort par pendaison après l'attentat de Karak du 23 octobre.",
      "Le bilan de cet attentat contre une église grecque orthodoxe s'établit à neuf morts et 25 blessés.",
      "Les condamnés disposent d'une possibilité de pourvoi en cassation."
    ],
    "centre": [
      "Trois individus ont été condamnés à mort par pendaison pour l'assaut perpétré contre une église à Hammoud.",
      "Le roi Abdallah II avait publiquement exigé des sanctions exemplaires contre les assaillants."
    ]
  },
  "differences": [
    "La gauche met en avant le bilan humain précis de l'attaque et la procédure judiciaire en cours avec le recours en cassation.",
    "Le centre insiste sur l'implication politique du roi Abdallah II qui réclamait les peines les plus sévères."
  ],
