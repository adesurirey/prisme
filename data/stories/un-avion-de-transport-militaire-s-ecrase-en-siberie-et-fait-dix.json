  "summaries": {
    "gauche": [
      "Un Antonov An-12 s'est écrasé dans une zone non habitée de la région de Kemerovo en Sibérie.",
      "Le vol régulier de cet appareil de transport militaire a coûté la vie à dix-neuf personnes.",
      "Le ministère de la Défense russe a communiqué sur les circonstances de cette catastrophe aérienne."
    ],
    "centre": [
      "Dix-neuf personnes ont péri dans le crash d'un avion de transport militaire An-12 en Sibérie.",
      "L'accident s'est produit le mardi 17 novembre dans la région de Kemerovo en Sibérie occidentale.",
      "Une défaillance technique est envisagée pour expliquer la cause de cette tragédie aérienne."
    ],
    "droite": [
      "Un avion militaire s'est écrasé le mardi 17 novembre dans la région de Kemerovo, au sud de la Russie.",
      "Le drame s'est produit près du village de Yagunovo.",
      "Dix-neuf personnes ont perdu la vie dans cette catastrophe aérienne."
    ]
  },
