  "summaries": {
    "gauche": [
      "Le parquet a été saisi par la direction générale de la police nationale après la révélation par Le Parisien de messages et de caricatures racistes ainsi que de saluts nazis au sein de l'ENSP de Cannes-Écluse.",
      "Libération précise que l'école nationale supérieure de la police n'avait pris aucune sanction au moment des signalements et mentionne également la présence de propos sexistes.",
      "Les faits se déroulent dans des groupes de discussion en ligne utilisés par les élèves-officiers de la 31e promotion."
    ],
    "centre": [
      "Le patron de la police nationale a saisi le parquet de Fontainebleau suite à la publication d'une enquête du Parisien concernant l'ENSP de Cannes-Écluse en Seine-et-Marne.",
      "Les investigations portent sur des échanges au sein de boucles privées regroupant des élèves-officiers, futurs cadres de la police.",
      "Les faits recensés englobent des messages racistes, un salut nazi photographié, des dessins caricaturaux et un photomontage d'un enfant nu."
    ],
    "droite": [
      "La direction générale de la police nationale a effectué un signalement à la justice à la suite d'une enquête du Parisien sur l'école des officiers de Cannes-Écluse.",
      "Les faits reprochés à des membres de la 31e promotion incluent des messages racistes, des caricatures et un salut nazi partagés dans des boucles de discussion privées.",
      "Le Figaro précise qu'un élève a été suspendu à ce stade de l'enquête pour ces échanges impliquant de futurs diplômés attendus pour début 2027."
    ]
  },
  "differences": [
    "La gauche met l'accent sur l'absence initiale de sanctions de la part de l'administration de l'école et élargit le constat aux propos sexistes.",
    "Le centre livre un compte-rendu factuel axé sur l'origine journalistique des révélations et la matérialité des infractions signalées au parquet.",
    "La droite se focalise sur le profil des étudiants concernés, futurs diplômés, et signale la mesure conservatoire de suspension déjà prise à l'encontre d'un élève."
  ],
