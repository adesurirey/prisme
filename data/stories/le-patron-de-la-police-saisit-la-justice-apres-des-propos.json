  "summaries": {
    "gauche": [
      "La direction générale de la police nationale a saisi la justice après la diffusion de messages problématiques au sein de l'École nationale supérieure de la police.",
      "Des étudiants de la 31e promotion ont partagé des contenus haineux, sexistes et antisémites dans des boucles de discussion en ligne.",
      "Libération souligne en outre que l'établissement concerné n'avait prononcé aucune sanction initiale malgré le signalement des faits."
    ],
    "centre": [
      "La Direction générale de la police nationale a effectué un signalement judiciaire concernant des comportements répréhensibles dans une école de police de Seine-et-Marne.",
      "Des élèves officiers de l'ENSP à Cannes-Écluse ont partagé des caricatures, des propos haineux et une photographie d'un salut nazi dans des groupes de discussion.",
      "Le Parisien est à l'origine des révélations sur ces agissements survenus au sein de cette promotion de futurs cadres de la police."
    ],
    "droite": [
      "Le patron de la police a saisi la justice suite à la divulgation d'échanges inadaptés entre des élèves de l'École nationale supérieure de la police.",
      "Les investigations font suite à des publications incluant des caricatures, des messages haineux et un salut nazi circulant dans des boucles privées.",
      "Le Figaro précise qu'un élève a déjà fait l'objet d'une suspension à ce stade de la procédure pour la 31e promotion diplômée début 2027."
    ]
  },
  "differences": [
    "La gauche insiste sur la gravité des infractions commises en interne et pointe l'absence initiale de réaction de l'administration face aux dérives signalées.",
    "Le centre privilégie une approche factuelle centrée sur l'enquête journalistique initiale et la nature des infractions découvertes dans l'établissement de Seine-et-Marne.",
    "La droite met l'accent sur les mesures disciplinaires déjà prises à l'encontre d'un élève et le calendrier de formation de la promotion concernée."
  ],
