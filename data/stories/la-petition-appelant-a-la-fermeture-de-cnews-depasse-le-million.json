  "summaries": {
    "gauche": [
      "La pétition demandant la fermeture de la chaîne de Vincent Bolloré a franchi le seuil du million de signatures dimanche 8 novembre.",
      "Le texte qualifie la chaîne d'information d'extrême droite de « machine de propagande ».",
      "Les députés de la commission des Affaires culturelles doivent décider mardi si la demande fera l'objet d'un débat dans l'hémicycle ou d'un classement sans suite."
    ],
    "centre": [
      "La pétition en ligne réclamant la suppression de CNews de l'audiovisuel français a dépassé le million de signatures ce dimanche.",
      "La commission des Affaires culturelles de l'Assemblée nationale se réunit mardi pour statuer sur l'organisation d'un débat ou un classement sans suite.",
      "franceinfo rappelle que seule la pétition contre la loi Duplomb avait atteint ce niveau depuis le lancement de la plateforme parlementaire en 2020."
    ],
    "droite": [
      "La pétition appelant à supprimer CNews de l'audiovisuel français a dépassé un million de signatures le dimanche 8 novembre.",
      "Le texte mentionne que l'extrême droite s'étale en prime time sur cette antenne.",
      "Un vote est programmé mardi en commission à l'Assemblée nationale pour déterminer la suite accordée à cette initiative."
    ]
  },
