  "summaries": {
    "gauche": [
      "Trois espoirs du Stade Rochelais ont été placés en garde à vue pour violences aggravées.",
      "Les faits se sont déroulés à la suite d'une altercation survenue dans une discothèque.",
      "Les joueurs sont soupçonnés d'avoir frappé violemment deux victimes âgées de 19 ans."
    ],
    "centre": [
      "Trois jeunes joueurs du Stade Rochelais ont été placés en garde à vue dimanche 15 novembre.",
      "Ils sont mis en cause pour des violences aggravées commises à la sortie d'un établissement de nuit.",
      "L'un des mis en cause est identifié par Ouest-France comme étant la pépite Visesio Kite."
    ],
    "droite": [
      "Trois espoirs du club de rugby de La Rochelle font l'objet d'une garde à vue.",
      "La mesure fait suite à une altercation survenue en boîte de nuit dans la nuit de samedi à dimanche.",
      "Les sportifs auraient exercé des violences physiques intenses sur deux autres personnes."
    ]
  },
  "differences": [
    "La gauche privilégie un compte-rendu direct des faits en insistant sur la jeunesse des victimes impliquées dans l'agression.",
    "Le centre adopte une couverture factuelle classique tout en se distinguant par la nomination précise d'un joueur vedette.",
    "La droite qualifie l'affaire à travers le prisme du Top 14 en insistant sur le caractère violent de l'altercation nocturne."
  ],
