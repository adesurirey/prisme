  "summaries": {
    "gauche": [
      "L'équipe de France affrontera l'Espagne en quarts de finale de la Ligue des nations les 25 et 30 mars 2027.",
      "Le tirage au sort a eu lieu vendredi à Nyon, en Suisse, désignant la sélection espagnole, championne du monde en titre, comme adversaire des Bleus de Zinédine Zidane."
    ],
    "centre": [
      "Le tirage au sort effectué ce vendredi au siège de l'UEFA en Suisse a placé l'Espagne sur le chemin de l'équipe de France pour les quarts de finale de la Ligue des nations.",
      "Ces matchs aller-retour se dérouleront en mars 2027.",
      "Le sélectionneur Zinédine Zidane a minimisé la portée de revanche de cette confrontation face aux champions du monde."
    ],
    "droite": [
      "L'équipe de France affrontera l'Espagne en quarts de finale de la Ligue des nations lors d'une double confrontation aller-retour les 25 et 30 mars 2027.",
      "Le tirage au sort réalisé au siège de l'UEFA à Nyon a désigné les champions du monde espagnols, qualifiés de bourreaux des Bleus au Mondial 2026 et d'adversaires les plus coriaces.",
      "Le sélectionneur Zinédine Zidane a estimé qu'il ne s'agissait pas d'une revanche de la demi-finale du Mondial."
    ]
  },
  "differences": [
    "La gauche insiste factuellement sur le calendrier des rencontres de mars 2027 et le statut de championne du monde de l'Espagne.",
