  "summaries": {
    "gauche": [
      "Philippe Jaenada remporte le prix Goncourt 2026 pour son roman \"L'Inconnue du quai de Javel\", publié chez Flammarion.",
      "Le livre mêle autofiction et enquête historique autour du meurtre de Louise Cansot à Paris en 1949.",
      "La presse de gauche met en avant la popularité de l'auteur et un art maîtrisé de la digression littéraire."
    ],
    "centre": [
      "Le prix Goncourt 2026 a été attribué à Philippe Jaenada pour \"L'Inconnue du quai de Javel\" au restaurant Drouant.",
      "L'ouvrage revient sur l'assassinat en 1949 de Louise Cansot, un modèle des peintres de Montparnasse.",
      "Les articles rappellent l'impact économique considérable de ce prix sur les ventes et les droits d'auteur."
    ],
    "droite": [
      "Philippe Jaenada décroche le Goncourt 2026 par six voix contre trois face à Sylvain Prudhomme.",
      "Le roman récompensé explore une affaire criminelle de l'après-guerre en s'inspirant des méthodes du commissaire Maigret.",
      "Le Figaro et Valeurs actuelles saluent l'enquête littéraire tandis qu'Europe 1 rappelle la bibliographie criminelle de l'auteur."
    ]
  },
  "differences": [
    "La gauche insiste sur la consécration d'un auteur populaire et le mélange des genres entre enquête et autofiction.",
    "Le centre privilégie le récit factuel de la proclamation chez Drouant ainsi que l'analyse des retombées financières et des ventes.",
    "La droite se focalise sur les détails de vote du jury académique et l'inspiration policière du roman liée au commissaire Maigret."
  ],
