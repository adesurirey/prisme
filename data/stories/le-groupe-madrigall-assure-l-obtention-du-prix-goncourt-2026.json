  "summaries": {
    "gauche": [
      "Philippe Jaenada décroche le prix Goncourt 2026 au restaurant Drouant pour son ouvrage \"L'Inconnue du quai de Javel\".",
      "Le texte s'intéresse à un assassinat commis à Paris en 1949.",
      "L'Obs signale en parallèle que le prix Renaudot revient à François-Henri Désérable."
    ],
    "centre": [
      "Le jury du prix Goncourt couronne Philippe Jaenada pour \"L'Inconnue du quai de Javel\" le mardi 3 novembre 2026 chez Drouant.",
      "Le roman revient sur le meurtre irrésolu de Louise Cansot, une jeune Bretonne et modèle parisien de l'après-guerre.",
      "L'auteur s'est inspiré de la méthode du commissaire Maigret pour mener ses investigations dans les archives.",
      "Plusieurs articles soulignent l'impact financier de cette distinction en termes de ventes et d'adaptations."
    ],
    "droite": [
      "Philippe Jaenada obtient le prix Goncourt 2026 avec six voix contre trois pour Sylvain Prudhomme.",
      "L'œuvre primée retrace l'enquête autour de la mort mystérieuse de Louise Cansot survenue en septembre 1949.",
      "L'écrivain s'inscrit dans la lignée de ses précédents récits fleuves consacrés à des faits divers historiques."
    ]
  },
  "differences": [
    "La gauche mentionne le palmarès littéraire global en intégrant l'attribution simultanée du prix Renaudot.",
    "Le centre insiste sur la dimension populaire de l'ouvrage, ses retombées économiques et le travail minutieux d'investigation de l'auteur.",
    "La droite privilégie le détail des votes du jury de l'Académie Goncourt et replace la publication dans la bibliographie criminelle de l'écrivain."
  ],
