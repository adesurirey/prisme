  "summaries": {
    "gauche": [
      "Donald Trump, Xi Jinping et Vladimir Poutine se réuniront pour la première fois la semaine prochaine en Chine.",
      "La rencontre, qui se tiendra en marge de l'Apec à Shenzhen, portera sur la guerre au Moyen-Orient et le désarmement nucléaire.",
      "Les discussions n'aborderont pas le dossier ukrainien selon les précisions de Washington.",
      "Cette réunion historique donnera surtout lieu à une photo symbolique, les experts jugeant les résultats concrets peu probables."
    ],
    "centre": [
      "La Maison-Blanche a officialisé un sommet trilatéral inédit entre Donald Trump, Xi Jinping et Vladimir Poutine prévu jeudi à Shenzhen en Chine.",
      "Ce sommet se déroulera en marge de la réunion de la Coopération économique Asie-Pacifique (Apec).",
      "Les dirigeants aborderont des sujets tels que la réduction des armes nucléaires, la guerre en Iran ou encore des questions technologiques.",
      "Les discussions ne prévoiront pas d'échanges concernant le conflit en Ukraine."
    ],
    "droite": [
      "Donald Trump, Xi Jinping et Vladimir Poutine se retrouveront jeudi en Chine pour un sommet inédit entre les trois grandes puissances nucléaires.",
      "La rencontre est organisée en marge du sommet de l'Apec à Shenzhen.",
      "L'ordre du jour comprendra la guerre au Moyen-Orient, la question du nucléaire et l'intelligence artificielle.",
      "Le dossier ukrainien sera exclu des discussions, ce qui soulage Kiev et les Européens face à un Vladimir Poutine qui poursuit son retour sur la scène internationale après son isolement de 2022."
    ]
  },
  "differences": [
    "La gauche met l'accent sur la portée symbolique et historique de l'événement en qualifiant la rencontre de simple photo de famille aux résultats improbables.",
    "Le centre livre un compte-rendu factuel et institutionnel centré sur l'agenda technique des discussions révélé par Washington en marge de l'Apec.",
    "La droite adopte un ton plus géopolitique en insistant sur le retour progressif de Vladimir Poutine sur la scène internationale et le soulagement ukrainien."
  ],
