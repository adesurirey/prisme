  "summaries": {
    "gauche": [
      "Le Parlement a définitivement adopté la proposition de loi sur la présomption d'usage des armes par les forces de l'ordre, lors d'un vote du Sénat fixant le score à 205 voix pour et 110 contre.",
      "La gauche sénatoriale a annoncé une saisine conjointe du Conseil constitutionnel pour bloquer la promulgation du texte.",
      "Le texte est fermement combattu par la gauche qui qualifie la mesure de « permis de tuer »."
    ],
    "centre": [
      "Le Parlement a adopté définitivement la proposition de loi instaurant une présomption d'usage légitime des armes par la police et la gendarmerie.",
      "Le texte a recueilli 205 voix contre 110 au Sénat, après un vote initial de l'Assemblée nationale en juillet à 313 voix pour et 199 contre.",
      "Cette adoption est le fruit d'un soutien combiné du gouvernement, d'une grande partie du bloc central, de la droite sénatoriale et du Rassemblement national."
    ],
    "droite": [
      "Le Sénat a définitivement adopté par 205 voix contre 110 la proposition de loi du député Éric Pauget instaurant une présomption d'usage légal des armes.",
      "Le texte a bénéficié de l'appui du gouvernement, de la droite majoritaire, des centristes et du Rassemblement national.",
      "La gauche s'oppose à cette législation qu'elle qualifie de « permis de tuer » et a promis de saisir le Conseil constitutionnel."
    ]
  },
  "differences": [
    "La gauche axe son traitement sur la contestation du texte et la dénonciation de ce qu'elle appelle un « permis de tuer », tout en mettant en avant son recours au Conseil constitutionnel.",
    "Le centre privilégie un compte rendu institutionnel factuel en détaillant le parcours législatif, les scores des scrutins et les forces politiques ayant permis l'adoption.",
    "La droite valorise l'aboutissement de la proposition de loi portée par son camp en insistant sur les majorités obtenues et le soutien de l'exécutif."
  ],
