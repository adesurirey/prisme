  "summaries": {
    "gauche": [
      "Le président du Sénat Gérard Larcher a convié les prétendants de la droite et du centre à une réunion rapide pour définir une « méthode de départage ».",
      "L'objectif affiché de cette initiative est d'aboutir à une candidature unique en vue de l'élection présidentielle de 2027.",
      "Le périmètre de cette invitation exclut expressément des personnalités comme Éric Zemmour et Raphaël Glucksmann, d'après l'entourage du sénateur."
    ],
    "centre": [
      "Gérard Larcher a pris l'initiative de convier l'ensemble des candidats de la droite et du centre à une réunion de concertation.",
      "La rencontre a pour but de fixer les modalités d'une « méthode de départage » afin de désigner un représentant unique pour 2027.",
      "Cette démarche intervient alors que la pression s'accroît sur les différents prétendants de l'arc conservateur et centriste."
    ],
    "droite": [
      "Gérard Larcher a adressé une proposition de rassemblement aux différents candidats de la droite et du centre pour organiser un départage.",
      "La réunion doit permettre de s'accorder sur une « méthode de départage » et sur une « communauté de valeurs » d'ici le début de l'année prochaine.",
      "Le projet vise à départager des figures telles que Bruno Retailleau, David Lisnard, Gabriel Attal et Édouard Philippe.",
      "Édouard Philippe, qui figure en bonne position dans les sondages, s'est jusqu'à présent montré réfractaire à l'idée d'une primaire."
    ]
  },
  "differences": [
    "La gauche insiste sur le caractère sélectif et stratégique du périmètre de la réunion en soulignant les exclusions de figures politiques.",
    "Le centre met l'accent sur la démarche unitaire et la volonté de structurer l'offre politique pour 2027 sans mentionner de tensions internes.",
    "La droite se focalise sur les enjeux tactiques du départage et relève explicitement les réticences d'Édouard Philippe face à l'hypothèse d'une primaire."
  ],
