  "summaries": {
    "gauche": [
      "La première édition de l'Eurovision Asie s'est déroulée le samedi 14 novembre à Bangkok et a été remportée par les Philippines grâce à la chanteuse Carmelle et son titre « Sobra-Sobra ».",
      "Le HuffPost souligne que cet événement transpose fidèlement le format européen sur le sol asiatique.",
      "Franceinfo précise que le concours est piloté par des chaînes privées et interdit le vote pour son propre pays."
    ],
    "centre": [
      "Le concours inaugural de l'Eurovision Asie s'est conclu le 14 novembre à Bangkok par la victoire des Philippines.",
      "La jeune artiste Carmelle a triomphé parmi les onze pays en lice avec sa chanson « Sobra-Sobra ».",
      "Ouest-France indique que le classement final combine les votes des téléspectateurs, du jury des onze nations et du public en ligne."
    ],
    "droite": [
      "La première édition de l'Eurovision Song Contest Asia a eu lieu le samedi à Bangkok, en Thaïlande.",
      "La chanteuse philippine Carmelle, âgée de 19 ans, a remporté la victoire face à onze participants au terme d'un spectacle d'envergure."
    ]
  },
