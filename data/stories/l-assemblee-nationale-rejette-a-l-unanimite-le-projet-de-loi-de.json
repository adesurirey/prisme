  "summaries": {
    "gauche": [
      "L'Assemblée nationale a rejeté à l'unanimité la partie recettes du projet de loi de finances 2027 le mercredi 4 novembre 2026.",
      "Le texte gouvernemental a été qualifié de distordu et périmé après trois semaines d'examen dans l'hémicycle.",
      "Le Sénat s'emparera du projet de loi de finances initial à partir du 20 novembre."
    ],
    "centre": [
      "Les 458 votants de l'Assemblée nationale ont rejeté à l'unanimité la partie recettes du projet de loi de finances 2027 en première lecture.",
      "Le texte rejeté comportait de profondes modifications de la copie gouvernementale initiale.",
      "Le Sénat examinera le projet de loi de finances dans sa version initiale dès le mois de novembre."
    ],
    "droite": [
      "L'Assemblée nationale a rejeté unanimement le projet de loi de finances 2027 à l'issue de plus de deux semaines de débats.",
      "Le texte initial du gouvernement va désormais poursuivre sa trajectoire d'examen au Sénat.",
      "Le gouvernement étudie l'éventualité d'un recours au 49.3 ou à des ordonnances en l'absence de compromis."
    ]
  },
  "differences": [
    "La gauche qualifie sévèrement le texte initial de distordu et périmé tout en confirmant le calendrier d'examen sénatorial dès novembre.",
    "Le centre détaille précisément le déroulement du vote unanime des 458 députés et la transmission de la version initiale vers la chambre haute.",
    "La droite met l'accent sur les perspectives institutionnelles à venir au Sénat et évoque l'hypothèse d'un recours gouvernemental au 49.3."
  ],
