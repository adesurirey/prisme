  "summaries": {
    "gauche": [
      "Treize personnes ont été légèrement blessées dans une collision survenue un vendredi matin sur une plateforme de travaux de la SNCF dans l'agglomération de Troyes.",
      "L'accident s'est produit entre un train régional et un poids lourd, impliquant les conducteurs des deux véhicules qui figurent parmi les blessés."
    ],
    "centre": [
      "Une collision entre un train régional et un poids lourd a fait treize blessés légers un vendredi matin sur une zone de travaux de la SNCF près de Troyes.",
      "Les conducteurs du train et du camion ont tous deux été blessés, tandis que la SNCF a confirmé que la rame n'avait pas déraillé et que les victimes avaient été transportées à l'hôpital de Troyes."
    ],
    "droite": [
      "Un TER à destination de Paris-Est et un poids lourd sont entrés en collision à Barberey-Saint-Sulpice, près de Troyes, sur une plateforme de travaux de la SNCF.",
      "Le bilan s'élève à treize blessés légers, incluant le conducteur du train et celui du camion, sans que la rame ne déraille selon la SNCF.",
      "L'événement a provoqué des perturbations sur la ligne vers Paris-Est toute la journée, allant jusqu'à une interruption du trafic jusqu'en soirée selon les précisions du Figaro.",
      "TF1 Info précise que quatre-vingt-dix passagers se trouvaient à bord au moment où le train a heurté la remorque du poids lourd lors d'une manœuvre."
    ]
  },
  "differences": [
