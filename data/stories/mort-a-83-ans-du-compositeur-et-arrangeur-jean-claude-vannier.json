  "summaries": {
    "gauche": [
      "Le musicien et arrangeur Jean-Claude Vannier est mort jeudi 26 novembre à l'âge de 83 ans.",
      "Il laisse l'image d'un artiste à la carrière riche, indissociable de Serge Gainsbourg et de l'album culte \"Histoire de Melody Nelson\".",
      "Il avait également évoqué au journal \"L'Obs\" la genèse de cette œuvre mythique."
    ],
    "centre": [
      "Le compositeur et arrangeur Jean-Claude Vannier est décédé à Paris à l'âge de 83 ans.",
      "Il s'était fait connaître pour ses collaborations majeures avec Serge Gainsbourg, notamment sur l'album \"L'Histoire de Melody Nelson\".",
      "Il avait également façonné les univers musicaux d'autres artistes de la scène française tels que Johnny Hallyday, Barbara ou Julien Clerc."
    ],
    "droite": [
      "Le compositeur et arrangeur Jean-Claude Vannier est mort à l'âge de 83 ans.",
      "Sa fille Virginie Vannier a salué dans un message transmis à l'AFP un artiste \"singulier, inclassable, profondément indépendant\".",
      "Souvent méconnu du grand public, il a collaboré avec de nombreuses figures de la chanson française comme Jane Birkin, Barbara ou Johnny Hallyday."
    ]
  },
  "differences": [
    "La gauche met l'accent sur son rôle d'arrangeur historique et de complice de Serge Gainsbourg, en rappelant des entretiens passés.",
    "Le centre dresse le portrait large d'un arrangeur de génie dont la notoriété dépasse le cadre de sa collaboration avec Gainsbourg en citant d'autres artistes majeurs.",
    "La droite insiste sur son statut d'homme de l'ombre au talent inclassable et cite le communiqué transmis par sa fille à l'AFP."
  ],
