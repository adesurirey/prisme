  "summaries": {
    "gauche": [
      "Le compositeur et arrangeur Jean-Claude Vannier est décédé à l'âge de 83 ans.",
      "Il est particulièrement reconnu pour son travail historique sur l'album « L'Histoire de Melody Nelson » de Serge Gainsbourg."
    ],
    "centre": [
      "Le compositeur et arrangeur Jean-Claude Vannier est mort à Paris à l'âge de 83 ans.",
      "Il a collaboré avec de nombreuses figures de la chanson française, dont Johnny Hallyday, Barbara et Serge Gainsbourg.",
      "Son œuvre reste indissociable de l'album-concept « L'Histoire de Melody Nelson »."
    ],
    "droite": [
      "Le compositeur Jean-Claude Vannier est décédé à Paris à l'âge de 83 ans.",
      "Il a façonné les univers sonores de plusieurs artistes de la scène française, notamment Serge Gainsbourg, Barbara et Michel Polnareff.",
      "Il a composé les arrangements pour cordes et chœurs et orchestré la musique de l'album culte « L'Histoire de Melody Nelson »."
    ]
  },
  "differences": [
    "La gauche met l'accent sur sa contribution historique auprès de Serge Gainsbourg.",
    "Le centre dresse un portrait large de ses collaborations avec les grandes figures de la chanson française tout en soulignant son rôle sur l'album de Serge Gainsbourg.",
    "La droite souligne la dimension technique de son travail en insistant sur ses arrangements pour cordes et chœurs ainsi que ses orchestrations."
  ],
