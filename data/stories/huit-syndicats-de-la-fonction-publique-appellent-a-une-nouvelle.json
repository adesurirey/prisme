  "summaries": {
    "gauche": [
      "Huit organisations syndicales appellent à une nouvelle journée de grève et de mobilisation dans la fonction publique le 1er décembre 2026.",
      "Le mouvement fait suite aux actions du 17 novembre et fait suite à une rencontre avec Sébastien Lecornu.",
      "L'intersyndicale dénonce la « gravité » de la situation salariale des agents et exige des augmentations de rémunération."
    ],
    "centre": [
      "Une intersyndicale de la fonction publique a publié un communiqué vendredi pour annoncer une grève le 1er décembre.",
      "Ce nouvel appel intervient quelques jours après une réunion des syndicats avec Sébastien Lecornu.",
      "Les agents publics sont invités à se mobiliser partout en France pour réclamer des hausses de salaires."
    ],
    "droite": [
      "Huit syndicats de la fonction publique appellent à une journée de grève nationale le 1er décembre.",
      "Les organisations syndicales soulignent la dégradation de la situation salariale des agents publics dans un communiqué commun.",
      "Le mouvement vise à réclamer des hausses de rémunération à travers des rassemblements et des grèves sur l'ensemble du territoire."
    ]
  },
  "differences": [
    "La gauche insiste sur le rapport de force social en qualifiant la situation salariale de grave et en s'inscrivant dans la continuité des actions précédentes.",
    "Le centre adopte un ton factuel en liant directement le nouvel appel à la grève avec la récente rencontre des syndicats auprès de Sébastien Lecornu.",
    "La droite se concentre sur l'appel national intersyndical en mettant en avant la dégradation des conditions financières des agents publics sans commentaire politique superflu."
  ],
