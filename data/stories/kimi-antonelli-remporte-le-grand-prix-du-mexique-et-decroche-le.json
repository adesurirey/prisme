  "summaries": {
    "gauche": [
      "L'Italien Kimi Antonelli, âgé de 20 ans et 68 jours, est sacré champion du monde de Formule 1 à l'issue du Grand Prix du Mexique.",
      "Le pilote Mercedes décroche le titre mondial en terminant sur le podium d'une course remportée par Max Verstappen sur Red Bull.",
      "Le quotidien Le Monde souligne que ce succès couronne le pari audacieux de la filière de formation des Flèches d'argent."
    ],
    "centre": [
      "Max Verstappen s'impose lors du Grand Prix du Mexique devant Lewis Hamilton et Kimi Antonelli.",
      "Kimi Antonelli s'assure la troisième place de la course et devient le plus jeune champion du monde de l'histoire de la discipline.",
      "L'écurie Mercedes conserve la tête du classement du championnat du monde des constructeurs."
    ],
    "droite": [
      "Max Verstappen remporte la dix-neuvième manche de la saison au Mexique au volant de sa Red Bull après un drapeau rouge.",
      "Kimi Antonelli valide son sacre mondial en s'emparant de la troisième place derrière Lewis Hamilton.",
      "Le jeune pilote italien entre dans l'histoire en devenant, à 20 ans, le plus jeune champion du monde et le troisième Italien titré après Giuseppe Farina et Alberto Ascari."
    ]
  },
