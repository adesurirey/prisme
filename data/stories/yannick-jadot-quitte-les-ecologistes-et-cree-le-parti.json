  "summaries": {
    "gauche": [
      "Yannick Jadot et Jérémie Iordanoff ont fondé le parti Écologistes et démocrates avec trois autres transfuges.",
      "La scission fait suite au désaccord avec Marine Tondelier concernant sa volonté de se rapprocher de Jean-Luc Mélenchon pour l'élection présidentielle de 2027."
    ],
    "centre": [
      "Yannick Jadot a officialisé la création de sa formation politique, baptisée Écologistes et démocrates.",
      "Le sénateur de Paris s'associe à Raphaël Glucksmann en vue de la présidentielle."
    ],
    "droite": [
      "Yannick Jadot et Jérémie Iordanoff quittent Les Écologistes pour lancer un mouvement ancré au centre-gauche.",
      "Le nouveau parti se veut proeuropéen, social et prêt à gouverner en rupture avec toute alliance mélenchoniste."
    ]
  },
  "differences": [
    "La gauche insiste sur les tensions internes au parti d'origine et liste précisément les cinq membres fondateurs de la scission.",
    "Le centre met en avant la démarche personnelle de Yannick Jadot et son positionnement aux côtés de Raphaël Glucksmann.",
    "La droite qualifie directement le nouveau mouvement de centre-gauche et souligne sa volonté de constituer une alternative crédible au rassemblement avec La France insoumise."
  ],
