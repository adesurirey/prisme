  "summaries": {
    "gauche": [
      "Donald Trump et Mark Rutte ont tenu une rencontre à Mar-a-Lago pour aborder les dossiers ukrainien et iranien.",
      "La Maison-Blanche a souligné l'urgence d'obtenir une résolution pacifique du conflit ukrainien."
    ],
    "centre": [
      "Donald Trump et le secrétaire général de l'Otan, Mark Rutte, ont publié une déclaration conjointe depuis la Floride.",
      "Les deux dirigeants exhortent Moscou à éviter toute action susceptible d'étendre la guerre en Ukraine, de manière volontaire ou involontaire."
    ],
    "droite": [
      "Le président américain et le chef de l'Otan se sont réunis mercredi en Floride.",
      "Ils ont conjointement appelé la Russie à ne pas élargir le conflit avec Kiev tout en plaidant pour un règlement pacifique rapide."
    ]
  },
  "differences": [
    "La gauche met en avant le contexte diplomatique élargi de la visite, en mentionnant l'Iran et le cadre précis de la résidence de Mar-a-Lago.",
    "Le centre livre un compte rendu institutionnel centré sur la déclaration conjointe et les termes précis de la mise en garde de la Maison-Blanche.",
    "La droite propose une synthèse ramassée sur l'appel à la retenue adressé à Moscou et la perspective d'une résolution rapide du conflit."
  ],
