  "summaries": {
    "gauche": [
      "Donald Trump nomme Stephen Miller directeur de cabinet de la Maison-Blanche au lendemain de la défaite des républicains aux élections de mi-mandat.",
      "Les médias de gauche qualifient Stephen Miller de suprémaciste blanc, d'idéologue réactionnaire et d'architecte de la politique anti-immigration agressive.",
      "Cette nomination est analysée comme une fuite en avant radicale et un signal d'affrontement face aux démocrates qui ont promis de le combattre."
    ],
    "centre": [
      "Donald Trump nomme son conseiller Stephen Miller au poste stratégique de directeur de cabinet de la Maison-Blanche pour remplacer Susie Wiles.",
      "La presse qualifie Stephen Miller de figure de la droite identitaire et d'artisan de la ligne dure sur l'immigration au sein de l'exécutif américain.",
      "Cette décision intervient après les élections de mi-mandat marquées par des pertes pour le camp républicain au Congrès."
    ],
    "droite": [
      "Le président américain Donald Trump nomme Stephen Miller pour remplacer Susie Wiles au poste de directeur de cabinet de la Maison-Blanche.",
      "L'annonce de ce changement au sein de l'exécutif a été relayée par le président américain directement sur son réseau Truth Social."
    ]
  },
  "differences": [
    "La gauche adopte un ton résolument critique et alarmiste en qualifiant le nouveau directeur de cabinet de suprémaciste blanc et d'ultra-radical, insistant sur le contexte de défaite électorale pour y voir une fuite en avant.",
    "Le centre livre un portrait factuel et nuancé de Stephen Miller en le présentant comme le fidèle conseiller de Donald Trump et la figure de la droite identitaire associée à la politique migratoire.",
    "La droite se limite à une couverture sobre et institutionnelle de la nomination, en reprenant l'annonce officielle sans commentaire idéologique."
  ],
