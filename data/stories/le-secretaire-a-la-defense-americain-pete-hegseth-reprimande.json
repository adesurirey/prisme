  "summaries": {
    "gauche": [
      "Le ministre américain de la Défense Pete Hegseth a été pris à partie par un garde au cimetière national d'Arlington.",
      "L'incident s'est produit lors de la journée des anciens combattants, alors que le secrétaire et ses proches se montraient bruyants.",
      "Le militaire de service a ordonné au groupe de cesser de rire et de discuter près de la tombe du Soldat inconnu."
    ],
    "centre": [
      "Pete Hegseth a été vertement réprimandé par un soldat de l'armée américaine le 11 novembre.",
      "Le ministre de la Défense et ses accompagnants prenaient des photos et discutaient bruyamment.",
      "Le garde en poste leur a rappelé l'exigence de silence et de respect dans ce lieu de recueillement mémoriel."
    ],
    "droite": [
      "Pete Hegseth a été recadré par un garde près de la tombe du Soldat inconnu aux États-Unis.",
      "Une vidéo montre le ministre et plusieurs personnes en train de prendre des photos après une cérémonie avec Donald Trump.",
      "Le militaire a rappelé que tous les visiteurs doivent maintenir une atmosphère de silence."
    ]
  },
  "differences": [
    "La gauche insiste sur la verdeur de l'altercation en employant le verbe hurler pour souligner la faute de comportement de Pete Hegseth.",
    "Le centre livre un récit factuel et détaillé de la scène en insistant sur le manquement au devoir de réserve lors de la journée des anciens combattants.",
    "La droite met en avant le contexte institutionnel en associant l'épisode à la cérémonie du président Donald Trump tout en reprenant les termes exacts du rappel à l'ordre."
  ],
