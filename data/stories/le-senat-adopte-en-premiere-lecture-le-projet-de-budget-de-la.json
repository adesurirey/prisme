  "summaries": {
    "gauche": [
      "Le Sénat a adopté le projet de loi de financement de la Sécurité sociale pour 2027 par 201 voix contre 124.",
      "Le texte voté par la chambre haute prévoit notamment le rétablissement de la réforme des retraites de 2023 suspendue l'an dernier.",
      "Une commission mixte paritaire se réunira la semaine prochaine pour tenter d'aboutir à un accord avec l'Assemblée nationale."
    ],
    "centre": [
      "Le projet de budget de la Sécurité sociale pour 2027 a été adopté en première lecture au Sénat ce mercredi 18 novembre.",
      "Les sénateurs ont modifié le texte initial du gouvernement, notamment sur les retraites, les allégements pour les entreprises et le niveau du déficit.",
      "La commission mixte paritaire s'annonce décisive pour rapprocher les positions de l'Assemblée nationale et du Sénat."
    ],
    "droite": [
      "Le Sénat a adopté le projet de budget de la Sécurité sociale pour 2027 lors d'un vote solennel à l'issue de la première lecture.",
      "La chambre haute a modifié plusieurs mesures phares du texte initial, en particulier concernant les retraites.",
      "Le texte retourne à l'Assemblée nationale et le suspense demeure entier sur l'issue des débats budgétaires au Parlement."
    ]
  },
  "differences": [
    "La gauche qualifie le texte voté par le Sénat de « jeu de massacre pour les assurés » en insistant sur le retour de la réforme des retraites.",
    "Le centre adopte une approche strictement factuelle en listant les modifications apportées par le Sénat sur le déficit et les entreprises sans qualificatif dramatique.",
    "La droite insiste sur le parcours parlementaire et l'incertitude de la navette tout en soulignant l'adoption solennelle du texte par la chambre haute."
  ],
