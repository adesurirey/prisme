  "summaries": {
    "gauche": [
      "La Russie fait état d'une interception de 1 198 drones ukrainiens durant la nuit de jeudi à vendredi.",
      "Quatre décès sont recensés dans la région de Volgograd à la suite de cette offensive.",
      "Cette opération aérienne est qualifiée par franceinfo parmi les plus massives sur le sol russe depuis le début du conflit."
    ],
    "centre": [
      "Moscou revendique l'interception de près de 1 200 à 2 000 drones ukrainiens selon les titres lors d'une vaste frappe nocturne.",
      "Cette offensive inédite depuis février 2022 cause la mort de quatre personnes en territoire russe.",
      "Ces frappes surviennent alors que des pourparlers diplomatiques se déroulent entre des émissaires américains, Vladimir Poutine et Volodymyr Zelensky."
    ],
    "droite": [
      "Le Figaro rapporte l'interception de 1 198 drones ukrainiens par Moscou lors d'un raid nocturne meurtrier faisant quatre victimes.",
      "L'événement coïncide avec la visite à Moscou des émissaires américains Steve Witkoff et Jared Kushner et leurs entretiens ultérieurs avec Volodymyr Zelensky à Dublin."
    ]
  },
