  "summaries": {
    "gauche": [
      "Brenda Patea a déposé une plainte au tribunal de Berlin contre le joueur de tennis Alexander Zverev.",
      "L'ancienne compagne du sportif lui reproche d'avoir qualifié d'« innocenté » l'accord amiable conclu en 2024 pour clore une procédure de coups et blessures."
    ],
    "centre": [
      "Une nouvelle plainte vise Alexander Zverev, engagé au Masters ATP de Turin, de la part de son ex-compagne Brenda Patea.",
      "La plaignante conteste la version publique donnée par le numéro un mondial concernant l'issue de leur litige judiciaire de 2024.",
      "Les avocats de la plaignante estiment que le joueur a fourni une « présentation inexacte » de cet accord amiable."
    ],
    "droite": [
      "Le joueur de tennis Alexander Zverev fait l'objet d'une nouvelle action en justice intentée par son ancienne conjointe à Berlin.",
      "La plainte fait suite aux déclarations tenues par le sportif dans la presse au sujet d'un précédent règlement amiable pour violences.",
      "L'ex-compagne du joueur exige une indemnisation financière ainsi qu'un engagement à cesser ces propos jugés inexacts."
    ]
  },
  "differences": [
    "La gauche met l'accent sur le désaccord fondamental concernant la notion d'« innocenté » revendiquée par le joueur.",
    "Le centre détaille le contexte sportif au Masters de Turin tout en exposant le contenu juridique de la contestation de l'accord amiable.",
    "La droite insiste sur les suites concrètes de la plainte en précisant les demandes de la plaignante en matière d'indemnisation et de déclarations."
  ],
