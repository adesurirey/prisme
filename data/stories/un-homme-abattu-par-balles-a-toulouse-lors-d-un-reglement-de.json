  "summaries": {
    "gauche": [
      "Un homme d'environ 30 ans a été tué par balles dans la nuit de mardi à mercredi à Toulouse.",
      "Le drame s'est produit sur un point de deal du quartier du Mirail, spécifiquement à la Reynerie.",
      "Le procureur fait état de six narchomicides depuis le début de l'année, liés à une guerre de territoire entre bandes rivales.",
      "Il s'agit du deuxième règlement de comptes mortel en l'espace de trois jours dans la ville."
    ],
    "centre": [
      "Un homme âgé d'une trentaine d'années a été abattu par balles dans la nuit à Toulouse.",
      "Les faits se sont déroulés sur un point de deal du quartier du Mirail, constituant le deuxième règlement de comptes mortel en trois jours.",
      "Le parquet confirme qu'il s'agit du sixième narchomicide recensé depuis janvier dans la commune.",
      "Une enquête a été ouverte par le procureur de la République, qui privilégie la piste du narchomicide."
    ],
    "droite": [
      "Un homme d'environ 30 ans a été tué par balles vers 02h50 sur un point de deal du quartier de la Reynerie.",
      "D'après les premiers éléments, les agresseurs sont un ou deux individus arrivés en trottinette, l'un d'eux ayant tiré avec une arme de poing de calibre 9 mm.",
      "Le procureur de la République David Charmatz qualifie cet acte de sixième narchomicide de l'année dans les quartiers toulousains.",
      "Ce drame fait suite à un autre meurtre commis dans la nuit de samedi à dimanche sur le parking d'un bowling."
    ]
