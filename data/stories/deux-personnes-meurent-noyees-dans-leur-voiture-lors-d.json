  "summaries": {
    "gauche": [
      "Deux personnes ont péri noyées dans leur automobile en Corse-du-Sud après avoir été surprises par des inondations.",
      "Un troisième passager présent dans le véhicule a pu être sauvé et transporté à l'hôpital.",
      "L'épisode pluvieux intense a conduit les autorités à placer les deux départements corses en vigilance orange."
    ],
    "centre": [
      "Un véhicule transportant plusieurs personnes a été emporté par les flots sur la route menant de Bonifacio à Porto-Vecchio.",
      "Le drame s'est produit aux alentours d'une heure du matin lors d'un violent orage lié à un épisode méditerranéen.",
      "L'accumulation des précipitations a atteint l'équivalent de deux mois de pluie en l'espace de 48 heures."
    ],
    "droite": [
      "Deux victimes ont été retrouvées sans vie à l'intérieur de leur voiture submergée sur la route territoriale 10.",
      "Les occupants venaient de l'aéroport de Figari au moment où les intempéries ont frappé le sud de l'île.",
      "Les sapeurs-pompiers ont pu extraire un survivant qui a été évacué vers une structure médicale."
    ]
  },
  "differences": [
    "La gauche insiste en premier lieu sur le contexte général des alertes météorologiques de niveau orange et sur l'impact humain des inondations.",
    "Le centre met principalement en avant les volumes exceptionnels de précipitations et les aspects factuels du drame routier nocturne.",
    "La droite détaille précisément l'itinéraire des victimes entre l'aéroport et le lieu de l'accident ainsi que les conditions de l'intervention des secours."
  ],
