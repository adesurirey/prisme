  "summaries": {
    "gauche": [
      "L'Espagnol Pablo Hernandez de Cos succédera à Christine Lagarde à la présidence de la Banque centrale européenne.",
      "L'économiste de 55 ans est l'ancien président de la Banque d'Espagne.",
      "Il dirigeait jusqu'à présent la Banque des règlements internationaux située en Suisse."
    ],
    "centre": [
      "Pablo Hernández de Cos a été choisi pour remplacer Christine Lagarde à la tête de la Banque centrale européenne début février 2027.",
      "Cette nomination à la présidence de l'institution financière bénéficie du soutien conjoint de Paris et de Berlin.",
      "Le futur dirigeant, actuel directeur de la Banque des règlements internationaux, a été préféré au Néerlandais Klaas Knot selon des sources diplomatiques européennes."
    ],
    "droite": [
      "Pablo Hernandez de Cos va prendre la tête de la Banque centrale européenne en succession de Christine Lagarde.",
      "Le directeur de la Banque des règlements internationaux à Bâle était en concurrence avec le Néerlandais Klaas Knot pour ce poste stratégique.",
      "Son entrée en fonction interviendra au moment de la campagne présidentielle française, marquée par la présence de candidats eurosceptiques et souverainistes ainsi que par des tensions sur le marché obligataire."
    ]
  },
  "differences": [
    "La gauche se concentre strictement sur le parcours professionnel de l'économiste et son âge.",
    "Le centre détaille le calendrier de la nomination, le soutien franco-allemand et le choix face au candidat néerlandais.",
    "La droite et le centre droit mettent en perspective la nomination avec le contexte politique français et les tensions économiques."
  ],
