  "summaries": {
    "gauche": [
      "Le Monde rappelle que la réglementation invalidée limitait les visas étudiants à quatre ans et ceux des journalistes à environ huit mois."
    ],
    "centre": [
      "Un juge fédéral américain a invalidé lundi la réglementation de l'administration Trump limitant la durée de séjour des étudiants et journalistes étrangers.",
      "Le tribunal fédéral a jugé cette mesure « arbitraire ».",
      "Le gouvernement américain a immédiatement interjeté appel de cette décision."
    ],
    "droite": [
      "Le juge fédéral de Boston a rendu sa décision lundi en annulant la réglementation publiée en juillet au Federal Register."
    ]
  },
  "differences": [
    "La gauche met en avant le détail concret des restrictions initiales imposées par l'administration Trump en juillet 2026.",
    "Le centre livre un compte rendu factuel et synthétique de la décision judiciaire tout en mentionnant immédiatement l'appel formé par l'exécutif.",
    "La droite focalise son analyse sur l'origine géographique et institutionnelle de la décision en précisant le rôle du tribunal fédéral de Boston."
  ],
