  "summaries": {
    "gauche": [
      "Le tribunal a rendu son verdict contre Huawei après une longue procédure judiciaire de huit ans.",
      "La justice américaine reproche au leader technologique chinois d'avoir débauché du personnel de firmes télécoms locales.",
      "Des données technologiques confidentielles ont été indûment récupérées par ce biais."
    ],
    "centre": [
      "Un jury fédéral de New York a statué sur la culpabilité de Huawei pour fraude bancaire et vol industriel.",
      "La firme chinoise était poursuivie pour avoir cherché à embaucher des collaborateurs de sociétés de télécommunications aux États-Unis.",
      "Cette démarche a permis au groupe d'acquérir des renseignements technologiques protégés."
    ],
    "droite": [
      "Le géant technologique chinois subit une condamnation pénale majeure aux États-Unis portant sur dix chefs d'accusation.",
      "Le procès met en cause les opérations menées par l'entreprise en Iran.",
      "Les infractions incluent également l'appropriation illicite de secrets commerciaux appartenant à des compagnies américaines."
    ]
  },
  "differences": [
    "Le camp gauche insiste sur la durée de la procédure judiciaire et la méthode de recrutement ciblée.",
    "Le camp centre met en avant la décision d'un jury fédéral new-yorkais et associe explicitement le vol industriel à la fraude bancaire.",
    "Le camp droite élargit l'angle vers un vaste procès pénal incluant les activités en Iran et le décompte précis des dix chefs d'accusation."
  ],
