  "summaries": {
    "gauche": [
      "Le tribunal new-yorkais a déclaré Huawei coupable de vol de secrets industriels et d'aide à la censure en Iran à l'issue d'une procédure de huit ans.",
      "Libération relève que Huawei a vivement contesté cette décision de justice mardi 24 novembre.",
      "Le Monde précise que l'entreprise tentait d'obtenir des informations technologiques en recrutant des salariés d'entreprises américaines."
    ],
    "centre": [
      "Un jury fédéral à New York a reconnu Huawei coupable de fraude bancaire, de vol de secrets industriels et d'aide à la censure après onze semaines de procès.",
      "Le groupe chinois est accusé d'avoir approché des salariés d'entreprises américaines pour s'emparer de leurs technologies.",
      "Courrier international signale que le chef d'accusation d'association de malfaiteurs a été écarté par les jurés.",
      "Huawei a rejeté le verdict en qualifiant les accusations américaines de dénuées de fondement."
    ],
    "droite": [
      "Le Figaro rapporte que Huawei a été condamné à l'issue d'un vaste procès pénal pour dix chefs d'accusation criminels.",
      "Ces condamnations concernent l'activité de l'entreprise en Iran ainsi que le vol de secrets commerciaux appartenant à des sociétés américaines."
    ]
  },
  "differences": [
    "La gauche insiste sur la durée de la procédure judiciaire et sur le volet de l'aide à la censure en Iran.",
    "Le centre dresse un panorama complet des chefs d'accusation tout en détaillant le mode opératoire de recrutement des salariés américains.",
    "La droite privilégie une approche pénale en insistant sur le nombre de chefs d'accusation criminels retenus contre l'entreprise chinoise."
  ],
