  "summaries": {
    "gauche": [
      "Le pays de Galles a battu la Nouvelle-Zélande 35 à 28 à Cardiff lors de la cinquième journée du championnat des nations.",
      "Le XV du Poireau a signé un exploit historique en s'imposant face aux All Blacks pour la première fois depuis 1953, soit une disette de 73 ans.",
      "La victoire gallois s'est appuyée sur cinq essais inscrits et une défense acharnée en fin de rencontre, au lendemain du succès des Bleus contre l'Afrique du Sud."
    ],
    "centre": [
      "Le pays de Galles a défait la Nouvelle-Zélande sur le score de 35 à 28 à Cardiff pour le compte de la cinquième journée du Championnat des nations.",
      "Le XV du Poireau a mis fin à une série de 73 ans sans victoire contre les All Blacks, s'imposant pour la première fois depuis 1953.",
      "Cette performance historique a été construite grâce à cinq essais marqués et une défense solide dans les derniers instants du match."
    ],
    "droite": [
      "Le pays de Galles l'a emporté face à la Nouvelle-Zélande sur un score de 35-28 lors de la cinquième journée du Championnat des nations à Cardiff.",
      "Les Gallois ont battu les All Blacks pour la première fois depuis 73 ans, signant leur premier succès face à cet adversaire depuis 1953.",
      "Europe 1 précise que cette victoire s'appuie sur cinq essais et une défense acharnée dans la dernière demi-heure, intervenant après une série difficile de 24 défaites en 26 matches entre le Mondial-2023 et la fin du Tournoi des six nations 2026."
    ]
  },
