  "summaries": {
    "gauche": [
      "Le vice-président de l'université de Versailles-Saint-Quentin-en-Yvelines a été agressé à l'arme blanche dans son bureau",
      "Le pronostic vital de la victime n'est pas engagé",
      "L'attaque intervient dans un contexte de mobilisations étudiantes perturbant le fonctionnement de l'établissement",
      "L'agression s'est produite vendredi peu avant vingt heures"
    ],
    "centre": [
      "Le vice-président de l'université de Versailles-Saint-Quentin-en-Yvelines a été blessé à l'arme blanche dans son bureau",
      "Le ministre de l'Enseignement supérieur Philippe Baptiste a condamné un acte d'une extrême gravité",
      "La victime a été touchée à la tête et à la main, mais ses jours ne sont pas en danger",
      "Le ministre a exprimé son soutien aux proches et aux collègues de la victime"
    ],
    "droite": [
      "Un responsable d'université en Île-de-France a été violemment agressé à l'arme blanche dans son bureau vendredi soir",
      "Le ministre de l'Enseignement supérieur Philippe Baptiste a réagi sur le réseau social X pour exprimer son soutien",
      "Le ministre n'a fourni aucune précision sur les circonstances des faits ni sur les auteurs selon Le Figaro"
    ]
  },
