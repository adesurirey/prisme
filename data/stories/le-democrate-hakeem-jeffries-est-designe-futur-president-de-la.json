  "summaries": {
    "gauche": [
      "Le député de New York Hakeem Jeffries a été désigné par les élus démocrates pour prendre la tête de la Chambre des représentants en janvier 2027.",
      "À 56 ans, il est en passe de devenir le premier président afro-américain de la chambre basse du Congrès.",
      "Libération qualifie l'élu new-yorkais de chef par défaut de la majorité, soulignant son ascension sans concurrence.",
      "L'Obs et Libération indiquent que cette désignation suscite des réticences au sein de l'aile gauche du parti."
    ],
    "centre": [
      "Les députés démocrates ont désigné Hakeem Jeffries comme chef de leur prochaine majorité à la Chambre des représentants.",
      "Il est en passe de devenir en janvier le premier président afro-américain de cette chambre.",
      "Le Monde précise que l'élu new-yorkais de 56 ans s'impose malgré les critiques internes dénonçant son manque de vigueur face à Donald Trump et ses positions pro-israéliennes.",
      "Le vote formel pour élire le speaker se tiendra le 3 janvier 2027."
    ],
    "droite": [
      "L'actuel chef de la minorité démocrate Hakeem Jeffries est en passe de devenir le premier président noir de la Chambre des représentants américaine.",
      "Le Figaro note qu'à 56 ans, il n'avait aucun rival déclaré pour ce poste.",
      "Le quotidien souligne toutefois que l'aile gauche du parti critique ses positions pro-israéliennes et une opposition jugée trop timide à Donald Trump."
    ]
  },
  "differences": [
    "La gauche met l'accent sur l'absence de concurrence et les divisions internes, qualifiant le dirigeant de chef par défaut.",
    "Le centre insiste sur la portée historique de cette première nomination d'un Afro-Américain tout en mentionnant les critiques sur son positionnement.",
    "La droite pointe le caractère consensuel de la désignation en raison de l'absence de rivaux, tout en soulignant les contestations au sein de son propre camp."
  ],
