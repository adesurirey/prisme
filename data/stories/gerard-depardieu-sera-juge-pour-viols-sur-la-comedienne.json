  "summaries": {
    "gauche": [
      "La cour d'appel de Paris a validé le renvoi de Gérard Depardieu devant la cour criminelle pour les accusations de la comédienne Charlotte Arnould.",
      "L'ordonnance de mise en accusation, contestée par l'acteur, concerne des faits présumés datant du 7 août 2018, la plaignante ayant alors 22 ans.",
      "Un non-lieu a été prononcé concernant les agressions dénoncées pour la date du 13 août 2018."
    ],
    "centre": [
      "La cour d'appel de Paris a confirmé le renvoi de l'acteur Gérard Depardieu en procès pour des chefs de viol et d'agression sexuelle sur Charlotte Arnould.",
      "La décision valide uniquement les faits du 7 août 2018 tandis qu'un non-lieu est prononcé pour ceux du 13 août 2018.",
      "La défense de l'artiste âgé de 77 ans indique examiner la possibilité d'un pourvoi en cassation.",
      "Les conseils de la plaignante saluent une décision satisfaisante et une victoire pour la comédienne."
    ],
    "droite": [
      "La cour d'appel de Paris a confirmé la mise en accusation de l'acteur Gérard Depardieu pour une partie des faits dénoncés par Charlotte Arnould.",
      "Le comédien sera jugé par la cour criminelle départementale pour les agressions du 7 août 2018, après cinq années d'investigations.",
      "La justice a prononcé un non-lieu en faveur de l'acteur concernant les accusations du 13 août 2018."
    ]
  },
  "differences": [
    "La gauche insiste sur l'âge de la plaignante au moment des faits et contextualise le parcours procédural de l'affaire.",
    "Le centre détaille les réactions juridiques des conseils de la défense et de la partie civile tout en chiffrant l'âge de l'acteur.",
    "La droite privilégie un compte-rendu strictement procédural en insistant sur la durée de l'instruction et le détail des chefs d'inculpation retenus."
  ],
