  "summaries": {
    "gauche": [
      "Une centaine de personnes ont défilé à Cergy derrière le portrait de Pengo Bossio Wangi.",
      "Le cortège a marché sous la pluie pour dire « stop à la haine et au racisme » à la mémoire de la victime de l'attentat de Trappes.",
      "Un oncle de Pengo Bossio Wangi a dénoncé un climat où certains peinent à prouver qu'ils sont français et ont désormais peur de sortir."
    ],
    "centre": [
      "Près d'une centaine de personnes se sont réunies à Cergy pour une marche blanche.",
      "L'hommage était rendu à Pengo Bossio Wangi, tué lors de l'attaque raciste du 23 octobre à Trappes.",
      "L'événement s'est déroulé dans le Val-d'Oise ce dimanche."
    ],
    "droite": [
      "Une branche de la famille a organisé une marche blanche dans le Val-d'Oise pour honorer la mémoire de Pengo Bossio Wangi.",
      "Le cortège a rassemblé une centaine de personnes à Cergy sous la pluie.",
      "Les participants ont marché pour dénoncer le racisme suite au meurtre commis par Kévin Tessier le 23 octobre."
    ]
  },
  "differences": [
    "La gauche met particulièrement en avant la parole de la famille sur la peur quotidienne et la lutte contre le racisme.",
    "Le centre livre un compte-rendu factuel et synthétique de la mobilisation dominicale à Cergy.",
    "La droite nomme explicitement l'auteur des faits, Kévin Tessier, tout en rapportant les déclarations des proches sur le climat de peur."
  ],
