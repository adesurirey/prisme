  "summaries": {
    "gauche": [
      "Une mère de famille est décédée à l'hôpital des suites de graves brûlures infligées par son compagnon à Saint-Denis-de-Pile, près de Bordeaux.",
      "Le suspect est mort dans l'incendie de la chambre où il s'était enfermé avec la victime, selon les informations rapportées par les rédactions.",
      "Le parquet de Libourne a requalifié la procédure en homicide par conjoint après le décès survenu dans la nuit.",
      "L'Humanité contextualise le drame en rappelant le nombre total de féminicides recensés en France pour l'année 2025 et par le collectif Nous toutes en 2026."
    ],
    "centre": [
      "Une mère de trois enfants est décédée après avoir été gravement brûlée par son conjoint à Saint-Denis-de-Pile, en Gironde.",
      "L'alerte a été donnée par l'un des enfants du couple après que l'homme a mis le feu à la pièce où ils se trouvaient.",
      "La victime avait appelé la gendarmerie en octobre pour des violences dans un contexte de séparation, sans toutefois déposer plainte.",
      "Le parquet a requalifié l'enquête en homicide par conjoint à la suite du décès de la victime."
    ],
    "droite": [
      "Une femme a succombé à ses blessures après avoir été grièvement brûlée par son conjoint à Saint-Denis-de-Pile, près de Bordeaux.",
      "L'homme est mort dans l'incendie du domicile tandis que la victime avait été évacuée en urgence au centre hospitalier de Bordeaux.",
      "Le couple était engagé dans une démarche de séparation au moment des faits."
    ]
  },
