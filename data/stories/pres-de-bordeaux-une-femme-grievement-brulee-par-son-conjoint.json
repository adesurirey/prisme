  "summaries": {
    "gauche": [
      "Une mère de famille a succombé à ses blessures après avoir été brûlée par son conjoint à Saint-Denis-de-Pile.",
      "Le parquet a requalifié la procédure initiale en homicide par conjoint à la suite du décès.",
      "L'Humanité replace le drame dans le contexte national des féminicides en recensant les données ministérielles et associatives."
    ],
    "centre": [
      "Une habitante de Saint-Denis-de-Pile est morte à l'hôpital après avoir été grièvement brûlée par son compagnon.",
      "L'auteur des faits est décédé dans l'incendie du domicile familial déclenché mardi dernier.",
      "L'alerte avait été initialement donnée par l'un des enfants du couple."
    ],
    "droite": [
      "La victime a succombé à ses brûlures au centre hospitalier de Bordeaux, entraînant une requalification de l'enquête en homicide.",
      "Le conjoint s'était enfermé dans la chambre avec elle avant de mettre le feu au domicile.",
      "TF1 Info précise que la victime avait sollicité la gendarmerie fin octobre dans un contexte de séparation."
    ]
  },
  "differences": [
    "La gauche contextualise le drame par un rappel statistique sur les féminicides en France.",
    "Le centre livre un récit factuel et centré sur l'intervention des secours et des enfants.",
    "La droite met en avant le contexte relationnel du couple et les antécédents d'intervention des forces de l'ordre."
