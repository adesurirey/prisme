  "summaries": {
    "gauche": [
      "Le lycée Bréquigny à Rennes ferme ses portes du 16 au 20 novembre suite à des dégradations.",
      "Un groupe incluant des élèves a saccagé des portes, des vitres et un bureau avec des extincteurs selon le rectorat."
    ],
    "centre": [
      "Le plus grand établissement scolaire de Bretagne bascule en enseignement à distance pour une semaine.",
      "La direction réagit à de graves débordements et actes de vandalisme survenus le 12 novembre."
    ],
    "droite": [
      "Le lycée Bréquigny de Rennes interrompt l'accueil physique de ses trois mille élèves et étudiants jusqu'au 20 novembre.",
      "La décision fait suite à des intrusions et des destructions matérielles commises en marge d'un mouvement lycéen."
    ]
  },
  "differences": [
    "La gauche privilégie un compte-rendu laconique basé strictement sur le communiqué du rectorat concernant les dégradations matérielles.",
    "Le centre met l'accent sur l'ampleur inédite de la fermeture administrative visant le plus grand établissement breton.",
    "La droite insiste sur le contexte d'agitation lycéenne et le volume des effectifs pénalisés par le passage au distanciel."
  ],
