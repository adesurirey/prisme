  "summaries": {
    "gauche": [
      "Donald Trump a publiquement proposé à Dana White, dirigeant de l'UFC âgé de 57 ans, de devenir le porte-parole de la Maison Blanche.",
      "Le président américain s'appuie sur ce proche qualifié de figure conservatrice et masculiniste pour riposter après la défaite républicaine aux élections de mi-mandat.",
      "D'après CNN, cité par plusieurs titres, Dana White aurait rejeté cette offre, bien qu'une rencontre entre les deux hommes soit prévue lundi."
    ],
    "centre": [
      "Donald Trump a annoncé sur son réseau Truth Social avoir proposé le poste de porte-parole de la Maison Blanche à Dana White, patron de l'UFC.",
      "Cette offre intervient dans un contexte de remaniement suite aux mauvais résultats des Républicains aux élections de mi-mandat.",
      "Alors que Dana White doit rencontrer Donald Trump lundi, la chaîne CNN affirme qu'il aurait refusé le poste."
    ],
    "droite": [
      "Donald Trump a officialisé sa proposition de nommer Dana White, patron de la principale fédération de MMA et proche de longue date, comme porte-parole de la Maison Blanche.",
      "Le chef de l'État cherche à consolider son socle politique à la suite de la déconvenue des Républicains lors des élections de mi-mandat.",
      "Le poste de porte-parole est vacant depuis l'éviction mi-octobre de Katie Zacharia, qui n'était restée qu'une semaine en fonction."
    ]
  },
  "differences": [
    "La gauche insiste sur le profil polémique et masculiniste de Dana White ainsi que sur le refus que celui-ci aurait opposé à l'offre présidentielle.",
    "Le centre se focalise sur l'annonce officielle faite par Donald Trump et sur la perspective d'une rencontre prochaine entre les deux hommes pour trancher.",
    "La droite met en avant la volonté de Donald Trump de renforcer son équipe après les midterms et rappelle l'instabilité du poste, vacant depuis le départ rapide de Katie Zacharia."
  ],
