  "summaries": {
    "gauche": [
      "La FAA a ordonné la suspension totale des décollages aux États-Unis en invoquant des circonstances exceptionnelles et des raisons de sécurité.",
      "Près de 7 000 vols sont affectés par ce dysfonctionnement des systèmes de communication selon les autorités.",
      "Des techniciens enquêtent actuellement pour déterminer l'origine de cette panne sans que l'origine précise ne soit encore clarifiée."
    ],
    "centre": [
      "Le régulateur américain de l'aviation a ordonné l'arrêt de l'ensemble des vols en raison de problèmes de communication touchant les centres de contrôle.",
      "Le secrétaire aux Transports Sean Duffy a indiqué que le trafic aérien doit rester suspendu jusqu'à nouvel ordre.",
      "Plusieurs médias rappellent l'existence d'incidents antérieurs similaires survenus dans les aéroports new-yorkais au cours des années précédentes."
    ],
    "droite": [
      "La Federal Aviation Administration a ordonné aux avions de rester au sol à travers l'ensemble des aéroports du pays.",
      "Le ministre de la Sécurité intérieure Markwayne Mullin a affirmé qu'aucune menace extérieure ou attentat n'était à l'origine de cette panne.",
      "Le bilan provisoire fait état de près de 7 000 vols retardés ou annulés suite à ces difficultés de communication."
    ]
  },
  "differences": [
    "La gauche insiste en premier lieu sur l'ampleur immédiate de la perturbation pour les passagers en mentionnant précisément le nombre de vols cloués au sol.",
    "Le centre adopte un format factuel et institutionnel centré sur les communiqués officiels de la FAA et du ministère des Transports.",
    "La droite intègre rapidement les déclarations rassurantes du gouvernement écartant l'hypothèse d'une menace terroriste ou d'une attaque malveillante."
  ],
