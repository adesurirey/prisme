  "summaries": {
    "gauche": [
      "Le pôle cold case du parquet de Nanterre relance l'affaire de la disparition de Marion Wagon, survenue le 14 novembre 1996 à Agen.",
      "Une enquête est relancée trente ans plus tard grâce au témoignage inédit d'une femme qui avait 13 ans à l'époque et à l'identification de l'ADN de la victime.",
      "La fillette de 10 ans s'était volatilisée sans laisser de traces à 400 mètres de son domicile."
    ],
    "centre": [
      "Le pôle cold cases et crimes sériels du tribunal de Nanterre lance un appel à témoins trente ans après la disparition de Marion Wagon à Agen.",
      "Un témoignage récent d'une quadragénaire ayant signalé avoir été suivie par un suspect à l'époque a permis de réactiver les investigations.",
      "La justice recherche d'éventuels éléments supplémentaires, soulignant que des comparaisons ADN sont désormais possibles sur des scellés."
    ],
    "droite": [
      "Le pôle cold case de Nanterre et la juge Sabine Khéris relancent l'enquête sur la disparition de Marion Wagon, survenue à Agen en novembre 1996.",
      "Un appel à témoins est publié pour identifier un suspect d'une soixantaine d'années décrit par une femme de 43 ans affirmant avoir été filée à l'époque.",
      "Des analyses génétiques sont ordonnées dans l'immeuble où la témoin de l'époque indique avoir trouvé refuge."
    ]
  },
  "differences": [
