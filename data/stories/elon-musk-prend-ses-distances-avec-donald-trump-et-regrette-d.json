  "summaries": {
    "gauche": [
      "Le milliardaire a investi près de 500 millions de dollars dans les élections de mi-mandat.",
      "Il confie se sentir « un peu bête » après les échecs électoraux des candidats républicains.",
      "Il prend ses distances avec la ligne politique de Donald Trump et le mouvement MAGA."
    ],
    "centre": [
      "Elon Musk reconnaît avoir gaspillé près d'un demi-milliard de dollars pour soutenir des candidats battus aux midterms.",
      "Il affirme se sentir « un peu idiot » et assure ne pas adhérer au mouvement MAGA.",
      "Le chef d'entreprise se définit comme idéologiquement « assez modéré » et évoque sa volonté d'obtenir « un certain équilibre des pouvoirs »."
    ],
    "droite": [
      "Le patron de Tesla et SpaceX regrette les montants abyssaux engagés pour les midterms.",
      "Il admet publiquement se sentir « un peu idiot » face à la défaite de la majorité des candidats qu'il soutenait."
    ]
  },
