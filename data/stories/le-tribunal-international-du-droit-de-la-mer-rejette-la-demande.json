  "summaries": {
    "gauche": [
      "Le Tribunal international du droit de la mer a rejeté la demande de l'Argentine visant à bloquer le projet pétrolier Sea Lion au large des îles Malouines.",
      "Buenos Aires contestait le droit du Royaume-Uni d'autoriser l'exploitation d'hydrocarbures sur cet archipel sous administration britannique."
    ],
    "centre": [
      "Le Tribunal international du droit de la mer a rejeté la demande de l'Argentine d'interdire les forages pétroliers autour des îles Malouines.",
      "L'Argentine réclamait des mesures conservatoires et une suspension des travaux en attendant l'arbitrage sur le fond.",
      "Les juges ont estimé que la requête impliquait de trancher la question de la souveraineté sur l'archipel."
    ],
    "droite": [
      "Le tribunal international a rejeté la demande de l'Argentine visant à suspendre le projet d'exploitation pétrolière aux îles Malouines.",
      "L'Argentine soutenait que ses requêtes d'urgence pouvaient être examinées indépendamment du contentieux sur la souveraineté des îles."
    ]
  },
  "differences": [
    "La gauche met l'accent sur le blocage demandé par Buenos Aires face à l'exploitation britannique.",
    "Le centre détaille la procédure juridique et l'argumentation des juges concernant la souveraineté des îles.",
    "La droite insiste sur le rejet de la demande argentine et sur le refus de dissocier les mesures d'urgence du contentieux territorial."
  ],
