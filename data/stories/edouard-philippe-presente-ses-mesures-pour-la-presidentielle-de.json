  "summaries": {
    "gauche": [
      "Le candidat Horizons Édouard Philippe a dévoilé son programme présidentiel lors d'une conférence de presse axée sur l'école et la justice.",
      "Le projet met l'accent sur le rétablissement des comptes publics, la réforme des retraites et l'attachement au projet européen.",
      "L'ancien Premier ministre a prôné des réformes radicales en rupture avec la gestion politique des dernières années."
    ],
    "centre": [
      "Édouard Philippe a présenté son programme présidentiel pour relancer sa campagne face à la baisse de ses sondages.",
      "Le programme propose la fin des 35 heures, une hausse du salaire des enseignants et un service national obligatoire.",
      "Le candidat Horizons mise sur des mesures strictes pour réduire les dépenses publiques, restreignant le statut de fonctionnaire aux missions régaliennes."
    ],
    "droite": [
      "Édouard Philippe a dévoilé un programme qualifié de massif et sérieux, fondé sur une rupture budgétaire pour contrer ses adversaires politiques.",
      "Le projet intègre une réforme ambitieuse des retraites par capitalisation et une baisse de moitié de l'immigration.",
      "Le candidat a réaffirmé son refus de participer à une primaire tout en insistant sur sa volonté de rupture avec la politique d'Emmanuel Macron."
    ]
  },
  "differences": [
    "La gauche privilégie une approche institutionnelle et programmatique en détaillant les volets scolaires, judiciaires et européens du projet.",
    "Le centre insiste sur la stratégie électorale du candidat face à sa situation dans les sondages tout en listant les mesures économiques concrètes.",
    "La droite met en avant la notion de rupture politique face au bilan macronien et détaille les propositions de fermeté et de réforme budgétaire."
  ],
