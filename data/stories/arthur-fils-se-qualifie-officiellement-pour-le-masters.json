    "gauche": [
      "Arthur Fils valide sa participation au Tournoi des Maîtres de Turin après la défaite de Frances face à Quentin Halys.",
      "Le joueur de vingt-deux ans devient le premier Tricolore à atteindre ce niveau depuis Gaël Monfils en 2016.",
      "Il réussit dans le même temps son entrée en lice au Rolex Paris Masters en battant Tomas Machac en deux sets."
    ],
    "centre": [
      "Arthur Fils officialise sa qualification pour le Masters de Turin grâce au succès de Quentin Halys contre Frances Tiafoe.",
      "Il s'agit d'une première pour le tennis français depuis la performance de Gaël Monfils il y a dix ans.",
      "Le joueur élimine ensuite Tomas Machac pour accéder aux huitièmes de finale du tournoi parisien."
    ],
    "droite": [
      "Arthur Fils apprend sa qualification pour les ATP Finals de Turin à la suite de la victoire de Quentin Halys.",
      "Il renoue avec l'histoire en devenant le premier Français qualifié pour ce tournoi depuis dix ans.",
      "Le joueur s'impose ensuite face à Tomas Machac lors de son entrée en lice au Rolex Paris Masters."
    ]
  },
