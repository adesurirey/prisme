  "summaries": {
    "gauche": [
      "Le conducteur du car impliqué dans le drame survenu à Lent a été mis en examen pour homicide involontaire.",
      "L'homme âgé de 26 ans a reconnu auprès des enquêteurs qu'il s'était endormi avant le choc survenu vendredi.",
      "Le véhicule transportait 49 passagers, parmi lesquels une fillette de sept ans et un étudiant de 18 ans ont perdu la vie."
    ],
    "centre": [
      "Le parquet de Bourg-en-Bresse a annoncé la mise en examen du chauffeur du car pour homicide involontaire.",
      "La sortie de route intervenue vendredi dans l'Ain a causé la mort de deux personnes, une enfant et un étudiant.",
      "Le véhicule transportait 49 personnes, dont 23 mineurs, au moment de l'accident."
    ],
    "droite": [
      "Le chauffeur du car âgé de 26 ans, sans antécédent judiciaire, a été placé sous contrôle judiciaire.",
      "Il a été mis en examen par le parquet de Bourg-en-Bresse pour homicide et blessures involontaires.",
      "L'accident survenu vendredi à Lent a provoqué la mort d'une fillette de sept ans et d'un jeune majeur."
    ]
  },
  "differences": [
    "La gauche insiste en premier lieu sur les déclarations du chauffeur qui a reconnu s'être endormi avant la collision.",
    "Le centre livre un compte-rendu purement factuel centré sur les communiqués du parquet et le bilan des victimes.",
    "La droite met en avant l'absence d'antécédents judiciaires du conducteur et précise la qualification juridique exacte retenue par la justice, incluant les blessures involontaires."
  ],
