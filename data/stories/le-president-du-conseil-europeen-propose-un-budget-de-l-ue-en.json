  "summaries": {
    "gauche": [
      "Le président du Conseil européen Antonio Costa a soumis un nouveau projet de budget pour la période 2028-2034 en baisse de 204 milliards d'euros.",
      "Le texte intègre une taxe sur les géants du numérique ainsi qu'une réflexion sur la taxation des cryptoactifs.",
      "La France a immédiatement rejeté cette proposition de compromis qui sera examinée lors du sommet de Bruxelles.",
      "Le Monde rappelle que le projet sera soumis aux dirigeants européens jeudi et vendredi."
    ],
    "centre": [
      "António Costa a présenté un projet de budget de l'Union européenne pour la période 2028-2034 réduit de 204 milliards d'euros par rapport aux prévisions initiales de la Commission.",
      "L'Élysée a rejeté le texte en estimant que « le compte n'y est pas », en particulier pour garantir les aides de la Politique agricole commune.",
      "La proposition budgétaire intègre également une taxe numérique selon les précisions rapportées par franceinfo.",
      "Le compromis d'António Costa représente une diminution de dix pour cent par rapport au montant initial de 2 000 milliards d'euros."
    ],
    "droite": [
      "L'Élysée a qualifié de « très décevant » le projet de budget de l'Union européenne pour la période 2028-2034 présenté par le président du Conseil européen.",
      "Le texte prévoit des réductions budgétaires à hauteur de 204 milliards d'euros et l'instauration d'une taxe numérique.",
      "Paris a officiellement rejeté cette proposition de compromis formulée un samedi."
    ]
  },
  "differences": [
    "La gauche privilégie un exposé factuel des mesures d'Antonio Costa tout en soulignant l'échéance du prochain sommet européen à Bruxelles.",
    "Le centre insiste sur les critiques institutionnelles de l'Élysée concernant les répercussions directes du budget sur les agriculteurs et la Politique agricole commune.",
    "La droite focalise son traitement sur le rejet catégorique de l'exécutif français et qualifie sévèrement la proposition européenne de « très décevant »."
  ],
