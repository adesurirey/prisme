  "summaries": {
    "gauche": [
      "Le chef de l'Etat de 45 ans a officialisé sa candidature après la modification de la Constitution salvadorienne.",
      "Le scrutin est fixé à février 2027.",
      "Ses actions contre les bandes criminelles expliquent sa forte popularité mais provoquent de vives critiques."
    ],
    "centre": [
      "Nayib Bukele a déposé sa candidature pour un troisième mandat avec le soutien de milliers de sympathisants.",
      "Une révision constitutionnelle intervenue l'an passé lui permet de se représenter.",
      "Le journal Le Parisien qualifie le dirigeant de président autoritaire et proche de Donald Trump."
    ],
    "droite": [
      "Le président du Salvador a officialisé sa candidature devant le Tribunal suprême électoral entouré de 3 000 partisans.",
      "La Constitution a été modifiée l'année précédente pour supprimer toute limitation sur les mandats présidentiels.",
      "Le dirigeant a déclaré devant la foule que le pays ne reviendrait pas dans le passé."
    ]
  },
