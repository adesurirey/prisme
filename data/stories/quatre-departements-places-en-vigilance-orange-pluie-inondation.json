  "summaries": {
    "gauche": [
      "Météo France a placé cinq départements en vigilance orange pluie-inondation et crues ce jeudi 19 novembre.",
      "L'alerte concerne la Somme, le Pas-de-Calais, la Seine-Maritime, les Landes et la Haute-Corse selon les informations concordantes de Libération et du Monde."
    ],
    "centre": [
      "Quatre départements sont concernés par la vigilance orange pluie-inondation ce jeudi matin selon Météo-France.",
      "Le Pas-de-Calais subit des précipitations continues équivalentes à deux mois de pluie en 24 heures.",
      "Le département des Landes rejoint la zone d'alerte dès midi tandis que le Pas-de-Calais est également placé en vigilance orange crues."
    ],
    "droite": [
      "Quatre départements du nord et du sud-ouest font l'objet d'une vigilance orange pluie-inondation jusqu'à vendredi midi.",
      "Les cumuls de précipitations atteignent 40 à 60 millimètres, et localement 70 millimètres sur la moitié sud du Pas-de-Calais et le nord de la Somme.",
      "Une vingtaine d'habitations sont touchées dans le Pas-de-Calais selon les relevés de terrain."
    ]
  },
  "differences": [
    "La gauche retient un périmètre de cinq départements en incluant explicitement la Haute-Corse dans le bilan des intempéries.",
    "Le centre se focalise sur l'actualisation en temps réel des cartes de vigilance et sur les cumuls records enregistrés en 24 heures dans le Pas-de-Calais.",
    "La droite détaille précisément les volumes de précipitations mesurés en millimètres par Météo-France et documente l'impact local sur les habitations."
  ],
