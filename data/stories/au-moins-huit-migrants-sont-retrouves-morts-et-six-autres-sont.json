  "summaries": {
    "gauche": [
      "Le service espagnol de sauvetage maritime a secouru quatre-vingt-quatre personnes à bord d'une embarcation au large des Canaries.",
      "Au moins huit migrants ont péri et six autres ont été grièvement blessés lors de cette traversée vers l'île d'El Hierro.",
      "L'île d'El Hierro fait face depuis plusieurs semaines à un afflux migratoire important en provenance du continent africain."
    ],
    "centre": [
      "Une embarcation transportant des migrants a été secourue vendredi au large de l'archipel des Canaries.",
      "Le bilan fait état de huit morts et de six blessés graves parmi les passagers de l'embarcation.",
      "Quatre-vingt-quatre survivants ont été débarqués sur l'île d'El Hierro, qui subit une forte pression migratoire."
    ],
    "droite": [
      "Entre huit et dix migrants ont été retrouvés morts et six autres blessés dans une embarcation à environ 70 km des Canaries.",
      "Quatre-vingt-quatre autres personnes, dont un mineur, ont été secourues et débarquées dans le port de La Restinga sur l'île d'El Hierro.",
      "Les autorités espagnoles ont déclenché une urgence migratoire dans un contexte d'afflux massif et de vifs débats à l'approche des législatives."
    ]
  },
  "differences": [
    "La gauche livre un compte rendu factuel et concis centré sur le nombre de victimes et l'aide apportée par les services de sauvetage maritimes.",
    "Le centre adopte un format factuel et direct similaire, insistant principalement sur le bilan humain et la pression exercée sur l'île d'El Hierro.",
    "La droite contextualise l'événement en l'associant à une urgence migratoire et aux enjeux politiques nationaux à la veille des élections législatives en Espagne."
  ],
