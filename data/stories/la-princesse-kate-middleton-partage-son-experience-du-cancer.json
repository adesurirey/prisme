  "summaries": {
    "gauche": [
      "La princesse Kate Middleton annonce la sortie le 29 novembre d'un film de 30 minutes intitulé « Guérir ».",
      "Ce projet audiovisuel aborde la maladie qui a touché la princesse de Galles, déclarée en rémission au début de l'année 2025."
    ],
    "centre": [
      "La princesse Kate va diffuser le 29 novembre un film intime baptisé « Guérir » concernant son combat contre la maladie.",
      "L'épouse du prince William souhaite ainsi aider d'autres individus à traverser le diagnostic, la guérison et l'après-cancer.",
      "La princesse déclare notamment que « le cancer vous change » et qualifie sa rémission de « voyage »."
    ],
    "droite": [
      "Le palais de Kensington officialise la diffusion pour le 29 novembre d'un documentaire intitulé « Heal ».",
      "La princesse Kate y évoque son épreuve face au cancer ainsi que son existence après sa période de rémission."
    ]
  },
  "differences": [
    "La gauche met l'accent sur le format précis et la durée du court-métrage consacré à la rémission de la princesse.",
