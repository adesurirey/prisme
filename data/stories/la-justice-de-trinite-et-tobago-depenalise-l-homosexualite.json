  "summaries": {
    "gauche": [
      "La plus haute instance judiciaire du pays a invalidé des textes répressifs issus de la période coloniale britannique.",
      "Ces dispositions prévoyaient des peines de deux à cinq ans d'emprisonnement pour des infractions qualifiées de sodomie ou d'indécence grave."
    ],
    "centre": [
      "La dépénalisation de l'homosexualité a été obtenue grâce à un combat judiciaire mené durant près de dix ans.",
      "Cette évolution historique fait suite à un recours porté par un militant des droits des personnes LGBT+.",
      "La plus haute juridiction de cet État a déclaré contraires à la loi fondamentale les mesures pénales héritées de la domination britannique."
    ],
    "droite": [
      "La plus haute juridiction de l'État a prononcé l'annulation des textes criminalisant les relations homosexuelles.",
      "Cette décision judiciaire fait suite à une longue procédure de près d'une décennie impulsée par un défenseur des droits des personnes LGBT+ de cet archipel."
    ]
  },
  "differences": [
    "Le camp de gauche met l'accent sur la nature rétrograde des lois coloniales abolies et le détail des sanctions pénales encourues par les condamnés.",
    "Le camp du centre met en avant le parcours personnel du militant à l'origine de cette victoire judiciaire de grande ampleur.",
    "Le camp de droite valorise la dimension institutionnelle de la décision en insistant sur le rôle de la plus haute juridiction de l'État."
