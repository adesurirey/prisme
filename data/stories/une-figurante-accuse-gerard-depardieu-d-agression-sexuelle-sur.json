  "summaries": {
    "gauche": [
      "Libération met en avant de nouvelles révélations de Mediapart et du Média concernant des images tournées en 2011 sur le film Turf.",
      "Le journal détaille une séquence où Gérard Depardieu touche les fesses et l'entrejambe d'une figurante qui tente de repousser sa main."
    ],
    "centre": [
      "Le Parisien diffuse les images et le témoignage d'une figurante affirmant avoir cherché à se débarrasser de l'acteur lors d'un tournage en 2011."
    ],
    "droite": [
      "TF1 Info indique que le comédien renonce à son procès en appel, rendant définitive sa condamnation à dix-huit mois de prison avec sursis pour agressions sexuelles sur le tournage des \"Volets verts\" en 2021.",
      "Le Figaro précise que Gérard Depardieu ne se présentera pas à l'ouverture de son procès en appel et rappelle son désistement en avril concernant ses poursuites contre France Télévisions."
    ]
  },
  "differences": [
