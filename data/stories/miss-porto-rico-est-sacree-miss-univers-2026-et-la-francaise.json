  "summaries": {
    "gauche": [
      "Jennifer Barreto a été couronnée Miss Univers 2026 lors de la finale organisée à Porto Rico.",
      "Elle succède à la tenante du titre Fátima Bosch, représentante du Mexique.",
      "La candidate française Garance Authié s'est hissée dans le top 12 de cette 75e édition du concours."
    ],
    "centre": [
      "Jennifer Barreto, candidate de Porto Rico, a remporté le concours de Miss Univers 2026.",
      "La Française Garance Authié a intégré le top 12 de cette 75e édition de la compétition internationale."
    ],
    "droite": [
      "Jennifer Barreto a été sacrée Miss Univers 2026 à l'occasion de la 75e édition du concours qui se déroulait à San Juan.",
      "La candidate portoricaine offre à son pays un sixième titre en s'imposant à domicile.",
      "Elle devient la première femme mariée et mère de famille à remporter la couronne internationale.",
      "La Française Garance Authié s'est qualifiée parmi les douze finalistes de la compétition."
    ]
  },
