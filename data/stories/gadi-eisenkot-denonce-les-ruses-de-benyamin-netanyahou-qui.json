  "summaries": {
    "gauche": [
      "Benyamin Nétanyahou justifie son appel à la constitution d'un gouvernement d'union par la nécessité absolue d'assurer la sécurité du pays face au péril iranien.",
      "Le projet de coalition du premier ministre sortant engloberait l'ensemble des partis sionistes de droite et du centre tout en barrant la route aux formations arabes israéliennes."
    ],
    "centre": [
      "Gadi Eisenkot rejette catégoriquement la proposition de coalition formulée par Benyamin Nétanyahou, qualifiant cette démarche de « ruses politiciennes ».",
      "Benyamin Nétanyahou insiste sur la formation d'un cabinet d'union nationale pour « garantir la sécurité » de l'État hébreu."
    ],
    "droite": [
      "Gadi Eisenkot qualifie de pures « ruses » les appels répétés de Benyamin Nétanyahou en faveur d'une entente gouvernementale élargie.",
      "L'ancien chef d'état-major reproche à son rival d'orchestrer un simulacre de négociation tout en attisant délibérément les divisions internes."
    ]
  },
  "differences": [
    "La gauche privilégie l'analyse programmatique et géopolitique du projet d'union nationale et de sa composition sectaire face à la menace extérieure.",
    "Le centre centre son traitement sur la confrontation politique directe entre le premier ministre sortant et son principal opposant autour de la sécurité.",
    "La droite adopte un angle strictement critique en reprenant les accusations personnelles d'Eisenkot contre les manœuvres tactiques et divisionnaires de Nétanyahou."
  ],
