  "summaries": {
    "gauche": [
      "La cour d'assises d'appel de la Dordogne a prononcé la réclusion criminelle à perpétuité à l'encontre de Mounir Boutaa pour le féminicide de Chahinez Daoud en 2021.",
      "Le média Libération rappelle que l'accusé était âgé de 50 ans lors de son procès en appel.",
      "Le Monde souligne le caractère emblématique de cette affaire où la victime avait déposé une plainte mal enregistrée quelques mois avant les faits."
    ],
    "centre": [
      "La condamnation à la prison à perpétuité a été confirmée en appel pour l'ex-mari de Chahinez Daoud, brûlée vive à Mérignac en 2021.",
      "Le parquet et la justice ont validé une période de sûreté de 22 ans assortie à cette peine criminelle.",
      "Le Parisien rapporte le soulagement exprimé face à ce verdict définitif par l'entourage de la victime et les parties civiles."
    ],
    "droite": [
      "Mounir Boutaa a vu sa peine de réclusion criminelle à perpétuité confirmée ce vendredi par la cour d'assises d'appel de la Dordogne.",
      "Europe 1 précise que le condamné est un maçon franco-algérien de 50 ans et mentionne la possibilité d'une rétention de sûreté.",
      "Le Figaro qualifie directement les faits d'assassinat dans le cadre du meurtre de Chahinez Daoud en 2021."
    ]
  },
  "differences": [
    "La gauche insiste sur le contexte institutionnel défaillant et la notion de féminicide emblématique pour souligner les failles de la protection des femmes.",
    "Le centre livre un compte-rendu factuel et centré sur le déroulement strict du procès ainsi que sur la réaction de soulagement des parties civiles.",
    "La droite met en avant le profil précis de l'accusé et les aspects techniques de la sanction pénale, incluant la période et la rétention de sûreté."
  ],
