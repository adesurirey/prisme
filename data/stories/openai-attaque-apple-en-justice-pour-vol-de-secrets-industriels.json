  "summaries": {
    "gauche": [
      "OpenAI a déposé vendredi 27 novembre 2026 une plainte en justice à San Jose contre Apple pour vol de secrets industriels.",
      "Le créateur de ChatGPT accuse son ancien partenaire de pressions sur des fournisseurs communs pour freiner son arrivée sur les objets connectés.",
      "Cette action en justice illustre la transformation progressive des deux acteurs technologiques en rivaux directs."
    ],
    "centre": [
      "OpenAI et Apple s'affrontent mutuellement devant la justice américaine sur fond de rivalité dans les objets connectés.",
      "La maison mère de ChatGPT accuse Apple de vol de secrets industriels et de pressions exercées sur leurs fournisseurs communs."
    ],
    "droite": [
      "OpenAI a contre-attaqué en justice le 27 novembre 2026 devant un tribunal fédéral de San Jose en Californie.",
      "La firme accuse Apple d'avoir dérobé des secrets de fabrication par l'intermédiaire d'un ancien salarié ayant transmis des dizaines de documents.",
      "Les pressions sur les fournisseurs visaient à identifier les projets de ChatGPT pour empêcher son entrée sur le marché des objets connectés."
    ]
  },
  "differences": [
    "Les médias de gauche mettent en avant l'escalade de la rivalité stratégique entre les deux entreprises sur le marché des objets connectés.",
    "Les médias du centre se concentrent sur la judiciarisation du conflit et la réciprocité des accusations de vol entre les deux acteurs.",
    "Les médias de droite insistent sur les détails techniques de la plainte, notamment le rôle d'un ancien salarié et la transmission de documents confidentiels."
  ],
