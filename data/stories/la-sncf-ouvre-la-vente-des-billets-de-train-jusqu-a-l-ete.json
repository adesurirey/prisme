  "summaries": {
    "gauche": [
      "La SNCF avance dès ce jeudi 12 novembre l'ouverture de sa billetterie TGV INOUI pour des voyages programmés jusqu'au 2 juillet 2027.",
      "franceinfo précise que les réservations pour les trains Intercités ouvriront également ce jeudi, mais pour une période limitée aux trajets jusqu'au 31 mars."
    ],
    "centre": [
      "La SNCF modifie son calendrier et ouvre dès le 12 novembre la billetterie TGV pour des trajets du 7 janvier au 2 juillet 2027, une période inédite de six mois.",
      "La Croix souligne que cette anticipation permet aux voyageurs d'organiser leurs déplacements et leur budget pour les vacances de Pâques et les ponts de mai, avec des variations de prix pouvant atteindre 50 %."
    ],
    "droite": [
      "La SNCF ouvre sa billetterie ce jeudi 12 novembre pour l'ensemble des trajets prévus jusqu'au 2 juillet 2027, couvrant ainsi les vacances de février et de Pâques.",
      "Le Figaro propose un guide pratique listant les stations de ski des Alpes, des Pyrénées et du Massif central les plus accessibles par le rail depuis Paris pour la période hivernale."
    ]
  },
  "differences": [
    "La gauche se focalise sur l'annonce pratique de l'ouverture des ventes en distinguant les TGV et les Intercités.",
    "Le centre met en avant le caractère inédit de cette réforme du calendrier ferroviaire et l'opportunité d'anticiper le budget des usagers.",
    "La droite complète l'information générale par des aspects pratiques orientés vers les vacances au ski et les stations accessibles en train."
  ],
