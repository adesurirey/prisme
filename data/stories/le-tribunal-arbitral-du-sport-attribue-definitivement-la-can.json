  "summaries": {
    "gauche": [
      "Le Tribunal arbitral du sport a validé à l'unanimité le sacre du Sénégal lors de la Coupe d'Afrique des nations après une affaire de dix mois.",
      "La finale disputée au Maroc s'était conclue par un quiproquo avant que la justice sportive ne tranche."
    ],
    "centre": [
      "Le Tribunal arbitral du sport a attribué définitivement la CAN 2025 au Sénégal aux dépens du Maroc, qui avait été sacré sur tapis vert.",
      "La Confédération africaine de football a déclaré respecter la décision de la juridiction suisse tandis que la Fédération marocaine conteste ce verdict."
    ],
    "droite": [
      "Le Tribunal arbitral du sport a confirmé la victoire sur le terrain du Sénégal contre le Maroc lors de la Coupe d'Afrique des Nations.",
      "Le Sénégal récupère officiellement son titre de champion d'Afrique après l'annulation du forfait prononcé par la CAF."
    ]
  },
  "differences": [
    "La gauche met l'accent sur la durée du litige et le quiproquo initial entourant la finale jouée au Maroc.",
    "Le centre détaille les rebondissements institutionnels entre la CAF et le TAS ainsi que les réactions contrastées des Fédérations sénégalaise et marocaine.",
    "La droite insiste sur le caractère sportif du verdict en soulignant la restitution du titre acquis sur le terrain par les joueurs sénégalais."
  ],
