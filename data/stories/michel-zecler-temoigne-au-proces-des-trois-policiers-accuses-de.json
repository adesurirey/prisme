  "summaries": {
    "gauche": [
      "Le producteur de musique Michel Zecler a témoigné mardi devant la cour criminelle de Paris lors du procès de trois policiers poursuivis pour violences volontaires aggravées et faux en écriture publique.",
      "Il a décrit une agression brutale dans son studio de musique en novembre 2020, affirmant que les agents \"se sont déchaînés\" et l'ont \"lynché\".",
      "Il a souligné que sa survie judiciaire et l'établissement des faits reposent entièrement sur l'existence de vidéosurveillances.",
      "Le premier jour du procès a également abordé la personnalité des accusés, incluant des questions sur un éventuel mobile raciste malgré son absence dans les charges."
    ],
    "centre": [
      "Michel Zecler a livré un témoignage de près de trois heures devant la cour criminelle départementale de Paris au deuxième jour du procès de trois policiers.",
      "La cour a visionné et décortiqué les images de vidéosurveillance de l'agression survenue en novembre 2020 dans le hall du studio du producteur.",
      "La victime a déclaré avoir craint pour sa vie et souffrir de séquelles psychologiques durables, tout en insistant sur le rôle décisif des vidéos pour faire éclater la vérité."
    ],
    "droite": [
      "Le producteur de musique Michel Zecler a témoigné devant la cour criminelle départementale de Paris au procès de trois policiers poursuivis pour violences aggravées et faux en écriture publique.",
      "Il a évoqué les lourdes séquelles psychologiques qui persistent près de six ans après les faits survenus en novembre 2020.",
      "Un enquêteur de l'IGPN a présenté un témoignage accablant pour les accusés en détaillant de nombreuses irrégularités relevées lors de leur intervention."
    ]
  },
  "differences": [
    "La gauche privilégie un récit insistant sur la violence extrême du « lynchage » et la persistance de la question du racisme à travers la personnalité des accusés.",
    "Le centre adopte un angle descriptif axé sur le déroulement des audiences, l'analyse minutieuse des vidéos et les déclarations directes de la victime.",
    "La droite centre son traitement sur les témoignages factuels des experts de l'IGPN concernant les irrégularités de l'intervention et l'impact psychologique à long terme sur la victime."
  ],
