  "summaries": {
    "gauche": [
      "La députée écologiste Sandrine Rousseau a reproché à l'exécutif sa « complaisance » envers la violence de l'extrême droite.",
      "L'élue écologiste figure parmi les personnalités de gauche dont le nom a été découvert au domicile de Kévin Tessier.",
      "Elle a exprimé son indignation sur BFMTV suite aux révélations concernant l'attentat de Trappes."
    ],
    "centre": [
      "Sandrine Rousseau a affirmé sur BFMTV que le ministère de l'Intérieur sous-estime la menace liée à l'extrême droite.",
      "La députée écologiste critique l'exécutif pour sa « complaisance » et sa « minimisation » des violences de ce camp politique.",
      "Elle déplore de n'avoir reçu aucune information directe des forces de l'ordre figurant sur la liste établie par l'auteur de l'attentat raciste de Trappes."
    ]
  },
  "differences": [
    "La presse de gauche met en avant l'implication personnelle de Sandrine Rousseau dont le nom figurait sur la liste de l'assaillant de Trappes.",
    "La presse du centre privilégie les accusations directes de la députée écologiste contre le ministère de l'Intérieur qu'elle juge laxiste."
  ],
