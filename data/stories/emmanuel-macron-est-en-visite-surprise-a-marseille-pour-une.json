    "gauche": [
      "Emmanuel Macron effectue un déplacement inopiné à Marseille suite aux débordements du 17 octobre pour afficher le retour à la normale.",
      "Le chef de l'État a prévu de s'entretenir avec le maire Benoît Payan ainsi qu'avec les policiers et les commerçants impactés.",
      "Certains articles soulignent que le gouvernement et le président font face à des critiques de toutes parts après les incidents."
    ],
    "centre": [
      "Le président de la République se déplace à Marseille pour une visite inopinée ce lundi après-midi.",
      "L'objectif affiché de ce déplacement est de constater sur place le « retour de l'ordre républicain ».",
      "Le chef de l'État doit rencontrer le maire Benoît Payan, les commerçants touchés et les forces de l'ordre."
    ],
    "droite": [
      "Emmanuel Macron se rend à Marseille dans le cadre d'un déplacement inopiné une semaine après les émeutes.",
      "Le président souhaite axer sa visite sur la sécurité et l'économie en allant à la rencontre des habitants, des commerçants et des policiers."
    ]
  },
