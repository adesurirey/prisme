  "summaries": {
    "gauche": [
      "Un hommage national pour les victimes de l'attaque raciste survenue le 23 octobre se déroulera le 4 décembre aux Invalides à Paris.",
      "La cérémonie sera présidée par le Premier ministre Sébastien Lecornu, selon les annonces de l'exécutif.",
      "Le gouvernement a contacté les familles des victimes ces derniers jours après plusieurs semaines d'interrogations sur le calendrier."
    ],
    "centre": [
      "Le Premier ministre Sébastien Lecornu présidera un hommage national le 4 décembre aux Invalides en mémoire des victimes de l'attentat de Trappes et de La Verrière.",
      "La date a été arrêtée en concertation avec la famille de Pengo Bossio Wangi, tué en raison de sa couleur de peau lors de ce drame du 23 octobre.",
      "Cet événement républicain se tiendra plus d'un mois après les faits, alors que l'état de santé des blessés s'est amélioré."
    ],
    "droite": [
      "L'entourage du Premier ministre a officialisé la tenue d'un hommage national le 4 décembre dans la cour des Invalides à Paris.",
      "La cérémonie honorera Pengo Bossio Wangi, jeune espoir de MMA de 26 ans tué lors du périple sanglant du 23 octobre, ainsi que les sept blessés.",
      "La date a été validée avec les proches de la victime et tient compte de la stabilisation de l'état de santé des personnes blessées."
    ]
  },
  "differences": [
    "La gauche insiste sur le délai de plusieurs semaines et les difficultés de calendrier avant l'organisation de cette cérémonie.",
    "Le centre livre un compte-rendu institutionnel centré sur le déroulement officiel de l'hommage et le choix de la date par le gouvernement.",
    "La droite détaille précisément le profil des victimes de l'attaque meurtrière et les circonstances concrètes du drame."
  ],
