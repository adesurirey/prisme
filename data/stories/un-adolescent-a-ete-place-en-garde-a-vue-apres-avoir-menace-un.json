  "summaries": {
    "gauche": [
      "Un enseignant d'histoire-géographie du lycée Edgar-Quinet à Paris a été visé par des menaces de mort le vendredi 13 novembre.",
      "Les faits ont eu lieu lors d'un cours virtuel, l'auteur ayant obtenu le lien de visioconférence.",
      "Le suspect est un homme qui s'est rendu à la justice et dont le dépôt de plainte a enclenché les poursuites."
    ],
    "centre": [
      "Un adolescent de seize ans, déscolarisé et résidant dans l'Ain, s'est rendu à la gendarmerie pour se dénoncer.",
      "Il a reconnu avoir proféré des menaces de mort en plein cours en ligne à l'encontre d'un professeur d'histoire-géographie du lycée parisien Edgar-Quinet.",
      "Sa garde à vue a été prolongée afin de permettre des perquisitions et l'exploitation de supports numériques saisis.",
      "Une enquête a été ouverte pour menaces de mort et apologie du terrorisme."
    ],
    "droite": [
      "Un mineur de seize ans s'est présenté de lui-même aux autorités le dimanche 15 novembre, deux jours après les faits.",
      "L'individu extérieur à l'établissement a menacé l'enseignant en déclarant « Je vais t'égorger à la Samuel Paty ».",
      "La procureure de Bourg-en-Bresse a indiqué que le suspect ne présentait pas d'antécédent judiciaire et reconnaissait les faits.",
      "La perquisition de son domicile et l'analyse de ses supports numériques ont motivé la prolongation de sa garde à vue."
    ]
  },
  "differences": [
    "La gauche privilégie un compte rendu factuel et sobre axé sur le dépôt de plainte de l'enseignant et la chronologie des faits.",
    "Le centre détaille précisément l'enquête en cours, l'identité géographique du suspect et les démarches procédurales de sa garde à vue.",
    "La droite dramatise l'événement en mettant immédiatement en avant la citation explicite des menaces et l'implication de la procureure de Bourg-en-Bresse."
  ],
