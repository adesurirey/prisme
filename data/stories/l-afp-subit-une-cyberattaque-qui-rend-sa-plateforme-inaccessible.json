  "summaries": {
    "gauche": [
      "L'Agence France-Presse a subi une cyberattaque dans la nuit de mercredi à jeudi.",
      "La plateforme AFP Forum, qui regroupe les photos et les dépêches, a été paralysée.",
      "L'agence ne dispose d'aucun élément sur l'identité des auteurs de cette intrusion."
    ],
    "centre": [
      "L'Agence France-Presse a été visée par une cyberattaque touchant sa plateforme AFP Forum.",
      "Le site est resté inaccessible ce jeudi soir suite à l'incident survenu dans la nuit.",
      "La direction de l'agence indique qu'aucun élément n'est disponible sur l'identité des auteurs."
    ],
    "droite": [
      "L'Agence France-Presse a fait l'objet d'une cyberattaque dans la nuit de mercredi à jeudi.",
      "La plateforme AFP Forum, dédiée aux photos et aux vidéos, a dû être désactivée temporairement."
    ]
  },
