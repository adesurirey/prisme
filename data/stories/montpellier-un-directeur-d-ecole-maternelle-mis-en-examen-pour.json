  "summaries": {
    "gauche": [
      "Le directeur d'une école maternelle de Montpellier a été mis en examen pour viol et agression sexuelle aggravés sur plusieurs enfants.",
      "Le suspect conteste l'intégralité des faits qui lui sont reprochés selon les informations rapportées par les rédactions.",
      "L'homme mis en cause a été placé sous contrôle judiciaire avec une interdiction formelle d'exercer toute fonction au contact d'enfants."
    ],
    "centre": [
      "Un directeur d'école maternelle de Montpellier a été mis en examen pour viol et agression sexuelle aggravés sur plusieurs enfants.",
      "L'enseignant a été placé en garde à vue au début de la semaine par les autorités avant d'être présenté à un juge.",
      "Un remplacement de ce directeur d'établissement a été opéré à la suite de son interpellation et de sa mise en examen."
    ],
    "droite": [
      "Le directeur d'une école maternelle de Montpellier est mis en examen pour viol et agression sexuelle aggravés sur de jeunes élèves.",
      "Le mis en cause conteste intégralement l'ensemble des faits de viol et d'agression sexuelle qui lui sont reprochés par le parquet.",
      "Le suspect ne peut plus exercer aucune activité professionnelle en lien avec des mineurs à la suite de sa mise en cause."
    ]
  },
  "differences": [
    "La gauche met l'accent sur les mesures de contrôle judiciaire et l'interdiction immédiate pour le suspect d'exercer au contact de mineurs.",
    "Le centre privilégie un compte rendu factuel et sobre axé sur le déroulement chronologique de la procédure judiciaire et le remplacement rapide du directeur.",
    "La droite qualifie l'affaire de « scandale de grande ampleur » tout en insistant sur le profil du suspect et le déni total des faits qui lui sont reprochés."
  ],
