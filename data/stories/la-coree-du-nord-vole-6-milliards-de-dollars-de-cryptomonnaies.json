  "summaries": {
    "gauche": [
      "La plateforme Binance a fait l'objet d'un piratage informatique historique évalué à 6,3 milliards de dollars fin octobre.",
      "L'agence fédérale américaine désigne le groupe de pirates TraderTraitor, affilié à Pyongyang, comme responsable de ce vol de cryptomonnaies.",
      "Le président Donald Trump a publiquement exprimé des réserves quant à la mise en cause de la Corée du Nord par les autorités."
    ],
    "centre": [
      "Binance a été victime d'un vol record de 6,3 milliards de dollars en actifs virtuels, entraînant la suspension des retraits.",
      "Le FBI a formellement imputé cette cyberattaque au groupe nord-coréen TraderTraitor, affirmant que les fonds sont en cours de conversion.",
      "La plateforme de cryptomonnaies a entamé une reprise progressive de ses services et de ses retraits pour ses utilisateurs."
    ],
    "droite": [
      "Le FBI qualifie le piratage de Binance de « casse du siècle » après le vol de 6,3 milliards de dollars en cryptomonnaies.",
      "Les enquêteurs américains ciblent directement le groupe de pirates informatiques nord-coréens TraderTraitor pour ce vol d'une ampleur inédite.",
      "La plateforme a annoncé la réouverture des retraits pour stopper l'hémorragie après avoir suspendu ses activités."
    ]
  },
  "differences": [
