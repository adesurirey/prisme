  "summaries": {
    "gauche": [
      "Teddy Riner a qualifié de « baiser empoisonné » les félicitations d'Emmanuel Macron après l'annonce de sa candidature à l'élection présidentielle 2027.",
      "Le candidat a affirmé au salon du Made in France qu'il n'était pas « l'envoyé du président » ni un « macroniste ».",
      "Il a repris la ligne du chef de l'État en rejetant le clivage traditionnel entre la droite et la gauche."
    ],
    "centre": [
      "En déplacement au salon du Made in France, Teddy Riner a déclaré qu'il n'était pas un « macroniste » et a rejeté toute proximité avec l'Élysée.",
      "Il a qualifié de « baiser empoisonné » les messages de félicitations adressés par Emmanuel Macron suite à sa déclaration de candidature.",
      "Le quintuple champion olympique poursuit ainsi sa campagne pour l'élection présidentielle 2027 entamée au début de la semaine."
    ],
    "droite": [
      "Teddy Riner a fermement pris ses distances avec l'exécutif en affirmant qu'il n'était pas « macroniste ».",
      "Le candidat à l'élection présidentielle a qualifié de « baiser empoisonné » les félicitations formulées par Emmanuel Macron.",
      "Lors de sa visite au salon du Made in France à Paris, il a insisté sur le fait qu'il n'était ni « l'envoyé du président » ni « piloté par l'Élysée »."
    ]
  },
  "differences": [
    "La gauche met l'accent sur la reprise par le candidat des logiques politiques d'Emmanuel Macron tout en soulignant sa volonté de rupture.",
