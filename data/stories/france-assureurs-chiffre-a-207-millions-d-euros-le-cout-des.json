  "summaries": {
    "gauche": [
      "France Assureurs chiffre à plus de 200 millions d'euros le coût total des dégradations survenues les 17 et 18 octobre.",
      "La fédération professionnelle qualifie ce montant de particulièrement élevé au vu de la brièveté des violences et des pillages."
    ],
    "centre": [
      "France Assureurs évalue à 207 millions d'euros le coût provisoire des violences urbaines des 17 et 18 octobre.",
      "Ce montant final est nettement inférieur aux précédentes estimations de certains organismes qui avoisinaient 1,2 milliard d'euros.",
      "Le préjudice financier se répartit sur 5 280 sinistres déclarés, concernant presque exclusivement des biens professionnels suite aux manifestations contre la vie chère."
    ],
    "droite": [
      "Le coût des violences urbaines des 17 et 18 octobre s'élève à 207 millions d'euros selon France Assureurs, qui qualifie ce montant de particulièrement élevé.",
      "Plus de 5 000 sinistres ont été déclarés pour des biens professionnels endommagés par des casseurs en marge des manifestations contre la vie chère."
    ]
  },
  "differences": [
    "La gauche met en avant les déclarations de la présidente de la fédération sur l'ampleur des dégâts au regard de la courte durée des faits.",
    "Le centre insiste sur la comparaison avec les précédentes estimations exagérées et détaille le nombre précis de sinistres et le contexte des manifestations contre la vie chère.",
    "La droite qualifie le montant de particulièrement élevé et souligne l'action destructrice des casseurs en marge des cortèges."
  ],
