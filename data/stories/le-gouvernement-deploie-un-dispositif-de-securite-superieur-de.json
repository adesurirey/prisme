  "summaries": {
    "gauche": [
      "Le chef de l'État se rend vendredi auprès des forces de sécurité.",
      "Le ministère de l'Intérieur annonce que les effectifs déployés samedi seront « 20 % supérieurs » à ceux de la semaine précédente.",
      "L'Humanité précise que le total de gendarmes et policiers mobilisés pour le 24 octobre dépasse celui du samedi précédent."
    ],
    "centre": [
      "Le dispositif de sécurité pour les manifestations du 24 octobre est renforcé de « 20 % » par rapport au 17 octobre, selon Jean-Didier Berger.",
      "Des forces de l'ordre ont été rappelées de vacances et des congés ont été supprimés.",
      "Le gouvernement dénonce des actes « politiques et séditieux » menés par des groupes d'ultragauche."
    ],
    "droite": [
      "Le niveau de mobilisation des forces de l'ordre sera « 20 % » supérieur à celui du 17 octobre pour la journée de samedi.",
      "Le dispositif est renforcé par des militaires de la force Sentinelle, des unités d'élite telles que le Raid, le GIGN ou la BRI, ainsi que des hélicoptères et des blindés.",
      "Emmanuel Macron convoque les renseignements à l'Élysée après avoir annoncé l'interdiction de certaines manifestations."
    ]
  },
