  "summaries": {
    "gauche": [
      "La police a découvert le corps d'une femme de 50 ans dans un atelier de La Courneuve samedi soir.",
      "Le parquet de Bobigny indique que la victime était portée disparue depuis plusieurs jours.",
      "L'alerte a été donnée par les enfants de la victime qui n'avaient plus de nouvelles de leur mère depuis mardi."
    ],
    "centre": [
      "Trois personnes ont été interpellées et placées en garde à vue suite à la découverte du corps d'une femme.",
      "La victime a été retrouvée sans vie samedi soir dans une camionnette à La Courneuve, en Seine-Saint-Denis.",
      "La victime a pu être identifiée par les enquêteurs."
    ],
    "droite": [
      "Trois personnes, dont un garagiste, sont en garde à vue après la découverte d'un cadavre dans une camionnette à La Courneuve.",
      "Une femme a prévenu la police samedi vers 22 heures en affirmant que son mari aurait commis un meurtre.",
      "Les premiers éléments suggèrent un différend entre le garagiste et une cliente qui aurait dégénéré."
    ]
  },
  "differences": [
    "La gauche privilégie l'angle de la disparition signalée par les proches et l'âge de la victime.",
    "Le centre se concentre sur les aspects factuels immédiats de l'intervention policière et l'identification de la victime.",
    "La droite insiste sur le signalement initial par l'épouse du suspect et l'hypothèse d'un différend entre le garagiste et une cliente."
  ],
