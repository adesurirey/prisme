  "summaries": {
    "gauche": [
      "La police a découvert le corps d'une femme âgée de 50 ans dans un atelier automobile situé à La Courneuve, dans la soirée de samedi.",
      "Les enfants de la victime avaient signalé sa disparition intervenue depuis mardi.",
      "Le parquet de Bobigny a confirmé que la victime était portée disparue depuis plusieurs jours avant la découverte de sa dépouille.",
      "Trois individus ont été interpellés et placés en garde à vue dans le cadre de cette affaire."
    ],
    "centre": [
      "Le cadavre d'une femme prénommée Mahendradevi, portée disparue depuis le 9 novembre, a été retrouvé chez un garagiste à La Courneuve.",
      "La découverte du corps a été rendue possible grâce à un système de géolocalisation.",
      "Trois personnes ont été arrêtées et placées en garde à vue à la suite de cette découverte survenue un samedi soir."
    ],
    "droite": [
      "Trois personnes ont été interpellées après la découverte du corps sans vie d'une femme dans une camionnette à La Courneuve.",
      "Une femme a prévenu la police samedi vers 22 heures pour signaler que son mari aurait commis un meurtre.",
      "Les agents de la brigade anticriminalité se sont rendus sur les lieux pour inspecter le véhicule stationné dans le garage.",
      "Selon les premiers éléments de l'enquête, le garagiste mis en cause aurait eu un différend avec une cliente avant de la pousser."
    ]
  },
  "differences": [
    "La gauche met l'accent sur l'alerte donnée par les enfants concernant la disparition de leur mère et l'intervention du parquet de Bobigny.",
    "Le centre insiste sur l'utilisation de la géolocalisation pour retrouver la victime et mentionne son identification précise.",
    "La droite détaille l'appel initial passé par la compagne du suspect et évoque un différend entre le garagiste et sa cliente."
  ],
