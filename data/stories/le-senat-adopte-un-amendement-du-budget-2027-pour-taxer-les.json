  "summaries": {
    "gauche": [
      "Le Sénat a validé un amendement budgétaire créant une contribution forfaitaire de cinq euros par jour pour les personnes incarcérées.",
      "Cette mesure vise spécifiquement les prisonniers condamnés définitivement qui exercent une activité professionnelle ou possèdent des ressources suffisantes."
    ],
    "centre": [
      "Les sénateurs ont adopté le 28 novembre un amendement au projet de budget 2027 instaurant une taxe de cinq euros quotidiens pour les détenus.",
      "Le dispositif cible les individus condamnés de manière définitive disposant de revenus ou d'un emploi en prison, avec une adoption facilitée par l'absence d'opposition du gouvernement.",
      "Le maintien de cette contribution forfaitaire dans la version définitive du texte budgétisé reste incertain selon Ouest-France."
    ],
    "droite": [
      "Le Sénat a voté un amendement budgétaire proposé par Les Républicains pour taxer à hauteur de cinq euros par jour les détenus.",
      "Le gouvernement n'a opposé aucun veto à cette mesure lors des discussions parlementaires sur le budget."
    ]
  },
  "differences": [
    "La gauche met l'accent sur la création de la contribution financière et les critères stricts d'application visant les détenus solvables ou actifs.",
    "Le centre détaille le calendrier du vote sénatorial et s'interroge sur l'avenir de la mesure dans le texte final du budget de l'État.",
    "La droite souligne l'origine de l'initiative portée par ses sénateurs et l'absence d'opposition de la part de l'exécutif."
  ],
