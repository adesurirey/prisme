  "summaries": {
    "gauche": [
      "Le Sénat a validé une contribution financière quotidienne de cinq euros à la charge des personnes incarcérées.",
      "Cette mesure s'applique aux détenus effectuant une peine définitive qui possèdent un emploi en prison ou des revenus suffisants.",
      "L'amendement a été initié par plusieurs parlementaires du groupe Les Républicains lors des discussions sur le projet de loi de finances pour 2027.",
      "Le maintien définitif de cette disposition reste suspendu au vote final du budget."
    ],
    "centre": [
      "Les sénateurs ont voté un amendement instaurant une taxe journalière de cinq euros pour les détenus.",
      "Le dispositif cible spécifiquement les prisonniers condamnés disposant de ressources personnelles ou exerçant une activité professionnelle.",
      "Le texte a été introduit dans le cadre de l'examen de la loi de finances 2027."
    ],
    "droite": [
      "La haute assemblée a adopté un amendement budgétaire prévoyant une participation financière des détenus s'élevant à cinq euros par jour.",
      "L'obligation concerne les individus incarcérés de manière définitive qui disposent des capacités financières nécessaires.",
      "Le gouvernement n'a opposé aucun veto à cette disposition portée par les élus Les Républicains."
    ]
  },
  "differences": [
    "La gauche insiste sur les conditions d'application de la mesure en soulignant qu'elle vise les détenus disposant de ressources ainsi que ceux qui travaillent.",
    "Le centre adopte un format strictement factuel et synthétique en se focalisant sur le montant de la taxe et son inscription dans le calendrier budgétaire.",
    "La droite met en avant l'origine politique de l'amendement porté par les sénateurs LR et précise l'absence d'opposition de la part du gouvernement."
  ],
