  "summaries": {
    "gauche": [
      "Un homme de 22 ans a été mis en examen et placé en détention provisoire à la suite de la mort d'un commerçant de 55 ans.",
      "Le drame s'est déroulé à Largentière, en Ardèche, après que la victime a pris en chasse l'auteur d'un vol de téléphone."
    ],
    "centre": [
      "Un suspect de 22 ans a été mis en examen et écroué pour le meurtre d'un artisan de 55 ans à Largentière.",
      "BFMTV précise que la victime s'appelait Christophe B. et a été poignardée à mort en pleine rue après un vol à l'arraché."
    ],
    "droite": [
      "Un homme de 22 ans a été mis en examen et écroué pour le meurtre d'un commerçant de 55 ans en Ardèche.",
      "La procureure d'Avignon a indiqué que la victime a été tuée à l'arme blanche en pourchassant le voleur du téléphone de sa sœur.",
      "Europe 1 précise que les chefs retenus sont homicide volontaire et vol avec violences."
    ]
  },
  "differences": [
    "Les médias de gauche adoptent une formulation sobre centrée sur les faits judiciaires et l'âge du suspect.",
    "Les médias du centre mettent en avant l'identité professionnelle de la victime, le qualifiant notamment d'artisan poignardé en pleine rue.",
    "Les médias de droite insistent sur le déroulement précis des faits en reprenant les communiqués de la procureure d'Avignon et les qualifications juridiques."
  ],
