  "summaries": {
    "gauche": [
      "Un tribunal irakien a condamné six djihadistes français à la réclusion à perpétuité pour leur appartenance au groupe État islamique.",
      "Thomas Barnouin figure parmi les individus lourdement sanctionnés par la justice à Bagdad.",
      "Cette décision s'inscrit dans le prolongement de précédents jugements prononcés en octobre contre des ressortissants français transférés depuis la Syrie."
    ],
    "centre": [
      "Six djihadistes français ont été condamnés à la réclusion à perpétuité par une juridiction en Irak.",
      "Le vétéran Thomas Barnouin fait partie des personnes jugées pour des faits de terrorisme au sein de l'organisation État islamique.",
      "Ces condamnations découlent du transfert de près de cinquante suspects depuis le nord-est de la Syrie l'année précédente."
    ],
    "droite": [
      "La justice irakienne a prononcé des peines de réclusion à perpétuité à l'encontre de six ressortissants français.",
      "Thomas Barnouin, identifié comme un ancien membre influent d'une filière djihadiste notoire, est l'un des condamnés.",
      "Les accusés jugés à Bagdad proviennent des prisons contrôlées dans le nord-est de la Syrie."
    ]
  },
  "differences": [
    "La gauche contextualise le jugement en rappelant les précédentes condamnations prononcées à Bagdad dès le mois d'octobre.",
    "Le centre met l'accent sur l'ensemble du groupe de quarante-sept islamistes radicaux transférés depuis la Syrie l'an dernier.",
    "La droite insiste particulièrement sur le parcours de Thomas Barnouin au sein d'une filière historique du terrorisme français."
  ],
