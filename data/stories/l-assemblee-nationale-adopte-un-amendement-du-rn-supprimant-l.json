  "summaries": {
    "gauche": [
      "L'Assemblée nationale a adopté un amendement du Rassemblement national qui supprime l'interdiction de mise en location des logements classés comme passoires thermiques.",
      "Cette mesure abroge l'interdiction progressive qui avait été instaurée par la loi Climat de 2021 pour lutter contre la précarité énergétique.",
      "Le texte a été voté avec l'appui de la droite, suscitant la vive opposition des acteurs de la rénovation et de la défense des locataires."
    ],
    "centre": [
      "Les députés ont adopté un amendement du Rassemblement national par 108 voix contre 102, avec le soutien des groupes UDR, LR et d'une partie d'Horizons.",
      "La disposition supprime l'interdiction progressive de louer des logements fondée sur le diagnostic de performance énergétique.",
      "Cette décision parlementaire provoque l'inquiétude des acteurs de la rénovation énergétique et des associations de défense des locataires."
    ],
    "droite": [
      "L'Assemblée nationale a validé un amendement du Rassemblement national par 108 voix contre 102 lors de la séance de mardi.",
      "Le texte permet aux propriétaires de louer, dans certains cas, des biens immobiliers jusqu'alors qualifiés de passoires thermiques.",
      "La mesure revient sur les interdictions strictes liées au diagnostic de performance énergétique pour le marché locatif."
    ]
  },
  "differences": [
    "La gauche dénonce une suppression qui réduit à néant les avancées de la loi Climat de 2021 au détriment des locataires.",
    "Le centre détaille les équilibres du scrutin et les inquiétudes des professionnels de la rénovation face au texte adopté.",
    "La droite se focalise sur les aspects techniques du vote et la possibilité nouvelle offerte aux propriétaires de louer."
  ],
