  "summaries": {
    "gauche": [
      "L'Assemblée nationale a adopté un amendement du Rassemblement national soutenu par la droite pour supprimer l'interdiction de louer des passoires énergétiques.",
      "Cette interdiction avait été instaurée par la loi Climat de 2021 pour lutter contre les logements énergivores et protéger les locataires.",
      "Le texte a été voté avec l'appui des députés de droite, provoquant l'opposition des associations de défense des locataires."
    ],
    "centre": [
      "Les députés ont adopté un amendement du Rassemblement national par 108 voix contre 102, avec le soutien des groupes UDR, LR et d'une partie d'Horizons.",
      "Le texte supprime l'interdiction progressive de louer des logements fondée sur le diagnostic de performance énergétique.",
      "Cette décision parlementaire a immédiatement suscité de vives inquiétudes chez les acteurs de la rénovation énergétique."
    ],
    "droite": [
      "L'Assemblée nationale a validé un amendement du Rassemblement national permettant aux propriétaires de louer des logements classés comme passoires thermiques.",
      "Le texte a été adopté de justesse par 108 voix contre 102 lors du vote des députés."
    ]
  },
  "differences": [
    "La gauche dénonce une mesure régressive qui détruit les acquis de la loi Climat de 2021 au détriment des locataires.",
    "Le centre adopte un ton factuel et neutre en détaillant les équilibres du scrutin et les réactions d'inquiétude des professionnels.",
    "La droite présente la mesure sous l'angle technique de l'assouplissement des règles locatives pour les propriétaires."
  ],
