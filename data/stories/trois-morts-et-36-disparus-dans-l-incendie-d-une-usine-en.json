  "summaries": {
    "gauche": [
      "Un incendie s'est déclaré samedi après-midi dans une usine de bonbons située près de Jakarta.",
      "Le drame a fait trois morts et trente-six disparus que les secours recherchent activement."
    ],
    "centre": [
      "Un incendie a frappé une usine située à l'ouest de Jakarta samedi 21 novembre.",
      "Le bilan provisoire fait état de trois personnes décédées et de trente-six autres portées disparues.",
      "Les causes exactes de l'accident demeurent pour l'instant inconnues des autorités."
    ],
    "droite": [
      "Trois personnes sont décédées et trente-six autres sont toujours recherchées après un sinistre dans une usine.",
      "Les investigations sur l'origine du feu se poursuivent tandis que les recherches sont entravées par la persistance de foyers actifs dimanche matin."
    ]
  },
  "differences": [
    "La gauche précise la nature exacte de l'établissement en mentionnant qu'il s'agit d'une usine de bonbons.",
