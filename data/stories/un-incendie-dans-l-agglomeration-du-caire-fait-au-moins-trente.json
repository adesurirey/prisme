  "summaries": {
    "gauche": [
      "Un camion-citerne s'est renversé dans un secteur densément peuplé de l'agglomération du Caire, provoquant un incendie d'une grande violence.",
      "Le sinistre a entraîné la mort d'au moins trente personnes selon les premiers bilans rapportés depuis la capitale égyptienne."
    ],
    "centre": [
      "Un accident impliquant un camion de carburant sur une voie rapide de la périphérie du Caire a déclenché un important incendie.",
      "Le feu a embrasé plusieurs véhicules, dont des transports en commun, faisant au moins 31 morts et plus d'une vingtaine de blessés.",
      "Le ministère égyptien de la Santé est intervenu en déployant des dizaines d'ambulances pour porter secours aux victimes."
    ],
    "droite": [
      "Un camion-citerne chargé de carburant s'est renversé sur une artère fréquentée de Gizeh, dans la zone métropolitaine du Caire.",
      "Le drame a causé la mort d'au moins trente personnes et fait une quinzaine de blessés, d'après les chiffres actualisés du ministère de la Santé.",
      "Des images aériennes et des vidéos authentifiées montrent d'épaisses fumées s'échapper du quartier de Warraq."
    ]
  },
