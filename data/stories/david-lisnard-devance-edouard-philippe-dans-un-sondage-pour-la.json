  "summaries": {
    "gauche": [
      "Le sondage Toluna Harris Interactive publié le lundi 23 novembre montre un recul de Marine Le Pen oscillant entre trois et cinq points.",
      "Le maire de Cannes David Lisnard progresse dans les intentions de vote et dépasse désormais l'ancien Premier ministre Édouard Philippe."
    ],
    "centre": [
      "Le baromètre réalisé pour M6, RTL et L'Express positionne David Lisnard à 11% des intentions de vote dans l'hypothèse où Gabriel Attal ne se présente pas.",
      "Édouard Philippe subit une baisse marquée en passant de 17% au début du mois d'octobre à 10% ou 11% dans cette enquête.",
      "Marine Le Pen enregistre une diminution de ses intentions de vote allant de trois à cinq points selon les instituts."
    ],
    "droite": [
      "David Lisnard atteint la troisième ou quatrième place des intentions de vote avec 11% et se place au même niveau que Raphaël Glucksmann.",
      "L'ancien Premier ministre Édouard Philippe plafonne à 10% des voix tandis que Teddy Riner fait son entrée au même niveau que Bruno Retailleau.",
      "Marine Le Pen réagit vivement en attaquant le projet de David Lisnard de « broyer » le code du travail."
    ]
  },
