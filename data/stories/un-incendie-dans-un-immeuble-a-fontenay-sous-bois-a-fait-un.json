  "summaries": {
    "gauche": [
      "Un violent incendie s'est déclaré jeudi en fin d'après-midi au 11e étage d'une barre d'immeuble du Val-de-Marne à Fontenay-sous-Bois.",
      "Le sinistre a fait un mort et au moins cinq blessés selon Libération, tandis que 20 Minutes fait état de trois pompiers blessés.",
      "Le maire Jean-Philippe Gautrais a exprimé sa vive émotion, salué l'action des secours et rappelé la mobilisation des services municipaux pour le relogement."
    ],
    "centre": [
      "Un important incendie s'est déclaré jeudi 19 novembre vers 17h au 11e étage d'une tour du quartier des Larris à Fontenay-sous-Bois.",
      "Le bilan provisoire fait état d'un mort et d'une trentaine de blessés, incluant plusieurs sapeurs-pompiers.",
      "L'intervention de 130 pompiers a été nécessaire pour maîtriser le feu et évacuer les victimes."
    ],
    "droite": [
      "Un violent incendie s'est déclaré jeudi vers 17h au 11e étage d'une tour de 18 étages dans le quartier des Larris à Fontenay-sous-Bois.",
      "Le drame a causé la mort d'une personne et a fait une trentaine de blessés dont quinze pompiers, selon le maire de la ville.",
      "Trois sapeurs-pompiers ont été évacués en urgence absolue tandis que l'intervention a nécessité la mobilisation de 130 effectifs."
    ]
  },
  "differences": [
    "La gauche privilégie un angle social et municipal en insistant sur la mobilisation des services de la ville pour le relogement et le rôle du maire Jean-Philippe Gautrais.",
    "Le centre adopte un traitement factuel centré sur le bilan humain provisoire et les opérations de secours en cours dans le quartier des Larris.",
    "La droite dramatise l'événement en mettant en avant le nombre élevé de blessés parmi les pompiers évacués en urgence absolue et l'ampleur des dégâts dans la tour."
  ],
