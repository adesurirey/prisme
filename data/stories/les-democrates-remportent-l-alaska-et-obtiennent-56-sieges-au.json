  "summaries": {
    "gauche": [
      "La victoire de Mary Peltola en Alaska parachève la déroute du parti de Donald Trump au Sénat.",
      "Le camp démocrate atteint ainsi sa plus large majorité à la chambre haute depuis l'ère de Barack Obama.",
      "Le scrutin en Alaska s'est conclu après un dépouillement tardif, marquant la fin des midterms."
    ],
    "centre": [
      "Les démocrates ont officiellement remporté le dernier siège en jeu au Sénat en Alaska après un décompte prolongé.",
      "La victoire de Mary Peltola face au sénateur républicain sortant Dan Sullivan a été confirmée mardi.",
      "Cette ultime victoire porte la majorité démocrate à 56 sièges contre 44 pour les républicains."
    ],
    "droite": [
      "La candidate démocrate Mary Peltola s'est imposée en Alaska avec 50,12% des voix face à Dan Sullivan.",
      "Cette victoire finale permet aux démocrates de porter leur majorité à 56 sièges au Sénat contre 44 pour les républicains."
    ]
  },
