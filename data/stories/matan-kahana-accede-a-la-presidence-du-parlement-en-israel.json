  "summaries": {
    "gauche": [
      "Matan Kahana, un allié de Gadi Eisenkot, a remporté la présidence de la Knesset avec 66 voix.",
      "Cette élection a été rendue possible grâce au soutien des partis arabes israéliens.",
      "Gadi Eisenkot a salué ce scrutin comme l'ouverture d'un nouveau chapitre pour le Parlement.",
      "Le camp de Benjamin Netanyahu essuie un revers marquant avec cette défaite."
    ],
    "centre": [
      "Les députés israéliens ont élu Matan Kahana à la tête de la Knesset avec 66 voix sur 120.",
      "Ce scrutin a été obtenu grâce aux voix des partis arabes, constituant un coup dur pour Benjamin Netanyahu.",
      "L'opposition s'empare ainsi de la présidence du Parlement, menaçant l'héritage législatif du Premier ministre sortant.",
      "Matan Kahana est présenté comme un ancien membre des forces spéciales et un proche du centriste Gadi Eisenkot."
    ],
    "droite": [
      "Matan Kahana, fidèle de Gadi Eisenkot et ancien membre des forces spéciales, a été élu président de la Knesset.",
      "Il a recueilli 66 voix sur les 120 que compte le Parlement israélien."
    ]
  },
