  "summaries": {
    "gauche": [
      "L'eurodéputée LFI Rima Hassan comparaît en justice pour avoir partagé sur le réseau social X une citation de Kozo Okamoto, militant de l'Armée rouge japonaise impliqué dans l'attentat de l'aéroport de Tel-Aviv en 1972.",
      "Les partisans de la défense dénoncent une procédure judiciaire destinée à faire taire la élue insoumise et analysent cette mise en cause comme une tentative d'intimidation politique.",
      "La première audience au tribunal de Paris a été marquée par de vifs échanges verbaux, des insultes et des suspensions de séance avant même l'examen du fond du dossier."
    ],
    "centre": [
      "Le procès de l'eurodéputée insoumise Rima Hassan s'est ouvert à Paris pour des accusations d'apologie du terrorisme.",
      "La prévenue a exercé son droit au silence devant les magistrats après avoir qualifié sa comparution de manœuvre politique.",
      "Les débats judiciaires ont immédiatement pris un tour tourmenté, caractérisé par des interruptions d'audience et des tensions."
    ],
    "droite": [
      "L'eurodéputée LFI Rima Hassan a comparu devant le tribunal de Paris sous l'accusation d'apologie du terrorisme pour des publications en ligne.",
      "L'audience initiale a donné lieu à des affrontements verbaux, des accusations d'antisémitisme et de multiples suspensions de séance.",
      "La députée européenne a choisi le silence après avoir affirmé être la personnalité politique la plus poursuivie de la Ve République."
    ]
  },
  "differences": [
    "La gauche insiste sur le contexte d'acharnement politique en qualifiant le procès d'intimidation judiciaire visant à réduire une voix pro-palestinienne au silence.",
    "Le centre adopte une posture factuelle en relatant le déroulement de l'audience et le choix de la prévenue d'exercer son droit au silence.",
    "La droite met en avant l'agitation de la première journée d'audience en insistant sur les invectives, les accusations d'antisémitisme et la tension au tribunal."
