  "summaries": {
    "gauche": [
      "La commission mixte paritaire réunissant sept députés et sept sénateurs le 26 novembre au matin a échoué à trouver un compromis sur le projet de loi de financement de la Sécurité sociale pour 2027.",
      "Les participants ont mis fin rapidement aux discussions, qualifiant les points de vue d'inconciliables afin d'éviter d'aboutir à un texte qui ne serait adopté par aucune des deux chambres.",
      "Le texte est officiellement renvoyé à l'Assemblée nationale pour une nouvelle lecture."
    ],
    "centre": [
      "Sept députés et sept sénateurs réunis en commission mixte paritaire n'ont pas pu s'entendre sur le projet de budget de la Sécurité sociale pour 2027.",
      "Le premier conclave budgétaire de la saison a rapidement tourné court face à des positions irréconciliables entre les parlementaires.",
      "Le texte retourne à l'Assemblée nationale pour la poursuite de son examen."
    ],
    "droite": [
      "La commission mixte paritaire s'est conclue par un constat de désaccord sur le projet de loi de financement de la Sécurité sociale.",
      "Le texte est renvoyé à l'Assemblée nationale en nouvelle lecture après l'échec des discussions entre députés et sénateurs.",
      "Le gouvernement comptait sur ce budget pour réduire le déficit de la Sécurité sociale."
    ]
  },
  "differences": [
    "La gauche insiste sur la volonté rapide des parlementaires d'interrompre des discussions jugées stériles pour empêcher un blocage institutionnel.",
    "Le centre livre un compte-rendu strictement factuel et institutionnel de l'échec de la commission mixte paritaire.",
    "La droite rappelle l'objectif initial fixé par l'exécutif de réduction drastique du déficit de la Sécurité sociale."
  ],
