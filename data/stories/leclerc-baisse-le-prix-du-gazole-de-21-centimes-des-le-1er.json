  "summaries": {
    "gauche": [
      "Le gouvernement a libéré dix millions de barils de gazole issus des réserves stratégiques afin de réduire les tarifs à la pompe.",
      "Des enseignes comme E. Leclerc et Système U pratiquent des rabais allant jusqu'à 21 centimes par litre dans leurs stations-service.",
      "Le ministre du Commerce Serge Papin indique qu'une station sur deux répercute une diminution de 12 à 18 centimes, mais certains syndicats dénoncent des chiffres en demi-teinte et des disparités territoriales."
    ],
    "centre": [
      "Le déblocage de dix millions de barils de gazole des stocks stratégiques entraîne une diminution des tarifs dans plus de la moitié des stations-service françaises.",
      "Les grands distributeurs, notamment TotalEnergies, E. Leclerc et Coopérative U, appliquent des baisses de 12 à 21 centimes par litre à partir du 1er novembre.",
      "Le gouvernement organise une réunion à Bercy avec l'ensemble des distributeurs pour examiner la répercussion de ces mesures temporaires."
    ],
    "droite": [
      "Le chef de l'État Emmanuel Macron salue sur les réseaux sociaux une baisse des prix du gazole sans modification de la fiscalité.",
      "Le ministre du Commerce Serge Papin confirme que plus de la moitié des stations-service abaissent leurs tarifs de 12 à 18 centimes grâce aux réserves stratégiques.",
      "Les groupes E. Leclerc et TotalEnergies répercutent cette diminution de 21 centimes par litre dans leurs réseaux respectifs dès le 1er novembre."
    ]
  },
  "differences": [
    "La gauche met en avant le scepticisme des automobilistes et les disparités d'accès au carburant à prix réduit pour les stations indépendantes.",
    "Le centre dresse un panorama logistique et institutionnel de l'application de la mesure en interrogeant l'ensemble des acteurs de la grande distribution.",
    "La droite valorise l'action gouvernementale et l'efficacité des solutions concrètes mises en place sans augmentation des taxes."
  ],
