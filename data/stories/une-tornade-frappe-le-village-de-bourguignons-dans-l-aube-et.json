  "summaries": {
    "gauche": [
      "Le village de Bourguignons a subi le passage d'une tornade jeudi 19 novembre.",
      "Soixante habitations ont subi des dégradations matérielles et plusieurs axes de circulation ont été entravés.",
      "La préfecture ne recense aucun blessé parmi les deux cent cinquante résidents."
    ],
    "centre": [
      "Une tornade a traversé la commune de Bourguignons dans l'Aube en fin d'après-midi.",
      "Le phénomène climatique a détérioré soixante habitations, provoquant l'arrachage de toitures et l'effondrement de bâtiments.",
      "Aucune victime n'est à déplorer selon les autorités locales."
    ],
    "droite": [
      "Soixante habitations ont été endommagées dans la commune de Bourguignons par une tornade survenue jeudi après-midi.",
      "Les dégâts matériels recensés incluent des toitures arrachées, des tuiles envolées et un pignon effondré.",
      "Deux axes routiers ont été fermés à la circulation et aucun blessé n'est à déplorer d'après la préfecture."
    ]
  },
