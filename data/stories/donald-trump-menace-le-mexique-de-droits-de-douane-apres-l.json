  "summaries": {
    "gauche": [
      "Donald Trump a menacé le Mexique de nouveaux droits de douane pour exiger l'arrêt de migrants en route vers les États-Unis.",
      "Le gouvernement mexicain a fermement démenti l'existence d'une caravane de migrants se dirigeant vers le territoire américain.",
      "L'Obs souligne que cette menace intervient après une défaite électorale du Parti républicain lors des élections de mi-mandat.",
      "Le Monde précise que le groupe de migrants est parti du Honduras et traverse actuellement l'État mexicain du Chiapas."
    ],
    "centre": [
      "Donald Trump a menacé de doubler les droits de douane appliqués aux produits mexicains si le gouvernement de Claudia Sheinbaum ne stoppe pas l'avancée de migrants.",
      "Une caravane de plus de 1 000 migrants centraméricains est arrivée sur le territoire mexicain après avoir franchi la frontière.",
      "Les autorités mexicaines rejettent ces accusations en assurant qu'il n'y a aucune caravane de migrants en direction des États-Unis."
    ],
    "droite": [
      "Donald Trump a qualifié cette situation d'« invasion de notre pays recommence » sur sa plateforme Truth Social.",
      "Une caravane de plus de 1 000 migrants centraméricains est arrivée sur le sol mexicain dans l'intention de rejoindre les États-Unis.",
      "Le président américain exige du Mexique qu'il arrête immédiatement le convoi sous peine de doubler les droits de douane."
    ]
  },
  "differences": [
    "La gauche insiste sur le contexte politique américain de défaite électorale pour Trump et relaie le démenti officiel de Mexico.",
    "Le centre adopte un ton factuel en exposant l'ultimatum douanier de Trump face aux démentis des autorités mexicaines concernant la présence des migrants.",
    "La droite reprend le lexique alarmiste de Donald Trump en qualifiant l'événement d'« invasion » et met l'accent sur la menace directe de sanctions économiques."
  ],
