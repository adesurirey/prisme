  "summaries": {
    "gauche": [
      "Le chef de file des Républicains a fait parvenir un courrier à Édouard Philippe, Gabriel Attal et David Lisnard pour fixer le scrutin les 31 janvier et 7 février.",
      "Seul l'ancien Premier ministre s'oppose à cette initiative visant à contrer le face-à-face entre le Rassemblement national et La France insoumise."
    ],
    "centre": [
      "Bruno Retailleau a invité Édouard Philippe, Gabriel Attal et David Lisnard à participer à un scrutin les 31 janvier et 7 février afin d'agir rapidement face à la polarisation politique.",
      "Le député Jérémie Patrier-Leitrus a expliqué qu'Édouard Philippe ne prendrait pas part à cette démarche en raison de sa candidature déclarée à l'élection présidentielle.",
      "L'ancien Premier ministre demeure le seul des quatre personnalités conviées à rejeter cette proposition formulée par le président des Républicains."
    ],
    "droite": [
      "Le président des Républicains a adressé une lettre à Gabriel Attal, Édouard Philippe et David Lisnard pour leur soumettre l'organisation d'une primaire les 31 janvier et 7 février 2027.",
      "Cette démarche vise à offrir une alternative aux électeurs modérés et à éviter un « choc brutal » entre le Rassemblement national et La France insoumise, aucun candidat n'étant en mesure de l'emporter seul au premier tour.",
      "Le quotidien Le Figaro a révélé cette initiative, confirmée ensuite par l'entourage du candidat de la droite à l'Élysée."
    ]
  },
  "differences": [
    "Les médias du camp gauche adoptent un ton neutre et factuel en se concentrant sur les dates proposées et le refus d'Édouard Philippe.",
    "Les médias du camp centre détaillent les justifications politiques de cette initiative et la stratégie électorale des différents protagonistes.",
    "Les médias du camp droite mettent en valeur la nécessité de structurer une alternative politique pour les électeurs et soulignent le rôle d'exclusivité de leur information."
  ],
