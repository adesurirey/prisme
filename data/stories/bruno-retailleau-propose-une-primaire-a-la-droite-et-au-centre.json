  "summaries": {
    "gauche": [
      "Bruno Retailleau a proposé formellement par courrier à Édouard Philippe, Gabriel Attal et David Lisnard d'organiser une primaire de la droite et du centre.",
      "Le scrutin se déroulerait les dimanches 31 janvier et 7 février en vue de l'élection présidentielle de 2027.",
      "Le camp d'Édouard Philippe a opposé une fin de non-recevoir à cette initiative, refusant le principe d'une primaire tout en plaidant pour un rassemblement autour d'un unique candidat."
    ],
    "centre": [
      "Le président des Républicains, Bruno Retailleau, a adressé un courrier à Édouard Philippe, Gabriel Attal et David Lisnard pour proposer la tenue d'une primaire de la droite et du centre.",
      "L'élection est fixée aux 31 janvier et 7 février afin de devancer le calendrier de 2027.",
      "Parmi les personnalités conviées, seul Édouard Philippe s'oppose à cette organisation, justifiant qu'il est déjà candidat à l'élection présidentielle selon ses soutiens."
    ],
    "droite": [
      "Bruno Retailleau a écrit à Gabriel Attal, Édouard Philippe et David Lisnard pour leur soumettre l'organisation d'une primaire de la droite et du centre les 31 janvier et 7 février 2027.",
      "L'ancien ministre de l'Intérieur motive cette proposition par l'urgence d'éviter un « choc brutal » entre le Rassemblement national et la France insoumise, estimant qu'aucun candidat ne peut s'imposer seul.",
      "Le Figaro précise que cette démarche vise à offrir une alternative aux électeurs « déboussolés » face à l'emprise croissante de Jean-Luc Mélenchon."
    ]
  },
  "differences": [
    "La gauche met l'accent sur le refus immédiat opposé par le camp d'Édouard Philippe à la proposition de Bruno Retailleau.",
    "Le centre détaille l'argumentaire des différents protagonistes et s'attarde sur les justifications du refus d'Édouard Philippe.",
    "La droite insiste sur le diagnostic alarmiste de Bruno Retailleau face au duel annoncé entre le Rassemblement national et La France insoumise."
  ],
