  "summaries": {
    "gauche": [
      "Bruno Retailleau a transmis un courrier à Édouard Philippe, Gabriel Attal et David Lisnard pour fixer les dates d'une primaire.",
      "Le calendrier proposé pour ce scrutin de la droite et du centre est arrêté aux 31 janvier et 7 février."
    ],
    "centre": [
      "Bruno Retailleau a adressé une lettre à Édouard Philippe, Gabriel Attal et David Lisnard afin de leur soumettre l'organisation d'une primaire.",
      "Le scrutin est planifié aux 31 janvier et 7 février pour contrer un duel entre le Rassemblement national et la France insoumise.",
      "TF1 Info précise que seul Édouard Philippe s'oppose à cette initiative parmi les quatre personnalités sollicitées."
    ],
    "droite": [
      "Bruno Retailleau a écrit mardi à Gabriel Attal, Édouard Philippe et David Lisnard pour proposer une primaire de la droite et du centre.",
      "Le candidat LR à l'Élysée fixe le scrutin aux 31 janvier et 7 février 2027 pour bâtir une alternative face au duel annoncé entre LFI et le RN.",
      "TF1 Info ajoute que le maire du Havre, pourtant favori dans les sondages, refuse cette proposition."
    ]
  },
  "differences": [
    "La gauche relaie factuellement l'initiative de Bruno Retailleau sans développer d'angle programmatique particulier.",
    "Le centre insiste sur l'urgence politique de la démarche pour contrer le face-à-face entre le RN et LFI.",
    "La droite met en avant le profil de Bruno Retailleau comme candidat LR à l'Élysée structurant une alternative."
  ],
