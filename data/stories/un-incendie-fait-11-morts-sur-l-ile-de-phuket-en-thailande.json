  "summaries": {
    "gauche": [
      "Un incendie s'est déclaré en pleine nuit un lundi dans une maison de quatre étages abritant des commerces sur l'île de Phuket en Thaïlande.",
      "Le drame a fait 11 morts et 16 blessés selon un bilan provisoire.",
      "Les causes exactes de l'incendie ne sont pas encore connues."
    ],
    "centre": [
      "Un incendie s'est déclaré tôt lundi matin dans un immeuble de quatre étages à usages multiples sur l'île touristique de Phuket.",
      "Le bilan fait état de 11 morts et de 16 blessés parmi les occupants.",
      "Des citoyens thaïlandais et des ressortissants birmans figurent parmi les victimes recensées."
    ],
    "droite": [
      "Un violent incendie a frappé une habitation de quatre étages comportant des commerces et un restaurant dans la zone de Patong à Phuket.",
      "L'intervention de la police locale a permis d'établir un bilan provisoire de 11 personnes tuées et 16 blessées.",
      "Le sinistre s'est déclaré durant la nuit de dimanche à lundi dans un secteur très fréquenté par les touristes français."
    ]
  },
