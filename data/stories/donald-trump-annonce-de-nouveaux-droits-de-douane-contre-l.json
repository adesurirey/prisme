  "summaries": {
    "gauche": [
      "Donald Trump réinstaure de nouveaux droits de douane visant quatorze pays, dont la Chine et l'Union européenne.",
      "Cette décision survient après la défaite électorale des midterms et malgré le précédent désaveu de la Cour suprême.",
      "L'Union européenne conteste fermement cette mesure qui menace de relancer une guerre commerciale."
    ],
    "centre": [
      "Le gouvernement américain a proposé une nouvelle série de taxes sur les importations de quatorze partenaires commerciaux majeurs.",
      "Les surtaxes visent à pénaliser des pays accusés d'accorder des subventions illicites à leurs industries ou de souffrir d'une production excessive.",
      "Bruxelles conteste fermement le bien-fondé de ces mesures douanières."
    ],
    "droite": [
      "Donald Trump durcit le ton dans la guerre commerciale en dévoilant de nouveaux droits de douane allant jusqu'à 20 %.",
      "L'Union européenne, la Chine et le Mexique figurent parmi les principaux partenaires ciblés par cette offensive.",
      "Cette politique douanière s'ajoute aux taxes de 10 % déjà annoncées fin juillet et conclut une enquête menée contre les subventions et le travail forcé."
    ]
  },
  "differences": [
    "La gauche insiste sur le contexte politique national en qualifiant la mesure de revanche après l'échec électoral des midterms.",
    "Le centre adopte un ton neutre en détaillant les motifs invoqués par Washington et la contestation immédiate formulée par Bruxelles.",
    "La droite met en avant la fermeté de l'offensive américaine et l'ampleur chiffrée des surtaxes douanières imposées aux partenaires commerciaux."
  ],
